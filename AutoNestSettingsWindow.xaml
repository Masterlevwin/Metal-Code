<Window x:Class="Metal_Code.AutoNestSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Параметры автонестинга"
        WindowStartupLocation="CenterOwner"
        Width="360"
        SizeToContent="Height"
        MinHeight="360"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- 1: панель параметров -->
            <RowDefinition Height="Auto"/>
            <!-- 2: сравнение (скрыто) -->
            <RowDefinition Height="Auto"/>
            <!-- 3: кнопки -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройте параметры раскладки:"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- Панель ЛИСТОВОГО металла -->
        <StackPanel Grid.Row="1" x:Name="SheetPanel" Visibility="Collapsed">
            <ToggleButton x:Name="AutoNestingCheck"
                          Content="Автоподбор размеров листа"
                          FontWeight="Bold"
                          Style="{StaticResource ToggleButtonSwitch.Small}"
                          IsChecked="True" Margin="0,0,0,15"
                          HorizontalAlignment="Center"/>
            <TextBlock Text="Ширина листа (мм):" Margin="0,0,0,5"/>
            <hc:TextBox x:Name="TxtWidth" Margin="0,0,0,10" TextAlignment="Center"/>
            <TextBlock Text="Высота листа (мм):" Margin="0,0,0,5"/>
            <hc:TextBox x:Name="TxtHeight" Margin="0,0,0,10" TextAlignment="Center"/>
            <TextBlock Text="Отступы (мм):" Margin="0,0,0,5"/>
            <hc:TextBox x:Name="TxtSpacing" Margin="0,0,0,10" TextAlignment="Center"/>
        </StackPanel>

        <!-- Панель ТРУБ -->
        <StackPanel Grid.Row="1" x:Name="PipePanel" Visibility="Collapsed">
            <TextBlock Text="Длина хлыста (мм):" Margin="0,0,0,5"/>
            <hc:TextBox x:Name="TxtLength" Margin="0,0,0,15" TextAlignment="Center"/>
            <TextBlock Text="Зона зажима (мм):" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <RadioButton x:Name="Clamp340Radio" Content="340" GroupName="ClampZone" Margin="0,0,15,0"/>
                <RadioButton x:Name="Clamp160Radio" Content="160" GroupName="ClampZone" Margin="0,0,15,0"/>
                <RadioButton x:Name="Clamp0Radio" Content="0 (нет)" GroupName="ClampZone"/>
            </StackPanel>
            <TextBlock Text="Пропил (мм):" Margin="0,0,0,5"/>
            <hc:TextBox x:Name="TxtLoss" Margin="0,0,0,10" TextAlignment="Center"/>
        </StackPanel>

        <!-- Панель сравнения (появляется после «Проверки») -->
        <Border Grid.Row="2" x:Name="PreviewResultPanel" Visibility="Collapsed"
                Background="#F0F8FF" BorderBrush="#B0C4DE" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,5,0,10">
            <StackPanel>
                <TextBlock Text="Сравнение вариантов:" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock x:Name="CurrentResultText" Margin="0,0,0,4" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="PreviewResultText" Margin="0,0,0,8" TextWrapping="Wrap"/>

                <StackPanel x:Name="ApplyChoicePanel">
                    <TextBlock Text="Какой вариант применить?" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="KeepCurrentRadio" Content="Текущий (из отчёта)"
                                     GroupName="ApplyChoice" Margin="0,0,15,0"/>
                        <RadioButton x:Name="UsePreviewRadio" Content="Автонестинг"
                                     GroupName="ApplyChoice"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnPreview" Content="Проверка" Width="90" Margin="0,0,10,0"
                    Style="{StaticResource ButtonDashedPrimary}" Click="Preview_Click"/>
            <Button Content="Отмена" Width="90" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Применить" Width="90"
                    Style="{StaticResource ButtonPrimary}" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>