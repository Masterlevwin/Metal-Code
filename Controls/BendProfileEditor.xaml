<UserControl x:Class="Metal_Code.Controls.BendProfileEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="18"/>
            </Grid.RowDefinitions>

            <!-- ═══ Верхняя панель: заголовок + поле размера + очистка ═══ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок профиля -->
                <TextBlock Grid.Column="0"
               Text="{Binding ProfileTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="SemiBold" FontSize="12" Foreground="DarkBlue"
               VerticalAlignment="Center" Margin="0,0,8,0"
               TextTrimming="CharacterEllipsis"/>

                <!-- Поле ввода размера сегмента (появляется при выборе сегмента) -->
                <TextBox x:Name="SegmentSizeInput" Grid.Column="1" Margin="4,0"
             FontSize="11" VerticalContentAlignment="Center"
             Visibility="Collapsed"
             TextChanged="SegmentSizeInput_TextChanged"/>

                <!-- Кнопка очистки (в самом конце) -->
                <Button Grid.Column="2" Content="✕" ToolTip="Очистить и рисовать заново"
            Click="Clear_Click" Width="22" Height="22" Padding="0"
            Style="{StaticResource ButtonDashedDanger}" FontWeight="Bold"/>
            </Grid>
            
            <!-- ═══ Канвас для рисования ═══ -->
            <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3"
                    Background="#FAFAFA" ClipToBounds="True" Margin="0,4,0,2">
                <Canvas x:Name="ProfileCanvas" Background="Transparent"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseRightButtonDown="Canvas_MouseRightButtonDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeave="Canvas_MouseLeave"/>
            </Border>

            <!-- ═══ Инфо-строка ═══ -->
            <TextBlock x:Name="InfoText" Grid.Row="2"
                       Text="ЛКМ — точка | ПКМ — завершить"
                       FontSize="10" Foreground="Gray" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>