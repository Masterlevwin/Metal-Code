<Window x:Class="Metal_Code.AssemblyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:self="clr-namespace:Metal_Code"
        mc:Ignorable="d"
        Title="Управление сборками" Closing="HideWindow" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}">
    <Window.Resources>
        <self:CostConverter x:Key="CostConverter"/>
        
        <!-- Цвета -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFFE1"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D1D9E0"/>
        <SolidColorBrush x:Key="FocusBorderColor" Color="#4A90E2"/>

        <!-- Общая толщина границы -->
        <Thickness x:Key="DefaultBorderThickness">1</Thickness>

        <!-- Стиль для Button -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FocusBorderColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <!-- Кнопки и список деталей -->
            <ColumnDefinition/>
            <!-- TreeView со сборками -->
        </Grid.ColumnDefinitions>

        <StackPanel Margin="5">
            <Expander Margin="10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/question.png" MouseEnter="ShowPopup" Width="16"/>
                        <TextBlock Text="Список деталей" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Expander.Header>

                <ListView ItemsSource="{Binding CurrentParts}" Padding="3" MaxHeight="200"
                          Style="{StaticResource ListView.Small}"
                          AllowDrop="False" MouseMove="ListView_MouseMove"
                          PreviewMouseLeftButtonDown="ListView_PreviewMouseLeftButtonDown">
                <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Loaded="SetPicture" Width="20"/>
                                <TextBlock Text="{Binding Title}" Margin="5,0,0,0"/>
                                <TextBlock Text=" (" Foreground="Blue" Margin="5,0,0,0" />
                                <TextBlock Text="{Binding Count}" Foreground="Blue"/>
                                <TextBlock Text=" шт)" Foreground="Blue"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView >
            </Expander>

            <Expander Margin="10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/question.png" MouseEnter="ShowPopupBaskets" Width="16"/>
                        <TextBlock Text="Покупные изделия" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Expander.Header>

                <ListView ItemsSource="{Binding CurrentBaskets}" Padding="3" MaxHeight="160"
                          Style="{StaticResource ListView.Small}"
                          AllowDrop="False" MouseMove="ListView_MouseMove"
                          PreviewMouseLeftButtonDown="ListView_PreviewMouseLeftButtonDown">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Loaded="SetPicture" Width="20"/>
                                <TextBlock Text="{Binding Title}" Margin="5,0,0,0"/>
                                <TextBlock Text=" (" Foreground="Blue" Margin="5,0,0,0" />
                                <TextBlock Text="{Binding Count}" Foreground="Blue"/>
                                <TextBlock Text=" шт)" Foreground="Blue"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView >
            </Expander>

            <Popup x:Name="Popup" Placement="Mouse" AllowsTransparency="True" PopupAnimation="Scroll" StaysOpen="False">
                <Border BorderThickness="1" CornerRadius="1" BorderBrush="Red">
                    <StackPanel Background="Snow">
                        <TextBlock x:Name="Details" TextAlignment="Center" Padding="5"/>
                    </StackPanel>
                </Border>
            </Popup>

            <StackPanel Grid.Column="1" Margin="10" HorizontalAlignment="Center">
                <!-- Глобальная сварка -->
                <StackPanel Orientation="Horizontal" Margin="3">
                    <Image Source="/Images/works2.png" Width="16"/>
                    <TextBlock Text="Сварка (общ.):" VerticalAlignment="Center" Margin="10,0,0,0" Width="90"/>
                    <TextBox x:Name="GlobalWeldBox" Width="60" Margin="5,0,0,0"
                 ToolTip="Общая длина сварного шва для всех сборок" HorizontalContentAlignment="Center"/>
                    <ComboBox x:Name="GlobalWeldTypeBox" SelectedIndex="0" Width="60" Margin="5,0,0,0"
                  ItemsSource="{Binding DataContext.Types, RelativeSource={RelativeSource AncestorType=Window}}"
                  ToolTip="Тип сварки по умолчанию"/>
                </StackPanel>

                <!-- Глобальная окраска -->
                <StackPanel Orientation="Horizontal" Margin="3">
                    <Image Source="/Images/works2.png" Width="16"/>
                    <TextBlock Text="Окраска (общ.):" VerticalAlignment="Center" Margin="10,0,0,0" Width="90"/>
                    <TextBox x:Name="GlobalRalBox" Width="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                 ToolTip="Цвет RAL по умолчанию" Margin="5,0,0,0"/>
                    <ComboBox x:Name="GlobalStructureBox" SelectedIndex="0" Width="70" Margin="5,0,0,0"
                  ItemsSource="{Binding DataContext.Structures, RelativeSource={RelativeSource AncestorType=Window}}"
                  ToolTip="Структура покрытия по умолчанию"/>

                    <Button Content="→ Применить" Click="ApplyGlobalToAllAssemblies"
                        ToolTip="Применить значения ко всем сборкам" Margin="20,0,0,0"/>

                </StackPanel>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Click="AddAssembly">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/greenplus.png"/>
                        <TextBlock Text="Создать сборку" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Click="CheckAssemblies" Margin="50,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/check.png"/>
                        <TextBlock Text="Проверить сборки" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <TreeView x:Name="ParticleStack" Grid.Column="1" Margin="10" ItemsSource="{Binding Assemblies}"
                  BorderThickness="0" AllowDrop="True" DragOver="TreeView_DragOver" Drop="TreeView_Drop">
            <TreeView.Resources>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="AllowDrop" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <StackPanel Background="{TemplateBinding Background}">
                                    
                                    <!-- Заголовок с раскрывающейся стрелкой -->
                                    <Grid x:Name="HeaderGrid" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ToggleButton x:Name="Expander" ClickMode="Press"
              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
              Width="24" Height="24" Cursor="Hand"
              HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Grid Background="Transparent">
                                                        
                                                        <!-- Стрелка-шеврон -->
                                                        <Path x:Name="Arrow" Fill="#555555" Data="M 3 1 L 9 7 L 3 13 Z"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <!-- Раскрытие -->
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="90"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <!-- Наведение -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Arrow" Property="Fill" Value="#1A73E8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        
                                        <!-- Содержимое заголовка (ваш шаблон) -->
                                        <ContentPresenter x:Name="PART_Header"
                                              Grid.Column="1"
                                              ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="4,0,0,0"/>
                                    </Grid>

                                    <!-- Контейнер для дочерних элементов -->
                                    <Border x:Name="ItemsHostBorder"
                                Visibility="Collapsed"
                                BorderThickness="1"
                                BorderBrush="#FFCCCCCC"
                                CornerRadius="3"
                                Margin="30,5,10,10"
                                            Padding="5"
                                Background="#08000000">
                                        <ItemsPresenter x:Name="ItemsHost"/>
                                    </Border>
                                </StackPanel>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="ItemsHostBorder" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                        <Setter TargetName="ItemsHostBorder" Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <HierarchicalDataTemplate DataType="{x:Type self:Assembly}" ItemsSource="{Binding Particles}">
                    <Border BorderBrush="Gray" CornerRadius="6" BorderThickness="1">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="3">
                                <Button Click="AddCurrentParts">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Images/assembly.png"/>
                                        <TextBlock Text="Добавить в эту сборку" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBox Text="{Binding Title}" ToolTip="Введите наименование сборки" Margin="15,0,0,0" Width="160" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold"/>
                                <TextBox Text="{Binding Count}" Margin="15,0,0,0" Width="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip="Введите количество сборок" LostFocus="SetAssemblyCount" FontWeight="Bold"/>
                                <Button Content="Х" Click="Remove" Margin="15,0,0,0" ToolTip="Удалить сборку"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="3">
                                <Image Source="/Images/works2.png" Width="16"/>
                                <TextBlock Text="Свар" FontWeight="Bold" Margin="10,0,0,0" Width="36" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Weld}" ToolTip="Введите длину свариваемой поверхности, мм" MaxLines="1" Width="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                <ComboBox SelectedItem="{Binding Type}" ItemsSource="{Binding DataContext.Types, RelativeSource={RelativeSource AncestorType=Window}}" Margin="5,0,0,0" Width="60" ToolTip="Выберите тип расчета"/>
                                <TextBlock Text="{Binding Mass}" VerticalAlignment="Center" Margin="5,0,0,0" Width="30" ToolTip="Вес 1-ой сборки"/>
                                <TextBlock Text="кг" VerticalAlignment="Center" Margin="5,0,0,0" Width="25" ToolTip="Вес 1-ой сборки"/>
                                <TextBlock Text="{Binding WeldPrice, Converter={StaticResource CostConverter}}" Margin="10,0,0,0" Foreground="Blue" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="3">
                                <Image Source="/Images/works2.png" Width="16"/>
                                <TextBlock Text="Окр" FontWeight="Bold" Margin="10,0,0,0" Width="36" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Ral}" ToolTip="Введите цвет RAL" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="50" MaxLines="1"/>
                                <ComboBox SelectedItem="{Binding Structure}" ItemsSource="{Binding DataContext.Structures, RelativeSource={RelativeSource AncestorType=Window}}" Margin="5,0,0,0" Width="70" ToolTip="Выберите структуру покрытия"/>
                                <TextBlock Text="{Binding Square}" VerticalAlignment="Center" Margin="5,0,0,0" Width="30" ToolTip="Площаль покрытия 1-ой сборки"/>
                                <TextBlock Text="кв м" VerticalAlignment="Center" Margin="5,0,0,0" Width="25" ToolTip="Площаль покрытия 1-ой сборки"/>
                                <TextBlock Text="{Binding PaintPrice, Converter={StaticResource CostConverter}}" Margin="10,0,0,0" Foreground="Blue" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </HierarchicalDataTemplate>
                
                <DataTemplate DataType="{x:Type self:Particle}">
                    <!-- Оборачиваем все в Border, чтобы иметь возможность менять его свойства -->
                    <Border x:Name="ParticleBorder" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Margin="3">
                            <Image Loaded="SetPicture" Width="20"/>
                            <TextBlock Text="{Binding Title}" Width="300" Margin="5,0,0,0" VerticalAlignment="Center" Tag="ParticleTitle"/>
                            <TextBox Text="{Binding Count}" Foreground="Blue" Width="40" Margin="5,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button x:Name="BtnRemove" Content="Х" Click="Remove"
                                    ToolTip="Убрать деталь из сборки" Margin="20,0,0,0"/>
                        </StackPanel>

                        <!-- Стиль для изменения вида Border при наведении на кнопку -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <!-- Триггер: когда мышь над кнопкой BtnRemove -->
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=BtnRemove}" Value="True">
                                        <Setter Property="Background" Value="#FFFFE0E0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </DataTemplate>

            </TreeView.Resources>
        </TreeView>

    </Grid>
</Window>
