<Window x:Class="Metal_Code.ReportPeriodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Выбор периода отчета"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource RegionBrush}" SizeToContent="WidthAndHeight">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ⭐ Заголовок — будет меняться в коде -->
        <TextBlock Grid.Row="0" x:Name="TitleText" 
                   Text="Выберите период для отчета по продажам:" 
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

        <!-- ⭐ Блок выбора периода — скрывается для отчёта по производству -->
        <StackPanel Grid.Row="1" x:Name="PeriodPanel" Margin="0,0,0,10">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="С:" VerticalAlignment="Center"/>
                <hc:DatePicker Grid.Row="0" Grid.Column="1" x:Name="DateFrom" 
                               SelectedDateFormat="Short"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="По:" VerticalAlignment="Center"/>
                <hc:DatePicker Grid.Row="1" Grid.Column="1" x:Name="DateTo" 
                               SelectedDateFormat="Short"/>
            </Grid>

            <!-- Быстрые кнопки -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <Button Content="Этот месяц" Click="SetCurrentMonth_Click" 
                        Style="{StaticResource ButtonDefault}" Padding="10,4" Margin="0,0,5,0"/>
                <Button Content="Прошлый месяц" Click="SetLastMonth_Click" 
                        Style="{StaticResource ButtonDefault}" Padding="10,4" Margin="0,0,5,0"/>
                <Button Content="Квартал" Click="SetQuarter_Click" 
                        Style="{StaticResource ButtonDefault}" Padding="10,4"/>
            </StackPanel>
        </StackPanel>

        <!-- Информация о режиме -->
        <TextBlock Grid.Row="3" x:Name="ModeInfoText" 
                   TextWrapping="Wrap" FontSize="11" 
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="0,5,0,10"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Click="Cancel_Click" 
                    Style="{StaticResource ButtonDefault}" Width="80" Margin="0,0,10,0"/>
            <Button Content="Сформировать" Click="Ok_Click" 
                    Style="{StaticResource ButtonPrimary}" Width="120"/>
        </StackPanel>
    </Grid>
</Window>