<Window x:Class="Metal_Code.EngravingWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:Metal_Code"
        Title="Гравировка" WindowStartupLocation="CenterScreen" Width="300" Height="300">
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Текст -->
        <hc:TextBox hc:InfoElement.Placeholder="Введите текст гравировки"
                        Text="{Binding TextMarking, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"
                        TextWrapping="Wrap" AcceptsReturn="True" Grid.Row="0" Margin="5" MaxLines="4"/>

        <!-- Шрифт -->
        <DockPanel Margin="5" Grid.Row="1" LastChildFill="True">
            <hc:NumericUpDown DockPanel.Dock="Right" Minimum="10" Maximum="30" Increment="2"
                              Value="{Binding FontSizeOverride, TargetNullValue=10}"
                              ToolTip="Введите размер шрифта" Width="80" VerticalAlignment="Center"/>

            <hc:ComboBox x:Name="FontBox" ItemsSource="{Binding FontList}"
                         hc:InfoElement.Placeholder="Выбор шрифта"
                         SelectedItem="{Binding SelectedFont}"
                         Margin="0,5,10,5" Grid.Row="1"/>
        </DockPanel>

        <!-- Предпросмотр -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="5">
            <ScrollViewer Grid.Row="2" MaxHeight="300"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="PreviewCanvas" Background="White" MinWidth="120" MinHeight="60"/>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="Отмена" Click="CancelButton_Click"/>
            <Button Content="Применить" Click="ApplyButton_Click" Margin="10,0,0,0"/>
        </StackPanel>
        
    </Grid>
</Window>