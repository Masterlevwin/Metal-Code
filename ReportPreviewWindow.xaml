<Window x:Class="Metal_Code.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:Metal_Code"
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        Title="Отчет по продажам" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <!-- ⭐ Конвертеры регистрируем в ресурсах окна -->
        <converters:GroupSumConverter x:Key="GroupSumConverter"/>
        <converters:BoolToTaxConverter x:Key="BoolToTaxConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔹 ПАНЕЛЬ ИНФОРМАЦИИ О ПЕРИОДЕ -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}" 
                CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📅 Период:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding PeriodText}" VerticalAlignment="Center" FontSize="13"/>
                    <TextBlock Text="{Binding ModeText}" VerticalAlignment="Center" 
                               Margin="20,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                </StackPanel>

                <Button Grid.Column="1" Content="💾 Экспорт в Excel" 
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource ButtonSuccess}" Padding="12,6" Margin="0,0,5,0"/>

                <Button Grid.Column="2" Content="✖ Закрыть" 
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource ButtonDefault}" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- 🔹 ТАБЛИЦА ДАННЫХ -->
        <DataGrid Grid.Row="1" x:Name="ReportGrid" 
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander>
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} расчётов)'}" 
                                                               Margin="10,0,0,0" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding Converter={StaticResource GroupSumConverter}}" 
                                                               Margin="20,0,0,0" FontWeight="Bold" Foreground="Green"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="100"/>
                <DataGridTextColumn Header="Компания" Binding="{Binding Company}" Width="200"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Нал" Binding="{Binding IsCash, Converter={StaticResource BoolToTaxConverter}}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}" Width="100"/>
                <DataGridTextColumn Header="Заказ" Binding="{Binding Order}" Width="100"/>
                <DataGridTextColumn x:Name="DateColumn" Binding="{Binding DisplayDate, StringFormat=dd.MM.yyyy}" Width="90"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="120"/>
                <DataGridTextColumn Header="Материал" Binding="{Binding MaterialAmount, StringFormat={}{0:N2} ₽}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Лазер" Binding="{Binding LaserCost, StringFormat={}{0:N2} ₽}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Гибка" Binding="{Binding BendingCost, StringFormat={}{0:N2} ₽}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Труборез" Binding="{Binding PipeCost, StringFormat={}{0:N2} ₽}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Производство" Binding="{Binding ProductionCost, StringFormat={}{0:N2} ₽}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Всего работ" Binding="{Binding TotalWorks, StringFormat={}{0:N2} ₽}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✖" ToolTip="Удалить из отчета"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Foreground="Red"
                                    Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 🔹 ИТОГОВАЯ ПАНЕЛЬ -->
        <Border Grid.Row="2" Background="{DynamicResource SecondaryRegionBrush}" 
                CornerRadius="4" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Всего расчётов:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Items.Count, StringFormat=' {0}'}" Margin="5,0,20,0" VerticalAlignment="Center"/>

                <TextBlock Text="Материал:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalMaterial, StringFormat={}{0:N2} ₽}" Margin="5,0,15,0" VerticalAlignment="Center"/>

                <TextBlock Text="Работы:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalWorks, StringFormat={}{0:N2} ₽}" Margin="5,0,0,0" 
                           FontWeight="Bold" Foreground="Green" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>