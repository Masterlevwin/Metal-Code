<Window x:Class="Metal_Code.ReportPreviewWindow"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Metal_Code"
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        Title="Предпросмотр отчета" 
        Width="1100" Height="600"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <local:CostConverter x:Key="CostConverter"/>
        <converters:GroupSummaryConverter x:Key="GroupSummaryConverter"/>

        <!-- 🔹 Стиль для заголовков колонок: центрирование + жирный шрифт + фон -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource RegionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <!-- Чтобы заголовок не исчезал при прокрутке -->
            <Setter Property="IsTabStop" Value="False"/>
        </Style>

        <!-- 🔹 Опционально: стиль для ячеек с суммами (правое выравнивание) -->
        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Padding" Value="0,0,5,0"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Итоги -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- 🔹 Таблица -->
        <DataGrid x:Name="PreviewGrid"
          ItemsSource="{Binding Items}"
          Style="{StaticResource DataGrid.Small}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserReorderColumns="False"
          CanUserResizeRows="False"
          EnableColumnVirtualization="True"
          EnableRowVirtualization="True"
          IsReadOnly="True"
          FrozenColumnCount="3"
          HeadersVisibility="All"
          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
          VerticalGridLinesBrush="{DynamicResource BorderBrush}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="80"/>
                <DataGridTextColumn Header="Компания" Binding="{Binding Company}" Width="150"/>
                <DataGridCheckBoxColumn Header="Нал" Binding="{Binding IsCash}" Width="50"/>
                <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}" Width="60"/>
                <DataGridTextColumn Header="Заказ" Binding="{Binding Order}" Width="60"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="80"/>
                
                <!-- 🔹 Стоимости -->
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, Converter={StaticResource CostConverter}}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Материал" Binding="{Binding MaterialAmount, Converter={StaticResource CostConverter}}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Лазер" Binding="{Binding LaserCost, Converter={StaticResource CostConverter}}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Гибка" Binding="{Binding BendingCost, Converter={StaticResource CostConverter}}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Труборез" Binding="{Binding PipeCost, Converter={StaticResource CostConverter}}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Производство" Binding="{Binding ProductionCost, Converter={StaticResource CostConverter}}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="RightAlignedCell"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>

            <!-- ✅ 3. Группировка с рабочим Expander (аналог GroupStyleSelector) -->
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <Expander IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Margin="0,2,0,4"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Border Background="{DynamicResource RegionBrush}" 
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Padding="8,6"
                                                Margin="0,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="👤" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Text=" → " VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource GroupSummaryConverter}">
                                                                    <Binding Path="Items"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </Expander.Header>
                                            <!-- Сами строки группы -->
                                            <ItemsPresenter Margin="15,5,0,0"/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>

        <!-- 🔹 ✅ НОВАЯ ПАНЕЛЬ ИТОГОВ -->
        <Border Grid.Row="1" Margin="0,8,0,8"
            Background="{DynamicResource PrimaryBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- Заголовок -->
                <TextBlock Text="📈 ИТОГО ПО ПРОИЗВОДСТВУ:" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextIconBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>

                <!-- Лазерная резка -->
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Лазер:" Foreground="{DynamicResource TextIconBrush}" Opacity="0.9" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalLaser, Converter={StaticResource CostConverter}}" 
                           Foreground="{DynamicResource TextIconBrush}" FontWeight="Bold" FontSize="14"
                           VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Гибка -->
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Гибка:" Foreground="{DynamicResource TextIconBrush}" Opacity="0.9" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalBending, Converter={StaticResource CostConverter}}" 
                           Foreground="{DynamicResource TextIconBrush}" FontWeight="Bold" FontSize="14"
                           VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Труборез -->
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Труборез:" Foreground="{DynamicResource TextIconBrush}" Opacity="0.9" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPipe, Converter={StaticResource CostConverter}}" 
                           Foreground="{DynamicResource TextIconBrush}" FontWeight="Bold" FontSize="14"
                           VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Производство (Сварка+Окраска) -->
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Производство:" Foreground="{DynamicResource TextIconBrush}" Opacity="0.9" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalProduction, Converter={StaticResource CostConverter}}" 
                           Foreground="{DynamicResource TextIconBrush}" FontWeight="Bold" FontSize="14"
                           VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Разделитель -->
                <Rectangle Width="1" Height="24" Fill="White" Opacity="0.3" Margin="15,0"/>

                <!-- ОБЩАЯ СУММА -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ВСЕГО работ:" Foreground="{DynamicResource TextIconBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalWorks, Converter={StaticResource CostConverter}}" 
                           Foreground="#FFD700" FontWeight="Bold" FontSize="16"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

            </StackPanel>
        </Border>
        
        <!-- 🔹 Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">

            <!-- Материал -->
            <StackPanel Orientation="Horizontal" Margin="10,0">
                <TextBlock Text="Материал:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalMaterial, Converter={StaticResource CostConverter}}" 
                           FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </StackPanel>

            <Button Content="Обновить" Command="{Binding RefreshCommand}" Width="100"/>
            <Button Content="Экспорт в Excel" Command="{Binding ExportCommand}" 
                    Style="{StaticResource ButtonSuccess}" Width="140" Margin="10,0,0,0"/>
            <Button Content="Закрыть" Command="{Binding CloseCommand}" 
                    Width="100" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>