<Window x:Class="Metal_Code.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:Metal_Code"
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        Title="Отчет по продажам" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <!-- ⭐ Конвертеры регистрируем в ресурсах окна -->
        <converters:GroupSumConverter x:Key="GroupSumConverter"/>
        <converters:BoolToTaxConverter x:Key="BoolToTaxConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔹 ПАНЕЛЬ ИНФОРМАЦИИ О ПЕРИОДЕ -->
        <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}" 
                CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📅 Период:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding PeriodText}" VerticalAlignment="Center" FontSize="13"/>
                    <TextBlock Text="{Binding ModeText}" VerticalAlignment="Center" 
                               Margin="20,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                </StackPanel>

                
                <Button Grid.Column="1" Content="💾 Экспорт в Excel" 
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource ButtonSuccess}" Padding="12,6" Margin="0,0,5,0"/>

                <Button Grid.Column="2" Content="✖ Закрыть" 
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource ButtonDefault}" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- 🔹 ТАБЛИЦА ДАННЫХ -->
        <DataGrid Grid.Row="1" x:Name="ReportGrid" 
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander>
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} расчётов)'}" 
                                                   Margin="10,0,0,0" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding Converter={StaticResource GroupSumConverter}}" 
                                                   Margin="20,0,0,0" FontWeight="Bold" Foreground="Green"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✖">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✖" ToolTip="Удалить из отчета"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0" Foreground="Red"
                                    Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="№" Binding="{Binding Number}"/>
                <DataGridTextColumn Header="Компания" Binding="{Binding Company}"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Foreground" Value="Blue"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Нал" Binding="{Binding IsCash, Converter={StaticResource BoolToTaxConverter}}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}"/>
                <DataGridTextColumn Header="Заказ" Binding="{Binding Order}" Foreground="OrangeRed"/>
                <DataGridTextColumn x:Name="DateColumn" Binding="{Binding DisplayDate, StringFormat=dd.MM.yyyy}"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}"/>
                <DataGridTextColumn Header="Коэфф." Binding="{Binding RatioValue, StringFormat={}{0:F2}}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="DarkSlateBlue"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Бонус %" Binding="{Binding BonusRatioValue, StringFormat={}{0:F0}%}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="DarkOrange"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Материал" Binding="{Binding MaterialAmount, StringFormat={}{0:N2} ₽}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Лазер" Binding="{Binding LaserCost, StringFormat={}{0:N2} ₽}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Гибка" Binding="{Binding BendingCost, StringFormat={}{0:N2} ₽}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Труборез" Binding="{Binding PipeCost, StringFormat={}{0:N2} ₽}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Производство" Binding="{Binding ProductionCost, StringFormat={}{0:N2} ₽}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Всего работ" Binding="{Binding TotalWorks, StringFormat={}{0:N2} ₽}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 🔹 СВОДКА ПО МЕНЕДЖЕРАМ -->
        <Border Grid.Row="2" Background="#FFF9E6" BorderBrush="#E6D9A8" BorderThickness="1"
        CornerRadius="4" Padding="10" Margin="0,10,0,0"
        Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <StackPanel>

                <!-- ⭐ Expander со списком менеджеров -->
                <Expander>
                    <Expander.Header>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1" 
                   Text="📊 Выполнение плана (план: 7 000 000 ₽, макс. премия: 100 000 ₽)"
                   FontWeight="Bold" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="20,0,0,0"/>
                        </Grid>
                    </Expander.Header>
                    
                    <!-- Содержимое Expander: только список менеджеров -->
                    <ItemsControl ItemsSource="{Binding ManagersSummary, Mode=OneWay}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="8,5" Background="White" 
                                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding ManagerName, Mode=OneWay}" 
                                           FontWeight="Bold" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Run Text="Работы: "/>
                                    <Run Text="{Binding TotalWorks, StringFormat={}{0:N0} ₽, Mode=OneWay}" 
                                         FontWeight="Bold" Foreground="Green"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Run Text="План: "/>
                                    <Run Text="{Binding Percent, StringFormat={}{0:F1}%, Mode=OneWay}" 
                                         FontWeight="Bold"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           FontWeight="Bold" Foreground="DarkGreen">
                                    <Run Text="💰 "/>
                                    <Run Text="{Binding Bonus, StringFormat={}{0:N0} ₽, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!-- ⭐ Итоговая строка — СНАРУЖИ Expander, видна всегда -->
                <Border Margin="0,8,0,0" Padding="8,5" Background="#FFE4B5" BorderBrush="#DAA520" 
                BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="ИТОГО:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold">
                    <Run Text="Работы: "/>
                    <Run Text="{Binding TotalWorksSum, StringFormat={}{0:N0} ₽, Mode=OneWay}" Foreground="Green"/>
                        </TextBlock>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold">
                    <Run Text="План: "/>
                    <Run Text="{Binding TotalPercent, StringFormat={}{0:F1}%, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" 
                           FontWeight="Bold" FontSize="13" Foreground="DarkGreen">
                    <Run Text="💰 "/>
                    <Run Text="{Binding TotalBonus, StringFormat={}{0:N0} ₽, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>