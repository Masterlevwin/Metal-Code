<Window x:Class="Metal_Code.SpecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:self="clr-namespace:Metal_Code"
        mc:Ignorable="d"
        Title="Спецификация" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.InactiveCaptionBrushKey}}"
        Width="550" Height="750" ResizeMode="NoResize" Loaded="Loaded_Window">

    <DockPanel LastChildFill="True" Margin="10">

        <!-- Кнопка Создать (всегда внизу) -->
        <Button DockPanel.Dock="Bottom" Click="Create_Spec" Margin="0,10,0,0" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Images/save4.png"/>
                <TextBlock Text="Создать" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="5"/>
            </StackPanel>
        </Button>

        <!-- GroupBox занимает всё оставшееся пространство -->
        <GroupBox DataContext="{Binding CurrentTemplate}" Header="Заголовок">
            <!-- ScrollViewer для прокрутки контента, если строк станет слишком много -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                <StackPanel Margin="5">
                    <!-- Заголовок -->
                    <TextBox Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center"
                 TextWrapping="Wrap"
                 MinHeight="30"
                 MaxWidth="280"
                 Padding="4"
                 BorderThickness="2"
                 Margin="5" HorizontalAlignment="Right" MinWidth="280"/>

                    <!-- Номер спецификации -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="СПЕЦИФИКАЦИЯ №" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="4"
                     Margin="5"
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="50"/>
                    </StackPanel>

                    <!-- Блок условий (Срок поставки, Доставка, Оплата) -->
                    <StackPanel Margin="10,15,10,5">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Срок поставки:" VerticalAlignment="Center"/>
                            <!-- Отступ справа 35px нужен, чтобы компенсировать место под кнопку удаления в новых строках -->
                            <TextBox x:Name="EndDate" Grid.Column="1" Margin="0,0,35,0"
                                     VerticalContentAlignment="Center" TextWrapping="Wrap" Padding="2" BorderThickness="2"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Условия доставки:" VerticalAlignment="Center"/>
                            <TextBox x:Name="Delivery" Grid.Column="1" Margin="0,0,35,0"
                                     VerticalContentAlignment="Center" TextWrapping="Wrap" Padding="2" BorderThickness="2"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Условия оплаты:" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Terms, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,0,35,0"
                                     VerticalContentAlignment="Center" TextWrapping="Wrap" Padding="2" BorderThickness="2"/>
                        </Grid>
                    </StackPanel>

                    <!-- ДИНАМИЧЕСКИЕ ПОЛЬЗОВАТЕЛЬСКИЕ СТРОКИ -->
                    <ItemsControl ItemsSource="{Binding CustomFields}" Margin="10,10,10,5">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <!-- Фиксированная ширина названия -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Значение растягивается -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Кнопка удаления -->
                                    </Grid.ColumnDefinitions>

                                    <!-- TextBox Названия -->
                                    <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                             Margin="0,0,5,0" TextWrapping="Wrap" AcceptsReturn="True" 
                                             MinHeight="28" MaxHeight="70" VerticalScrollBarVisibility="Auto"
                                             VerticalAlignment="Top" VerticalContentAlignment="Top"
                                             Padding="2" BorderThickness="2" FontWeight="SemiBold"/>

                                    <!-- TextBox Значения -->
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                             TextWrapping="Wrap" AcceptsReturn="True" 
                                             MinHeight="28" MaxHeight="70" VerticalScrollBarVisibility="Auto"
                                             VerticalAlignment="Top" VerticalContentAlignment="Top"
                                             Padding="2" BorderThickness="2"/>

                                    <!-- Кнопка удаления -->
                                    <Button Grid.Column="2" Content="✕" Margin="5,0,0,0" Width="30" Height="28"
                                            VerticalAlignment="Top" Click="RemoveCustomField_Click" Tag="{Binding}"
                                            ToolTip="Удалить строку" Foreground="Red"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Кнопка добавления -->
                    <Button Content="➕ Добавить строку" Click="AddCustomField_Click" 
                            Margin="10,5,0,10" HorizontalAlignment="Left" Padding="5,2"/>

                    <!-- Поставщик и Покупатель -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <!-- Поставщик -->
                        <StackPanel Margin="10">
                            <TextBlock Text="ПОСТАВЩИК" Margin="0,0,0,5"/>
                            <ComboBox SelectedItem="{Binding Provider}"
                          ItemsSource="{Binding DataContext.Providers,
                            RelativeSource={RelativeSource AncestorType=Window}}"
                          Margin="0,0,0,5" HorizontalAlignment="Left" Width="150"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinHeight="32">
                                <Border BorderBrush="Black" BorderThickness="0,0,0,1" Width="80" Margin="5,0"/>
                                <TextBlock Text="Мешеронова М.С." VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Покупатель -->
                        <StackPanel Margin="10">
                            <TextBlock Text="ПОКУПАТЕЛЬ" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                                <TextBox x:Name="Agent" Width="60" ToolTip="Введите форму юридического лица"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"/>
                                <TextBlock Text="{Binding DataContext.TargetCustomer.Name,
                            RelativeSource={RelativeSource AncestorType=Window}}" Width="150" Margin="5,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" MinHeight="32">
                                <Border BorderBrush="Black" BorderThickness="0,0,0,1" Width="80" Margin="5,0"/>
                                <TextBox Text="{Binding Buyer, UpdateSourceTrigger=PropertyChanged}"
                             Width="120"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

    </DockPanel>
</Window>