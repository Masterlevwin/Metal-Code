<Window x:Class="Metal_Code.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Ассистент Metal-Code" 
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="/app_logo.jpeg"
        Background="{DynamicResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Цвета и стили, согласованные с MainWindow -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFFE1"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D1D9E0"/>
        <SolidColorBrush x:Key="FocusBorderColor" Color="#4A90E2"/>
        <Thickness x:Key="DefaultBorderThickness">1</Thickness>

        <!-- Обычная кнопка -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FocusBorderColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ⭐ АКЦЕНТНАЯ КНОПКА "Проверить расчёт" -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#2E86DE"
                                BorderBrush="#1B6FC0"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D95E8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1B6FC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#F0F8FF" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🤖 МИША" 
                           FontSize="16" FontWeight="Bold" 
                           Foreground="#2C3E50"/>
                <TextBlock Text="Задайте вопрос о программе — я подскажу, где найти нужную кнопку, расскажу о ценах или проверю расчёт."
                           FontSize="12" Foreground="#555" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Область чата -->
        <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChatHistory">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- ⭐ Внешний контейнер сообщения с цветной полосой слева -->
                        <Border Margin="0,5" CornerRadius="6"
                                Background="{Binding Background}"
                                BorderBrush="{Binding AccentBrush}"
                                BorderThickness="3,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Иконка кнопки (если есть) -->
                                <Border Grid.Column="0" 
                                        VerticalAlignment="Top" 
                                        Margin="10,10,0,10"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Background="White" 
                                        BorderBrush="#D1D9E0" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="6">
                                    <Image Source="{Binding IconSource}" 
                                           Width="32" Height="32" 
                                           Stretch="Uniform"
                                           ToolTip="Так выглядит кнопка в интерфейсе"/>
                                </Border>

                                <!-- Текст ответа -->
                                <StackPanel Grid.Column="1" Margin="12,10,12,10">
                                    <TextBlock Text="{Binding Sender}" 
                                               FontWeight="Bold" FontSize="11" 
                                               Foreground="{Binding SenderBrush}" 
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Text}" 
                                               TextWrapping="Wrap" FontSize="13"
                                               Foreground="{Binding TextBrush}"/>

                                    <!-- Кнопки действий -->
                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}" 
                                                        Margin="0,0,6,4" Padding="8,4"
                                                        FontSize="11"
                                                        Click="OnActionButtonClick"
                                                        Tag="{Binding CommandId}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Поле ввода -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueryTextBox" 
                     hc:InfoElement.Placeholder="Введите вопрос... (например: 'как создать сборку?' или 'цена алюминия 8 мм')"
                     Margin="0,0,8,0" 
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     KeyDown="QueryTextBox_KeyDown"/>

            <Button Grid.Column="1" 
                    Content="Спросить" 
                    Click="OnAskButtonClick" Padding="16,5,16,5"/>

            <!-- ⭐ Акцентная кнопка проверки расчёта -->
            <Button Grid.Column="2" 
                    Content="✓ Проверить расчёт" 
                    Click="OnValidateButtonClick"
                    Margin="8,0,0,0"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTip="Проверить текущий расчёт на наличие нулей и ошибок"/>
        </Grid>
    </Grid>
</Window>