<Window x:Class="Metal_Code.FolderPresetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Выберите папки для создания"
        Width="400" Height="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Отметьте папки, которые нужно создать в расчете:" 
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Foreground="#555"/>

        <!-- Список с прокруткой -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PresetsContainer" Margin="0,0,4,0"/>
        </ScrollViewer>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Выбрать все" Click="SelectAll_Click" Margin="0,0,8,0" Style="{StaticResource ButtonInfo}"/>
            <Button Content="Сбросить" Click="ClearAll_Click" Margin="0,0,8,0" Style="{StaticResource ButtonWarning}"/>
            <Separator Margin="0,0,8,0"/>
            <Button Content="Отмена" IsCancel="True" Width="80" Margin="0,0,8,0"/>
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Width="80" Style="{StaticResource ButtonPrimary}"/>
        </StackPanel>
    </Grid>
</Window>