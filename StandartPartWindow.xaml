<Window x:Class="Metal_Code.StandartPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        xmlns:utils="clr-namespace:Metal_Code.Utils"
        xmlns:controls="clr-namespace:Metal_Code.Controls"
        Title="Стандартные детали" 
        MinWidth="900" MinHeight="600" 
        WindowState="Maximized">

    <Window.Resources>
        <converters:PartTypeToVisibilityConverter x:Key="PartTypeToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:PartTypeToLocalizedNameConverter x:Key="PartTypeToLocalizedNameConverter"/>
        <converters:PartTypeToReadOnlyConverter x:Key="PartTypeToReadOnlyConverter"/>
        <converters:RatioConverter x:Key="RatioConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!--  ЛЕВАЯ КОЛОНКА                                        -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <!-- Верх: параметры + гибка — без скролла, видны полностью -->
                <RowDefinition Height="Auto"/>
                <!-- Низ: отверстия + канвас + инструменты — внутри скролла -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════ -->
            <!--  Row 0: ВЕРХНЯЯ ЧАСТЬ (без скролла)               -->
            <!-- ═══════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="0">

                <!-- 1. Параметры детали -->
                <Border BorderBrush="{DynamicResource SecondaryTextBrush}" 
                BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" 
                Background="{DynamicResource RegionBrush}">
                    <StackPanel Margin="10">
                        <TextBlock Text="Параметры детали" FontSize="13" FontWeight="Bold" 
                           Margin="0,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" 
                            Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle,Triangle,Custom'}">
                            <TextBlock Text="Форма:" VerticalAlignment="Center" Margin="0,0,10,0" 
                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <RadioButton x:Name="RectangleRadio" Content="Прямоугольник" 
                                 Tag="Rectangle" Checked="OnShapeTypeChanged"/>
                            <RadioButton Content="Круг" Tag="Round" Margin="15,0,0,0" Checked="OnShapeTypeChanged"/>
                            <RadioButton Content="Треугольник" Tag="Triangle" Margin="15,0,0,0" Checked="OnShapeTypeChanged"/>
                            <RadioButton Content="Произвольная" Tag="Custom" Margin="15,0,0,0" Checked="OnShapeTypeChanged"/>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" 
                        CornerRadius="6" Background="{DynamicResource SecondaryRegionBrush}" Padding="8">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,10,0" 
                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBox x:Name="TitleTextBox" Grid.Column="1"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     hc:InfoElement.Placeholder="Например: Пластина"
                                     Style="{StaticResource TextBoxExtend}" 
                                     FontSize="14" FontWeight="SemiBold"
                                     TextChanged="TitleTextBox_TextChanged"/>
                                    <Button Grid.Column="2" Content="📄 Создать PDF-эскиз (тест)" Click="ExportToPdf_Click"
                            Style="{StaticResource ButtonInfo}" Padding="8,4" Margin="10,0"
                            ToolTip="Экспорт чертежа в PDF"/>

                                </Grid>

                                <!-- Поля ЛИСТОВЫХ деталей -->
                                <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, 
                                                ConverterParameter='Round,Rectangle,Triangle,Custom'}">
                                    <TextBlock Text="Ширина (мм):" VerticalAlignment="Center" Margin="0,0,5,0"
                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBox x:Name="WidthInput" Width="100"
                                     Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                     hc:InfoElement.Placeholder="50" Style="{StaticResource TextBoxExtend}"
                                     FontSize="13" FontWeight="SemiBold"
                                     IsReadOnly="{Binding PartType, Converter={StaticResource PartTypeToReadOnlyConverter}}"
                                     utils:TextBoxHelper.SelectAllOnFocus="True"
                                     TextChanged="DimensionTextBox_TextChanged"/>
                                    <TextBlock Text="Высота (мм):" VerticalAlignment="Center" Margin="15,0,5,0"
                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBox x:Name="HeightInput" Width="100"
                                     Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                     hc:InfoElement.Placeholder="50" Style="{StaticResource TextBoxExtend}"
                                     FontSize="13" FontWeight="SemiBold"
                                     IsReadOnly="{Binding PartType, Converter={StaticResource PartTypeToReadOnlyConverter}}"
                                     utils:TextBoxHelper.SelectAllOnFocus="True"
                                     TextChanged="DimensionTextBox_TextChanged"/>
                                    <TextBlock Text="Количество (шт):" VerticalAlignment="Center" Margin="15,0,5,0"
                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBox Width="100"
                                     Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                     hc:InfoElement.Placeholder="1" Style="{StaticResource TextBoxExtend}"
                                     FontSize="13" FontWeight="SemiBold"
                                     utils:TextBoxHelper.SelectAllOnFocus="True"
                                     TextChanged="DimensionTextBox_TextChanged"/>
                                </StackPanel>

                                <!-- Поля ТРУБНЫХ деталей -->
                                <Grid Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, 
                                    ConverterParameter='RoundTube,RectangularTube,Angle,Channel,IBeam,Circle,SquareBar'}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,10,0" Grid.ColumnSpan="2">
                                        <TextBlock Text="Добавленные длины:" Margin="0,0,0,3" 
                                           FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="70">
                                            <ItemsControl x:Name="RecentLengthsItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                                        CornerRadius="4" Padding="2" Margin="0,0,5,3" Background="White">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Content="−" Click="ChipDecrement_Click"
                                                                Width="22" Height="22" Padding="0"
                                                                Style="{StaticResource ButtonDashed}"
                                                                FontWeight="Bold" FontSize="13"
                                                                Foreground="Tomato" Cursor="Hand"/>
                                                                <StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Length, StringFormat=L{0:0}}" 
                                                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Count, StringFormat=×{0}}" 
                                                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" 
                                                                       FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                                </StackPanel>
                                                                <Button Content="+" Click="ChipIncrement_Click"
                                                                Width="22" Height="22" Padding="0"
                                                                Style="{StaticResource ButtonDashed}"
                                                                FontWeight="Bold" FontSize="13"
                                                                Foreground="Green" Cursor="Hand"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="Длина (мм):" Margin="0,0,0,3" 
                                           FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBox x:Name="PipeLengthInput" 
                                         Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}"
                                         hc:InfoElement.Placeholder="1000" Style="{StaticResource TextBoxExtend}"
                                         FontSize="14" FontWeight="SemiBold"
                                         KeyDown="PipeLengthInput_KeyDown"
                                         utils:TextBoxHelper.SelectAllOnFocus="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Количество (шт):" Margin="0,0,0,3" 
                                           FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" 
                                         hc:InfoElement.Placeholder="1"
                                         Style="{StaticResource TextBoxExtend}" 
                                         FontSize="14" FontWeight="SemiBold"
                                         utils:TextBoxHelper.SelectAllOnFocus="True"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Блок гибки (полностью видимый, без скролла) -->
                <Border BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1" CornerRadius="4"
                Margin="0,0,0,10" Background="{DynamicResource RegionBrush}"
                Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle'}">
                    <Expander x:Name="BendExpander" IsExpanded="False" 
                      Expanded="BendExpander_Expanded" Collapsed="BendExpander_Collapsed"
                      Padding="10" Margin="10">
                        <Expander.Header>
                            <TextBlock Text="Гибка" FontWeight="Bold" FontSize="13"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Expander.Header>

                        <StackPanel>
                            <!-- Угол гиба -->
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Угол:" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{DynamicResource PrimaryBrush}" 
                                   VerticalAlignment="Center" Margin="10,0,4,0"/>
                                <TextBox Grid.Column="1" x:Name="BendAngleInput" Text="90" Width="40"
                                 Style="{StaticResource TextBoxExtend}" FontSize="12"
                                 VerticalContentAlignment="Center" 
                                 TextChanged="BendParameters_Changed" Margin="5,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="°" VerticalAlignment="Center" 
                                   Margin="2,0,0,0" FontSize="12"/>
                            </Grid>

                            <!-- Редакторы профилей + изометрия -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <controls:BendProfileEditor Grid.Column="0" x:Name="BendEditorX"
                                                    ProfileTitle="По ширине"
                                                    ProfileChanged="OnBendProfileChanged"
                                                    Margin="0,0,8,0"/>
                                <controls:BendProfileEditor Grid.Column="1" x:Name="BendEditorY"
                                                    ProfileTitle="По высоте"
                                                    ProfileChanged="OnBendProfileChanged"
                                                    Margin="0,0,8,0"/>

                                <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" 
                                CornerRadius="4" Padding="6" Background="#F8F9FA" Width="170"
                                VerticalAlignment="Stretch"
                                ToolTip="Изометрический вид собранной детали">
                                    <StackPanel>
                                        <TextBlock x:Name="BendInfoText" Text="Профили не заданы"
                                           FontStyle="Italic" Foreground="Gray" FontSize="11"
                                           Margin="0,0,0,6" TextWrapping="Wrap"
                                           VerticalAlignment="Top"/>
                                        <Canvas x:Name="IsoPreviewCanvas" Height="120" Background="Transparent"
                                        SizeChanged="IsoPreviewCanvas_SizeChanged"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ★ Рекомендация по матрице — ограничение 100px со скроллом -->
                            <Border x:Name="MatrixRecommendationBorder" 
                            Background="{DynamicResource SecondaryRegionBrush}"
                            CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
                            MaxHeight="100" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="MatrixRecommendationText"
                                       FontSize="11" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>

            <!-- ═══════════════════════════════════════════════════ -->
            <!--  Row 1: НИЖНЯЯ ЧАСТЬ (внутри ScrollViewer)        -->
            <!--  Отверстия + Канвас + Инструменты                  -->
            <!-- ═══════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1" 
                  VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Отверстия + Канвас -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Блок отверстий для ПРОСТЫХ форм -->
                        <Border Grid.Column="0" Width="200" Margin="0,0,8,0"
        BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1"
        CornerRadius="4" Padding="10" Background="{DynamicResource RegionBrush}"
        VerticalAlignment="Stretch"
        Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter},
                            ConverterParameter='Rectangle,Triangle,Round,RectangularTube,RoundTube,Angle,Channel,IBeam'}">
                            <StackPanel>
                                <TextBlock Text="Отверстия" FontWeight="Bold" FontSize="13" 
                   Margin="0,0,0,8" Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="⌀ диаметр:" FontWeight="SemiBold" Foreground="DarkBlue" 
                       VerticalAlignment="Center" Margin="0,0,4,0" Width="65"/>
                                    <TextBox x:Name="DiameterInput" Text="10" Width="50" 
                     Style="{StaticResource TextBoxExtend}"
                     TextChanged="HoleInput_TextChanged"
                     KeyDown="HoleInput_KeyDown"
                     utils:TextBoxHelper.SelectAllOnFocus="True"/>
                                    <TextBlock Text="мм" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Кол-во:" FontWeight="SemiBold" Foreground="DarkBlue" 
                       VerticalAlignment="Center" Margin="0,0,4,0" Width="65"/>
                                    <TextBox x:Name="CountInput" Text="1" Width="50" 
                     Style="{StaticResource TextBoxExtend}"
                     TextChanged="HoleInput_TextChanged"
                     KeyDown="HoleInput_KeyDown"
                     utils:TextBoxHelper.SelectAllOnFocus="True"/>
                                    <TextBlock Text="шт" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>

                                <!-- ★ Подсказка: появляется при вводе значений -->
                                <TextBlock x:Name="HolePendingHint" 
                   Text="Нажмите «Добавить» или Enter"
                   FontSize="10" Foreground="DarkOrange" FontStyle="Italic"
                   Margin="0,0,0,4" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

                                <!-- ★ Кнопка с именем для подсветки -->
                                <Button x:Name="AddHoleButton" 
                Content="Добавить отверстие" Click="AddHoleGroup_Click"
                Style="{StaticResource ButtonDashedPrimary}" Padding="8,4" Margin="0,0,0,8"/>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                    <ItemsControl ItemsSource="{Binding HoleGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" 
                                Padding="3" Margin="0,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Diameter, StringFormat=⌀{0:F1}}"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" × " VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Count}" FontWeight="Bold" 
                                           VerticalAlignment="Center"/>
                                                        <Button Content="×" Foreground="Red" Cursor="Hand"
                                        Click="RemoveHoleGroup_Click" Tag="{Binding}"
                                        Margin="6,0,0,0" Padding="3,0"
                                        Background="Transparent" BorderThickness="0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        
                        <!-- ─── Блок отверстий для CUSTOM ─── -->
                        <Border Grid.Column="0" Width="200" Margin="0,0,8,0"
                        BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" 
                        CornerRadius="4" Background="{DynamicResource SecondaryRegionBrush}" 
                        Padding="8" VerticalAlignment="Stretch"
                        Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, 
                                            ConverterParameter='Custom'}">
                            <StackPanel>
                                <TextBlock Text="Отверстия" FontWeight="Bold" FontSize="12" 
                                   Margin="0,0,0,8" Foreground="{DynamicResource PrimaryTextBrush}"/>

                                <ToggleButton x:Name="HoleModeToggle" Content="⭕ Режим отверстий" 
                                      Click="HoleModeToggle_Click" 
                                      Style="{StaticResource ToggleButtonDefault}" 
                                      Padding="6,4" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="⌀" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,4,0"/>
                                    <TextBox x:Name="HoleDiameterInput" Text="10" Width="50" 
                                     Style="{StaticResource TextBoxExtend}" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="мм" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="HoleEditPanel" Visibility="Collapsed" Margin="0,6,0,6">
                                    <TextBlock Text="Позиция:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock x:Name="HoleHorizLabel" Text="От верт.:" 
                                           VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBox x:Name="HoleHorizDistInput" Width="50" 
                                         Style="{StaticResource TextBoxExtend}" TextAlignment="Center" 
                                         FontSize="11" KeyDown="HoleDistInput_KeyDown"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock x:Name="HoleVertLabel" Text="От гориз.:" 
                                           VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBox x:Name="HoleVertDistInput" Width="50" 
                                         Style="{StaticResource TextBoxExtend}" TextAlignment="Center" 
                                         FontSize="11" KeyDown="HoleDistInput_KeyDown"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="✓" Click="ApplyHolePosition_Click" 
                                        Style="{StaticResource ButtonInfo}" Padding="6,2" Margin="0,0,4,0"/>
                                        <Button Content="✖" Click="CancelHoleEdit_Click" 
                                        Style="{StaticResource ButtonDashed}" Padding="6,2"/>
                                    </StackPanel>
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding PlacedHoles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" 
                                                Padding="3" Margin="0,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Diameter, StringFormat=⌀{0:F1}}" 
                                                           FontWeight="Bold" VerticalAlignment="Center" Width="40" FontSize="11"/>
                                                        <TextBlock Text="{Binding X, StringFormat=X:{0:0}}" 
                                                           Foreground="DimGray" VerticalAlignment="Center" Width="40" FontSize="10"/>
                                                        <TextBlock Text="{Binding Y, StringFormat=Y:{0:0}}" 
                                                           Foreground="DimGray" VerticalAlignment="Center" Width="40" FontSize="10"/>
                                                        <Button Content="×" Foreground="Red" Cursor="Hand" 
                                                        CommandParameter="{Binding}" Click="RemovePlacedHole_Click" 
                                                        Margin="4,0,0,0" Padding="3,0" FontSize="10"
                                                        Background="Transparent" BorderThickness="0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- ─── КАНВАС РАЗВЕРТКИ ─── -->
                        <Border Grid.Column="1" x:Name="DrawingAreaBorder" Background="White" 
                        CornerRadius="4"
                        BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1" 
                        ClipToBounds="True"
                        MinHeight="{Binding ActualHeight, 
                                   RelativeSource={RelativeSource AncestorType=Window},
                                   Converter={StaticResource RatioConverter},
                                   ConverterParameter=0.5}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок + переключатель режимов -->
                                <Border Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}" 
                                Padding="8,4" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="📐 Развертка" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, 
                                                        ConverterParameter='Rectangle,Round,Triangle'}">
                                            <RadioButton x:Name="ViewSheetRadio" Content="📄 Вид на листе" 
                                                 Checked="ViewMode_Changed"
                                                 Margin="0,0,10,0" FontSize="11"/>
                                            <RadioButton x:Name="ViewPartRadio" Content="🔍 По размеру детали" 
                                                 Checked="ViewMode_Changed" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Область рисования -->
                                <Grid Grid.Row="1" x:Name="DrawingAreaGrid" Background="Transparent"
                              PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp"
                              MouseMove="Grid_MouseMove"
                              MouseLeave="Grid_MouseLeave"
                              PreviewMouseWheel="Grid_PreviewMouseWheel"
                              SizeChanged="DrawingArea_SizeChanged">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Canvas x:Name="BackgroundCanvas"/>
                                    <Canvas x:Name="DrawingCanvas"/>
                                </Grid>

                                <!-- Плавающая панель инструментов -->
                                <Border Grid.Row="1" 
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                Margin="10,10,0,0" Padding="4,2" CornerRadius="4"
                                Background="#EEFFFFFF" BorderBrush="LightGray" BorderThickness="1"
                                Panel.ZIndex="10">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🔍" Click="FitView_Click" ToolTip="Вписать"
                                        Style="{StaticResource ButtonDashed}" 
                                        Width="28" Height="28" Padding="0" Margin="1" FontSize="13"/>
                                        <Button Content="➕" Click="ZoomIn_Click" ToolTip="Увеличить"
                                        Style="{StaticResource ButtonDashed}" 
                                        Width="28" Height="28" Padding="0" Margin="1" FontSize="13"/>
                                        <Button Content="➖" Click="ZoomOut_Click" ToolTip="Уменьшить"
                                        Style="{StaticResource ButtonDashed}" 
                                        Width="28" Height="28" Padding="0" Margin="1" FontSize="13"/>
                                        <Separator Width="1" Margin="4,2" Height="20" VerticalAlignment="Center"/>
                                        <Button Content="↩" Click="UndoPoint_Click" ToolTip="Отменить"
                                        Style="{StaticResource ButtonDashed}" 
                                        Width="28" Height="28" Padding="0" Margin="1" FontSize="13"/>
                                        <Button Content="✖" Click="ClearDrawing_Click" ToolTip="Очистить"
                                        Style="{StaticResource ButtonDashedDanger}" 
                                        Width="28" Height="28" Padding="0" Margin="1" FontSize="13"/>
                                    </StackPanel>
                                </Border>

                                <!-- Индикатор масштаба -->
                                <Border Grid.Row="1" 
                                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Margin="0,0,10,40" Padding="8,3" CornerRadius="4"
                                Background="#CCFFFFFF" BorderBrush="LightGray" BorderThickness="1"
                                Panel.ZIndex="10">
                                    <TextBlock x:Name="ScaleIndicator" FontSize="11" Foreground="Gray" 
                                       FontWeight="SemiBold" Text="Масштаб: 100%"/>
                                </Border>

                                <!-- Кнопка «Добавить в список» -->
                                <Button Grid.Row="1" 
                                Content="✓ Добавить в список" Click="AddToBatch_Click"
                                Style="{StaticResource ButtonPrimary}" 
                                Margin="0,0,10,8" Padding="12,6"
                                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Panel.ZIndex="10" IsDefault="True"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Панель управления Custom -->
                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8" 
                       Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Custom'}">
                        <Button x:Name="FinishDrawingButton" Content="✓ Завершить контур" Click="FinishDrawing_Click" 
                        Margin="3" Style="{StaticResource ButtonDefault}" 
                        BorderBrush="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryBrush}" 
                        Padding="10,4" FontWeight="SemiBold"/>
                        <StackPanel x:Name="EditModePanel" Orientation="Horizontal" 
                            Visibility="Collapsed" Margin="10,0,0,0">
                            <Separator Width="1" Margin="10,0" Height="20" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="EditModeToggle" Content="📏 Режим размеров" 
                                  Click="EditModeToggle_Click" Margin="3" 
                                  Style="{StaticResource ToggleButtonDefault}" Padding="10,4"/>
                            <TextBlock Text="Размер:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold"/>
                            <TextBox x:Name="SegmentSizeInput" Width="80" Style="{StaticResource TextBoxExtend}" 
                             TextChanged="SegmentSizeInput_TextChanged" KeyDown="SegmentSizeInput_KeyDown"/>
                            <TextBlock x:Name="CurrentSizeText" Text="—" VerticalAlignment="Center" 
                               Margin="5,0,0,0" Foreground="Gray"/>
                            <Button Content="✓ Применить" Click="ApplySize_Click" Margin="5,0,0,0" 
                            Style="{StaticResource ButtonInfo}" Padding="8,4"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Подсказка -->
                    <TextBlock Text="Ctrl+Колесо: зум | Alt+ЛКМ: перемещение | Линии привязываются к 90°" 
                       FontSize="11" Foreground="Gray" TextAlignment="Center" Margin="0,2,0,10"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <!-- ╔══════════════════════════════════════════════════════╗ -->
        <!-- ║  ПРАВАЯ КОЛОНКА: Список деталей (без изменений)    ║ -->
        <!-- ╚══════════════════════════════════════════════════════╝ -->
        <Border Grid.Column="1" Grid.Row="0" 
                BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1" 
                CornerRadius="4" Padding="10" Background="{DynamicResource RegionBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Список деталей" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BatchItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" 
                                            Margin="0,5" Padding="5" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" 
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding PartType, Converter={StaticResource PartTypeToLocalizedNameConverter}}" 
                                                               FontStyle="Italic" Foreground="DimGray" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Width, StringFormat={}{0:0}×}" 
                                                               Foreground="DimGray" 
                                                               Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,Triangle,Custom,RectangularTube,Angle,Channel,IBeam'}"/>
                                                    <TextBlock Text="{Binding Height, StringFormat={}{0:0}}" 
                                                               Foreground="DimGray" 
                                                               Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,Triangle,Custom,RectangularTube,Angle,Channel,IBeam'}"/>
                                                    <TextBlock Text="{Binding Width, StringFormat=Ø{0:0}}" 
                                                               Foreground="DimGray" 
                                                               Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,RoundTube,Circle'}"/>
                                                    <TextBlock Text="{Binding Height, StringFormat=■{0:0}}" 
                                                               Foreground="DimGray" 
                                                               Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='SquareBar'}"/>
                                                    <TextBlock Text="{Binding Length, StringFormat={}\ L{0:0}}" 
                                                               Foreground="DimGray" 
                                                               Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='RoundTube,RectangularTube,Angle,Channel,IBeam,Circle,SquareBar'}"/>

                                                    <Expander Margin="10,0,0,0" 
                                                              Visibility="{Binding HoleGroups.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter='0'}" 
                                                              Width="100" VerticalAlignment="Center">
                                                        <Expander.Header>
                                                            <TextBlock Text="с отв" FontWeight="Bold" FontSize="11" Foreground="#007ACC"/>
                                                        </Expander.Header>
                                                        <StackPanel Margin="5,0,0,5">
                                                            <ItemsControl ItemsSource="{Binding HoleGroups}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                            <TextBlock Text="⌀" FontWeight="Bold" Foreground="DimGray"/>
                                                                            <TextBlock Text="{Binding Diameter, StringFormat={}{0:F1}}" 
                                                                                       FontWeight="Bold" Margin="2,0"/>
                                                                            <TextBlock Text="мм × " Foreground="DimGray"/>
                                                                            <TextBlock Text="{Binding Count}" FontWeight="Bold"/>
                                                                            <TextBlock Text=" шт." Foreground="DimGray"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count, StringFormat={}{0} шт}" 
                                                           Foreground="Blue" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <Button Content="🗑" ToolTip="Удалить" 
                                                        Click="RemoveFromBatch_Click" Tag="{Binding}" 
                                                        Padding="5,0" Background="Transparent" BorderThickness="0" 
                                                        Foreground="Tomato" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <!-- Настройки для листовых деталей -->
                    <StackPanel Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,Round,Triangle,Custom'}">
                        <ToggleButton x:Name="AutoNestingCheck" Content="Автоподбор листов" 
                                      FontWeight="Bold" Style="{StaticResource ToggleButtonSwitch.Small}" 
                                      IsChecked="True" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="Отступы" VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
                            <TextBox x:Name="SpacingInput" Style="{StaticResource TextBoxExtend}" 
                                     hc:InfoElement.Placeholder="0 = авто" Width="80" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Настройки для трубных деталей -->
                    <StackPanel Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='RoundTube,RectangularTube,Angle,Channel,IBeam,Circle,SquareBar'}">
                        <Button Content="📦 Остатки" Click="OpenRemnants_Click" Margin="5" 
                                Style="{StaticResource ButtonDashed}"/>
                        <TextBlock Text="Зона зажима (мм)" FontWeight="Bold" Margin="0,0,0,8" 
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <RadioButton x:Name="Clamp340Radio" Content="340" GroupName="ClampZone" 
                                         IsChecked="True" Margin="0,0,15,0"/>
                            <RadioButton x:Name="Clamp160Radio" Content="160" GroupName="ClampZone" Margin="0,0,15,0"/>
                            <RadioButton x:Name="Clamp0Radio" Content="0 (нет)" GroupName="ClampZone"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="Пропил (мм)" VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
                            <TextBox x:Name="CutLossInput" Text="10" Style="{StaticResource TextBoxExtend}" 
                                     Width="80" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Завершить и рассчитать" Click="FinishBatch_Click" 
                            Margin="0,0,0,10" Height="40" 
                            Style="{StaticResource ButtonSuccess}" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>