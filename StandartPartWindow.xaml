<Window x:Class="Metal_Code.StandartPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        Title="Стандартные детали" MinWidth="900" MinHeight="600" WindowState="Maximized">

    <Window.Resources>
        <converters:PartTypeToVisibilityConverter x:Key="PartTypeToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:PartTypeToLocalizedNameConverter x:Key="PartTypeToLocalizedNameConverter"/>
        <converters:PartTypeToReadOnlyConverter x:Key="PartTypeToReadOnlyConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">

                <!-- 1. Параметры детали -->
                <Border BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Background="{DynamicResource RegionBrush}">
                    <StackPanel Margin="10">
                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,0,10">
                            <TextBlock x:Name="MaterialInfoText" Foreground="White" FontWeight="SemiBold" FontSize="12">
                <Run Text="Материал: "/>
                <Run Text="{Binding Metal, FallbackValue='Не выбран'}" FontWeight="Bold"/>
                <Run Text=" | Толщина: "/>
                <Run Text="{Binding Destiny, StringFormat={}{0:0.#} мм, FallbackValue='—'}" FontWeight="Bold"/>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="Параметры детали" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle,Triangle,Custom'}">
                            <TextBlock Text="Форма:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                            <RadioButton x:Name="RectangleRadio" Content="Прямоугольник" Tag="Rectangle" Checked="OnShapeTypeChanged"/>
                            <RadioButton Content="Круг" Tag="Round" Margin="15,0,0,0" Checked="OnShapeTypeChanged"/>
                            <RadioButton Content="Треугольник" Tag="Triangle" Margin="15,0,0,0" Checked="OnShapeTypeChanged"/>
                            <RadioButton Content="Произвольная" Tag="Custom" Margin="15,0,0,0" Checked="OnShapeTypeChanged"/>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" CornerRadius="6" Background="{DynamicResource SecondaryRegionBrush}" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Title}" hc:InfoElement.Placeholder="Например: Пластина" Style="{StaticResource TextBoxExtend}" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle,Triangle,Custom'}">
                                        <TextBlock Text="Ширина (мм):" Margin="0,0,0,3" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBox Text="{Binding Width}" hc:InfoElement.Placeholder="50" Style="{StaticResource TextBoxExtend}" FontSize="14" FontWeight="SemiBold" IsReadOnly="{Binding PartType, Converter={StaticResource PartTypeToReadOnlyConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle,Triangle,Custom'}">
                                        <TextBlock Text="Высота (мм):" Margin="0,0,0,3" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBox Text="{Binding Height}" hc:InfoElement.Placeholder="50" Style="{StaticResource TextBoxExtend}" FontSize="14" FontWeight="SemiBold" IsReadOnly="{Binding PartType, Converter={StaticResource PartTypeToReadOnlyConverter}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,10,0" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='RoundTube,RectangularTube,Angle,Channel,IBeam,Circle,SquareBar'}">
                                        <TextBlock Text="Длина (мм):" Margin="0,0,0,3" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBox Text="{Binding Length}" hc:InfoElement.Placeholder="1000" Style="{StaticResource TextBoxExtend}" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="0,0,0,0">
                                        <TextBlock Text="Количество (шт):" Margin="0,0,0,3" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBox Text="{Binding Count}" hc:InfoElement.Placeholder="1" Style="{StaticResource TextBoxExtend}" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 🔥 2. Контейнер: Блок гибки + Холст -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Блок гибки -->
                        <ColumnDefinition Width="*"/>
                        <!-- Холст -->
                    </Grid.ColumnDefinitions>

                    <!-- Блок гибки (слева от холста) -->
                    <Border Grid.Column="0" Padding="10" Margin="0,0,10,0"
                            BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" CornerRadius="4" 
                            Background="{DynamicResource SecondaryRegionBrush}"
                            Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,Custom'}"
                            VerticalAlignment="Stretch" MinWidth="160">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Гибка" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"
                                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>

                            <TextBlock Text="Угол гиба:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="BendAngleInput" Text="90" Style="{StaticResource TextBoxExtend}"
                                     Margin="0,0,0,12" TextChanged="BendParameters_Changed"/>
                            
                            <TextBlock Text="Горизонт.:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="BendsCountXInput" Text="0" Style="{StaticResource TextBoxExtend}" 
                                     Margin="0,0,0,12" TextChanged="BendParameters_Changed"/>

                            <TextBlock Text="Вертикал.:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="BendsCountYInput" Text="0" Style="{StaticResource TextBoxExtend}" 
                                     Margin="0,0,0,12" TextChanged="BendParameters_Changed"/>

                            <Separator Margin="0,0,0,12"/>

                            <TextBlock x:Name="BendInfoText" Text="Линии сгиба не заданы" FontStyle="Italic" 
                                       Foreground="Gray" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Холст (справа от блока гибки) -->
                    <Border Grid.Column="1" x:Name="DrawingAreaBorder" Background="White" CornerRadius="4" 
                             BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1" Height="300"
                             ClipToBounds="True" SizeChanged="DrawingArea_SizeChanged">
                        <Grid x:Name="DrawingAreaGrid" Background="Transparent"
                              PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp"
                              MouseMove="Grid_MouseMove"
                              MouseLeave="Grid_MouseLeave"
                              PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="CanvasTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Canvas x:Name="BackgroundCanvas"/>
                            <Canvas x:Name="DrawingCanvas"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. Панель управления -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Custom'}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <Button Content="🔍 Вписать" Click="FitView_Click" Margin="3" Style="{StaticResource ButtonDashed}" Padding="8,4"/>
                        <Button Content="➕" Click="ZoomIn_Click" Margin="3" Style="{StaticResource ButtonDashed}" Padding="8,4"/>
                        <Button Content="➖" Click="ZoomOut_Click" Margin="3" Style="{StaticResource ButtonDashed}" Padding="8,4"/>
                        <Separator Width="1" Margin="10,0" Height="20" VerticalAlignment="Center"/>
                        <Button Content="↩ Отменить" Click="UndoPoint_Click" Margin="3" Style="{StaticResource ButtonDashed}" Padding="8,4"/>
                        <Button Content="✖ Очистить" Click="ClearDrawing_Click" Margin="3" Style="{StaticResource ButtonDashedDanger}" Padding="8,4"/>
                        <Button x:Name="FinishDrawingButton" Content="✓ Завершить контур" Click="FinishDrawing_Click" Margin="3" 
                                Style="{StaticResource ButtonDefault}" BorderBrush="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource PrimaryBrush}" 
                                Padding="10,4" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel x:Name="EditModePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,10,0">
                        <Separator Width="1" Margin="10,0" Height="20" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="EditModeToggle" Content="📏 Режим размеров" Click="EditModeToggle_Click" Margin="3" 
                                      Style="{StaticResource ToggleButtonDefault}" Padding="10,4"/>
                        <TextBlock Text="Размер:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold"/>
                        <TextBox x:Name="SegmentSizeInput" Width="80" Style="{StaticResource TextBoxExtend}" TextChanged="SegmentSizeInput_TextChanged" KeyDown="SegmentSizeInput_KeyDown"/>
                        <TextBlock x:Name="CurrentSizeText" Text="—" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                        <Button Content="✓ Применить" Click="ApplySize_Click" Margin="5,0,0,0" Style="{StaticResource ButtonInfo}" Padding="8,4"/>
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="Ctrl+Колесо: зум | Alt+ЛКМ: перемещение | Линии привязываются к 90°" FontSize="11" Foreground="Gray" TextAlignment="Center" Margin="0,0,0,10"/>

                <!-- 4. Блок отверстий (для произвольных форм) -->
                <Border BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource SecondaryRegionBrush}" Padding="10" Margin="0,0,0,10"
                        Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Custom'}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <ToggleButton x:Name="HoleModeToggle" Content="⭕ Режим отверстий" Click="HoleModeToggle_Click" Style="{StaticResource ToggleButtonDefault}" Padding="10,4" Margin="0,0,15,0"/>
                            <TextBlock Text="⌀" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                            <TextBox x:Name="HoleDiameterInput" Text="10" Width="60" Style="{StaticResource TextBoxExtend}" VerticalContentAlignment="Center"/>
                            <TextBlock Text="мм" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            <TextBlock Text="(Кликните по детали)" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray" FontStyle="Italic"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="100">
                            <ItemsControl ItemsSource="{Binding PlacedHoles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5" Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Diameter, StringFormat=⌀{0:F1} мм}" FontWeight="Bold" VerticalAlignment="Center" Width="60"/>
                                                <TextBlock Text="{Binding X, StringFormat=X: {0:0}}" Foreground="DimGray" VerticalAlignment="Center" Width="70"/>
                                                <TextBlock Text="{Binding Y, StringFormat=Y: {0:0}}" Foreground="DimGray" VerticalAlignment="Center" Width="70"/>
                                                <Button Content="×" Foreground="Red" Cursor="Hand" CommandParameter="{Binding}" Click="RemovePlacedHole_Click" Margin="10,0,0,0" Padding="5,0" Background="Transparent" BorderThickness="0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 5. Блок отверстий (стандартный) -->
                <Border BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="10" Background="{DynamicResource RegionBrush}"
                        Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,Triangle,Round,RectangularTube,RoundTube,Angle,Channel,IBeam'}">
                    <Expander Header="Отверстия (необязательно)" IsExpanded="False">
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="⌀" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBox x:Name="DiameterInput" Text="10" Width="60" Style="{StaticResource TextBoxExtend}" Margin="0,0,10,0"/>
                                <TextBlock Text="мм" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TextBlock Text="Кол-во:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="CountInput" Text="1" Width="60" Style="{StaticResource TextBoxExtend}" Margin="0,0,10,0"/>
                                <TextBlock Text="шт" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <Button Content="Добавить" Click="AddHoleGroup_Click" Style="{StaticResource ButtonDashedPrimary}" Padding="10,4"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                <ItemsControl ItemsSource="{Binding HoleGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="3" Margin="0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Diameter, StringFormat=⌀{0:F1} мм}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" × " VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" шт" VerticalAlignment="Center"/>
                                                    <Button Content="×" Foreground="Red" Cursor="Hand" Click="RemoveHoleGroup_Click" Tag="{Binding}" Margin="10,0,0,0" Padding="5,0" Background="Transparent" BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 6. Кнопка добавления -->
                <Button Content="Добавить в список" Click="AddToBatch_Click" Margin="0,0,0,10" Height="45" Style="{StaticResource ButtonPrimary}" FontSize="14"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ПРАВАЯ КОЛОНКА: Список деталей -->
        <Border Grid.Column="1" Grid.Row="0" BorderBrush="{DynamicResource SecondaryTextBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Background="{DynamicResource RegionBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Список деталей" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BatchItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,5" Padding="5" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding PartType, Converter={StaticResource PartTypeToLocalizedNameConverter}}" FontStyle="Italic" Foreground="DimGray" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Width, StringFormat={}{0:0}×}" Foreground="DimGray" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,Triangle,Custom,RectangularTube,Angle,Channel,IBeam'}"/>
                                                    <TextBlock Text="{Binding Height, StringFormat={}{0:0}}" Foreground="DimGray" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,Triangle,Custom,RectangularTube,Angle,Channel,IBeam'}"/>
                                                    <TextBlock Text="{Binding Width, StringFormat=Ø{0:0}}" Foreground="DimGray" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,RoundTube,Circle'}"/>
                                                    <TextBlock Text="{Binding Height, StringFormat=■{0:0}}" Foreground="DimGray" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='SquareBar'}"/>
                                                    <TextBlock Text="{Binding Length, StringFormat={}\ L{0:0}}" Foreground="DimGray" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='RoundTube,RectangularTube,Angle,Channel,IBeam,Circle,SquareBar'}"/>

                                                    <Expander Margin="10,0,0,0" Visibility="{Binding HoleGroups.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter='0'}" Width="100" VerticalAlignment="Center">
                                                        <Expander.Header>
                                                            <TextBlock Text="с отв" FontWeight="Bold" FontSize="11" Foreground="#007ACC"/>
                                                        </Expander.Header>
                                                        <StackPanel Margin="5,0,0,5">
                                                            <ItemsControl ItemsSource="{Binding HoleGroups}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                            <TextBlock Text="⌀" FontWeight="Bold" Foreground="DimGray"/>
                                                                            <TextBlock Text="{Binding Diameter, StringFormat={}{0:F1}}" FontWeight="Bold" Margin="2,0"/>
                                                                            <TextBlock Text="мм × " Foreground="DimGray"/>
                                                                            <TextBlock Text="{Binding Count}" FontWeight="Bold"/>
                                                                            <TextBlock Text=" шт." Foreground="DimGray"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count, StringFormat={}{0} шт}" Foreground="Blue" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <Button Content="🗑" ToolTip="Удалить" Click="RemoveFromBatch_Click" Tag="{Binding}" Padding="5,0" Background="Transparent" BorderThickness="0" Foreground="Tomato" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <!-- 🔥 НАСТРОЙКИ ДЛЯ ЛИСТОВЫХ ДЕТАЛЕЙ -->
                    <StackPanel Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,Round,Triangle,Custom'}">
                        <ToggleButton x:Name="AutoNestingCheck" Content="Автоподбор листов" Style="{StaticResource ToggleButtonSwitch.Small}" IsChecked="True" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="Отступы" VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
                            <TextBox x:Name="SpacingInput" Style="{StaticResource TextBoxExtend}" hc:InfoElement.Placeholder="0 = авто" Width="80" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 🔥 НАСТРОЙКИ ДЛЯ ТРУБНЫХ ДЕТАЛЕЙ -->
                    <StackPanel Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='RoundTube,RectangularTube,Angle,Channel,IBeam,Circle,SquareBar'}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="Зажим (мм)" VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
                            <TextBox x:Name="ClampZoneInput" Text="340" Style="{StaticResource TextBoxExtend}" Width="80" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <TextBlock Text="Пропил (мм)" VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
                            <TextBox x:Name="CutLossInput" Text="10" Style="{StaticResource TextBoxExtend}" Width="80" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Завершить и рассчитать" Click="FinishBatch_Click" Margin="0,0,0,10" Height="40" Style="{StaticResource ButtonSuccess}" FontSize="14"/>
                    <Button Content="Отмена" Height="40" Style="{StaticResource ButtonDashed}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>