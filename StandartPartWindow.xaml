<Window x:Class="Metal_Code.StandartPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        mc:Ignorable="d"
        Title="Стандартные детали" Topmost="True" WindowStartupLocation="CenterScreen" Width="900" Height="600">
    <Window.Resources>
        <converters:PartTypeToVisibilityConverter x:Key="PartTypeToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:PartTypeToLocalizedNameConverter x:Key="PartTypeToLocalizedNameConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <!-- Левая панель: Ввод -->
            <ColumnDefinition/>
            <!-- Правая панель: Список -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: Ввод данных -->
        <StackPanel>

            <!-- 1. Карточка параметров детали -->
            <Border BorderBrush="{DynamicResource SecondaryTextBrush}" 
                             BorderThickness="1" CornerRadius="4" 
                             Margin="10" Background="{DynamicResource RegionBrush}">
                <DockPanel Margin="10">
                    <TextBlock Text="Параметры детали" FontSize="14" FontWeight="Bold"
                               Margin="0,0,0,15" DockPanel.Dock="Top"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>

                    <StackPanel DockPanel.Dock="Right">
                        <!-- Выбор формы -->
                        <StackPanel Orientation="Horizontal" Margin="10,5"
                                Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle'}" HorizontalAlignment="Right">
                            <TextBlock Text="Форма:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                            <RadioButton x:Name="RectangleRadio" Content="Прямоугольник" Tag="Rectangle" Checked="OnShapeTypeChanged"/>
                            <RadioButton Content="Круг" Tag="Round" Margin="10,0,0,0" Checked="OnShapeTypeChanged"/>
                        </StackPanel>

                        <!-- Визуализация -->
                        <Viewbox Width="100" Height="100" Margin="10">
                            <Path Data="{Binding DisplayGeometry}" Stroke="Black" StrokeThickness="{Binding VisualStrokeThickness}" Stretch="Fill"/>
                        </Viewbox>
                    </StackPanel>

                    <!-- Сетка ввода размеров -->
                    <UniformGrid Rows="5" Columns="2" HorizontalAlignment="Left">
                        <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                        <TextBox Text="{Binding Title}" hc:InfoElement.Placeholder="Например: Пластина" 
                                 Style="{StaticResource TextBoxExtend}" Margin="0,0,0,5"/>

                        <TextBlock Text="Ширина (мм):" VerticalAlignment="Center" Margin="0,0,10,5"
                                   Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle'}"/>
                        <TextBox Text="{Binding Width}" hc:InfoElement.Placeholder="50" 
                                 Style="{StaticResource TextBoxExtend}" Margin="0,0,0,5"
                                 Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle'}"/>

                        <TextBlock Text="Высота (мм):" VerticalAlignment="Center" Margin="0,0,10,5"
                                   Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle'}"/>
                        <TextBox Text="{Binding Height}" hc:InfoElement.Placeholder="50" 
                                 Style="{StaticResource TextBoxExtend}" Margin="0,0,0,5"
                                 Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle'}"/>

                        <TextBlock Text="Длина (мм):" VerticalAlignment="Center" Margin="0,0,10,5"
                                   Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter},
                                    ConverterParameter='RoundTube,RectangularTube,Angle,Channel,IBeam'}"/>
                        <TextBox Text="{Binding Length}" hc:InfoElement.Placeholder="1000" 
                                 Style="{StaticResource TextBoxExtend}" Margin="0,0,0,5"
                                 Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter},
                                    ConverterParameter='RoundTube,RectangularTube,Angle,Channel,IBeam'}"/>

                        <TextBlock Text="Количество (шт):" VerticalAlignment="Center" Margin="0,0,10,5" Grid.ColumnSpan="2"/>
                        <TextBox Text="{Binding Count}" hc:InfoElement.Placeholder="1" 
                                 Style="{StaticResource TextBoxExtend}"/>
                    </UniformGrid>
                </DockPanel>
            </Border>

            <!-- 2. Блок отверстий -->
            <Border BorderBrush="{DynamicResource SecondaryTextBrush}" 
                             BorderThickness="1" CornerRadius="4" 
                             Margin="10" Padding="5" Background="{DynamicResource RegionBrush}">
                <Expander Header="Отверстия (необязательно)" IsExpanded="False" 
                          Foreground="{DynamicResource SecondaryTextBrush}">
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="⌀" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                            <TextBox x:Name="DiameterInput" Text="10" Width="60" Style="{StaticResource TextBoxExtend}" Margin="0,0,10,0"/>
                            <TextBlock Text="мм" VerticalAlignment="Center" Margin="0,0,20,0"/>

                            <TextBlock Text="Кол-во:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="CountInput" Text="1" Width="60" Style="{StaticResource TextBoxExtend}" Margin="0,0,10,0"/>
                            <TextBlock Text="шт" VerticalAlignment="Center"/>

                            <Button Content="Отверстия" Click="AddHoleGroup_Click" 
                                    hc:IconElement.Geometry="{StaticResource AddGeometry}" 
                                    Margin="20,0,0,0" Style="{StaticResource ButtonDashedPrimary}" 
                                    hc:IconElement.Width="16" hc:IconElement.Height="16"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120" Margin="0,5,0,0">
                            <ItemsControl ItemsSource="{Binding HoleGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="3" Margin="0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Diameter, StringFormat=⌀{0:F1} мм}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Text=" × " VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Text=" шт" VerticalAlignment="Center"/>
                                                <Button Content="×" Foreground="Red" Cursor="Hand"
                                                        Click="RemoveHoleGroup_Click" Tag="{Binding}"
                                                        Margin="10,0,0,0" Padding="5,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Style="{StaticResource ButtonDefault}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- 3. Кнопка "Добавить" (Прижата к низу левой колонки) -->
            <Button Content="Добавить в список"
                    Click="AddToBatch_Click" Margin="0,0,0,5" Height="40"
                    Style="{StaticResource ButtonPrimary}" FontSize="14"/>
        </StackPanel>

        <!-- ПРАВАЯ КОЛОНКА: Список деталей -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource SecondaryTextBrush}"
                BorderThickness="1" CornerRadius="4"
                Margin="10" Padding="10" Background="{DynamicResource RegionBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Список добавленных деталей" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,15"/>
                
                <!-- Список -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" Background="{DynamicResource RegionBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="BatchItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Margin="0,5" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Левая часть: Информация о детали -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Правая часть: Количество и действия -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ЛЕВАЯ КОЛОНКА: Детали -->
                                            <StackPanel Margin="5">
                                                <!-- Наименование детали -->
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" MaxWidth="200" TextTrimming="CharacterEllipsis"/>

                                                <!-- Тип, Размеры и Expander -->
                                                <StackPanel Orientation="Horizontal" Margin="5">
                                                    <!-- Тип детали -->
                                                    <TextBlock Text="{Binding PartType, Converter={StaticResource PartTypeToLocalizedNameConverter}}" FontStyle="Italic"
                                                           Foreground="DimGray" Margin="0,0,6,0"/>
                                                    <!-- Размеры -->
                                                    <TextBlock Text="{Binding Width, StringFormat={}{0:0}×}" Foreground="DimGray"
                                       Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,RectangularTube'}"/>
                                                    <TextBlock Text="{Binding Height, StringFormat={}{0:0}}" Foreground="DimGray"
                                       Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,RectangularTube'}"/>
                                                    <TextBlock Text="{Binding Width, StringFormat=Ø{0:0}}" Foreground="DimGray"
                                       Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,RoundTube'}"/>
                                                    <TextBlock Text="{Binding Length, StringFormat=', {0:0}мм'}" Foreground="DimGray"
                                       Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='RoundTube,RectangularTube'}"/>

                                                    <!-- Expander с отверстиями (только если Count > 0) -->
                                                    <Expander Margin="10,0,0,0"
                                                          Visibility="{Binding HoleGroups.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter='0'}" Width="100" VerticalAlignment="Center">
                                                        <Expander.Header>
                                                            <TextBlock Text="с отв" FontWeight="Bold" FontSize="11" Foreground="#007ACC"/>
                                                        </Expander.Header>

                                                        <!-- Список отверстий внутри -->
                                                        <StackPanel Margin="5,0,0,5">
                                                            <ItemsControl ItemsSource="{Binding HoleGroups}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                            <TextBlock Text="⌀" FontWeight="Bold" Foreground="DimGray"/>
                                                                            <TextBlock Text="{Binding Diameter, StringFormat={}{0:F1}}" FontWeight="Bold" Margin="2,0"/>
                                                                            <TextBlock Text="мм × " Foreground="DimGray"/>
                                                                            <TextBlock Text="{Binding Count}" FontWeight="Bold"/>
                                                                            <TextBlock Text=" шт." Foreground="DimGray"/>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <!-- ПРАВАЯ КОЛОНКА: Количество и Удаление -->
                                            <StackPanel Grid.Column="1" Margin="10,5">
                                                <TextBlock Text="{Binding Count, StringFormat={}{0} шт}"
                                                           Foreground="Blue" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Content="🗑" ToolTip="Удалить"
                                                        Click="RemoveFromBatch_Click" Tag="{Binding}"
                                                        Margin="0,2,0,0" Padding="5,0" 
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="Tomato"
                                                        HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Кнопки управления (Внизу правой колонки) -->
                <StackPanel Grid.Row="2" Margin="15">
                    <ToggleButton x:Name="AutoNestingCheck" Content="Автоподбор листов"
                                  Style="{StaticResource ToggleButtonSwitch.Small}" IsChecked="True" Margin="0,0,0,10"
                                  ToolTip="Если включено, алгоритм сам выберет оптимальный размер листа. Если выключено, используется фиксированный размер." 
                                  HorizontalAlignment="Center"/>

                    <!-- 🔥 НОВОЕ: Поле для ввода отступа -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <TextBlock Text="Отступы" VerticalAlignment="Center" Margin="5,0" 
                                   FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox x:Name="SpacingInput" 
                                 Style="{StaticResource TextBoxExtend}" 
                                 hc:InfoElement.Placeholder="0 = авто"
                                 TextAlignment="Center" VerticalContentAlignment="Center"/>
                        <!-- Опционально: защита от букв -->
                        <TextBlock Text="(0 = авто)" VerticalAlignment="Center" Margin="5,0" 
                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <Button Content="Завершить и рассчитать"
                            Click="FinishBatch_Click"
                            IsDefault="True"
                            Margin="0,0,0,10" Height="40"
                            Style="{StaticResource ButtonSuccess}" FontSize="14"/>

                    <Button Content="Отмена"
                            IsCancel="True"
                            Height="40"
                            Style="{StaticResource ButtonDashed}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>