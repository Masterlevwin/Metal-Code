<Window x:Class="Metal_Code.StandartPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"      
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        mc:Ignorable="d"
        Title="Стандартные детали" Topmost="True" ResizeMode="NoResize" 
        Icon="/app_logo.jpeg" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:PartTypeToVisibilityConverter x:Key="PartTypeToVisibilityConverter"/>
    </Window.Resources>

    <StackPanel>
        <!-- Панель буфера добавленных деталей -->
        <GroupBox Header="Добавленные детали" Margin="10" Padding="5">
            <StackPanel>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,0,0,5">
                    <ItemsControl x:Name="BatchItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5" Margin="0,2,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Тип и размеры -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding PartType}" FontStyle="Italic" Foreground="Gray" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Width, StringFormat={}{0:0}×}" 
               Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,RectangularTube'}"/>
                                            <TextBlock Text="{Binding Height, StringFormat={}{0:0}}" 
               Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Rectangle,RectangularTube'}"/>
                                            <TextBlock Text="{Binding Width, StringFormat=Ø{0:0}}" 
               Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,RoundTube'}"/>
                                            <TextBlock Text="{Binding Length, StringFormat={}{0:0}мм}" 
               Margin="5,0,0,0"
               Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='RoundTube,RectangularTube'}"/>
                                        </StackPanel>
                                        <!-- Количество -->
                                        <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat=× {0} шт}" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="DarkGreen" FontWeight="Bold"/>

                                        <!-- Кнопка удаления -->
                                        <Button Grid.Column="2" Content="Удалить" Padding="8,2" Margin="5,0,0,0"
                                                Click="RemoveFromBatch_Click" Tag="{Binding}"
                                                Background="LightCoral" Foreground="White" BorderThickness="0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </GroupBox>

        <GroupBox Margin="10" HorizontalAlignment="Center">
            <GroupBox.Header>
                <TextBlock Text="Новая деталь" FontSize="14" FontWeight="Bold"/>
            </GroupBox.Header>

            <DockPanel LastChildFill="True" Margin="5">

                <!-- Секция выбора типа детали (только для листа) -->
                <GroupBox Header="Тип детали" DockPanel.Dock="Top" Margin="5"
                          Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle'}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RectangleRadio" Content="Прямоугольник" Tag="Rectangle"
                                     Checked="OnShapeTypeChanged" Margin="0,0,15,0"/>
                        <RadioButton x:Name="RoundRadio" Content="Круг"
                                     Checked="OnShapeTypeChanged" Tag="Round"/>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" MinHeight="30" Margin="10" HorizontalAlignment="Center">
                    <Button Content="Добавить в список" Click="AddToBatch_Click" Padding="10,5" Margin="0,0,10,0"/>
                    <Button Content="Завершить и рассчитать" Click="FinishBatch_Click" IsDefault="True" 
            Padding="10,5" Background="LightGreen" Margin="0,0,10,0"/>
                    <Button Content="Отмена" IsCancel="True" Padding="10,5"/>
                </StackPanel>
                
                <!-- Секция отверстий -->
                <GroupBox Header="Отверстия" DockPanel.Dock="Bottom" Margin="5" Padding="5">
                    <StackPanel>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10" 
                                CornerRadius="3" Background="#F9F9F9">
                            <StackPanel>
                                <TextBlock Text="Новая группа отверстий:" FontWeight="Bold" Margin="0,0,0,5"/>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                    <TextBlock Text="Диаметр" MinWidth="80" VerticalAlignment="Center"/>
                                    <TextBox x:Name="DiameterInput" Text="10" MinWidth="50" MaxWidth="50" 
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="мм" Margin="5,0,20,0" VerticalAlignment="Center"/>

                                    <TextBlock Text="Количество" MinWidth="80" VerticalAlignment="Center"/>
                                    <TextBox x:Name="CountInput" Text="1" MinWidth="50" MaxWidth="50" 
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="шт" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Content="+ Добавить группу" Click="AddHoleGroup_Click" 
                                        HorizontalAlignment="Left" Margin="0,5,0,0" Padding="10,3"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding HoleGroups}" Margin="0,5,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5" Margin="0,2,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⌀" VerticalAlignment="Center" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Diameter, StringFormat={}{0:F1}}" 
                                                       VerticalAlignment="Center" MinWidth="30"/>
                                            <TextBlock Text="мм ×" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                            <TextBlock Text="{Binding Count}" VerticalAlignment="Center" MinWidth="20" FontWeight="Bold"/>
                                            <TextBlock Text="шт" VerticalAlignment="Center" Margin="5,0,0,0"/>

                                            <Button Content="×" Margin="15,0,0,0" Padding="8,2" 
                                                    Click="RemoveHoleGroup_Click" Tag="{Binding}"
                                                    ToolTip="Удалить группу"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,10,0,0">
                            <Border BorderBrush="DarkGray" BorderThickness="1" Padding="8" CornerRadius="3" 
                                    Background="#F0F8FF">
                                <StackPanel>
                                    <TextBlock Text="Статистика:" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="HoleStatsText" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <Viewbox x:Name="GeometryViewbox" Stretch="Uniform" Height="100" Width="100" Margin="5">
                    <Path Data="{Binding DisplayGeometry}" Stroke="Black" StrokeThickness="{Binding VisualStrokeThickness}" Stretch="Fill"/>
                </Viewbox>

                <StackPanel Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Название" MinWidth="80" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Title}" Margin="10,0,0,0" MinWidth="150" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="5" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle'}">
                        <TextBlock Text="Высота" MinWidth="80" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Width}" Margin="10,0,0,0" MinWidth="50" MaxWidth="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="мм" Margin="10,0,0,0" MinWidth="20" TextAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='Round,Rectangle'}">
                        <TextBlock Text="Ширина" MinWidth="80" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Height}" Margin="10,0,0,0" MinWidth="50" MaxWidth="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="мм" Margin="10,0,0,0" MinWidth="20" TextAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5" Visibility="{Binding PartType, Converter={StaticResource PartTypeToVisibilityConverter}, ConverterParameter='RoundTube,RectangularTube'}">
                        <TextBlock Text="Длина" MinWidth="80" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Length}" Margin="10,0,0,0" MinWidth="50" MaxWidth="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="мм" Margin="10,0,0,0" MinWidth="20" TextAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Количество" MinWidth="80" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Count}" Margin="10,0,0,0" MinWidth="50" MaxWidth="50" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="шт" Margin="10,0,0,0" MinWidth="20" TextAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </GroupBox>
    </StackPanel>
</Window>