<Window x:Class="Metal_Code.UpdateWindow"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История обновлений" Topmost="True" WindowStartupLocation="CenterScreen">
    
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок окна -->
                <RowDefinition Height="*"/>
                <!-- Контент (список изменений) -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопка закрытия -->
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <TextBlock Grid.Row="0" Text="Что нового в этой версии?" 
                       FontSize="18" FontWeight="SemiBold" Foreground="DarkSlateGray" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- ScrollViewer для прокрутки контента -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <!-- ItemsControl для отображения списка изменений -->
                <ItemsControl x:Name="ChangesListItemsControl" Margin="10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,30">
                            <!-- Заголовок версии (если нужно) -->
                            <TextBlock Text="{Binding VersionTitle}" FontSize="16" 
                                           FontWeight="Bold" Foreground="SteelBlue"/>

                            <!-- Описание изменения -->
                            <TextBlock Text="{Binding Description}" FontSize="14" 
                                           Foreground="Black" TextWrapping="Wrap" Margin="0,5,0,10"/>

                            <!-- Изображение (скриншот) -->
                            <Image Source="{Binding ScreenshotPath}" Stretch="Uniform" Margin="0,5,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <!-- Кнопка закрытия -->
        <Button Grid.Row="2" Content="Понятно" HorizontalAlignment="Center" Margin="0,20,0,0" BorderBrush="#FF00C800"
                    Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" Click="CloseButton_Click"/>
        </Grid>
</Window>