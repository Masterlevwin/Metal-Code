<Window x:Class="Metal_Code.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="История обновлений" Height="600" Width="800" WindowStartupLocation="CenterScreen" Topmost="True">
    
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок окна -->
                <RowDefinition Height="*"/>
                <!-- Контент (список изменений) -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопка закрытия -->
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <TextBlock Grid.Row="0" 
                       Text="Что нового в этой версии?" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Foreground="DarkSlateGray" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- ScrollViewer для прокрутки контента -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <!-- ItemsControl для отображения списка изменений -->
                <ItemsControl x:Name="ChangesListItemsControl" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,30">
                                <!-- Отступ между элементами -->

                                <!-- Заголовок версии (если нужно) -->
                                <TextBlock Text="{Binding VersionTitle}" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="SteelBlue"/>

                                <!-- Описание изменения -->
                                <TextBlock Text="{Binding Description}" 
                                           FontSize="14" 
                                           Foreground="Black" 
                                           TextWrapping="Wrap" 
                                           Margin="0,5,0,10"/>

                                <!-- Изображение (скриншот) -->
                                <Image Source="{Binding ScreenshotPath}" 
                                       MaxWidth="600" 
                                       MaxHeight="400" 
                                       Stretch="Uniform" 
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Left"/>
                                <!-- Converter - нужен для скрытия Image, если путь пустой -->
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Кнопка закрытия -->
            <Button Grid.Row="2" 
                    Content="Понятно" 
                    Width="100" 
                    Height="35" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0"
                    Click="CloseButton_Click"/>

        </Grid>
</Window>