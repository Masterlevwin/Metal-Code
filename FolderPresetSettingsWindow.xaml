<Window x:Class="Metal_Code.FolderPresetSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Управление шаблонами папок" 
        Width="350" Height="400"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="PresetsList" ItemsSource="{Binding Presets}" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                         hc:InfoElement.Placeholder="Название папки" 
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                                        Click="RemovePreset_Click" Style="{StaticResource ButtonDanger.Small}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить" Click="AddPreset_Click" Margin="0,0,8,0" MinWidth="80" Style="{StaticResource ButtonSuccess}"/>
            <Button Content="Сбросить" Click="Reset_Click" Margin="0,0,8,0" Style="{StaticResource ButtonWarning}"/>
            <Button Content="OK" IsDefault="True" Click="SaveAndClose_Click" Width="80" Style="{StaticResource ButtonPrimary}"/>
        </StackPanel>
    </Grid>
</Window>