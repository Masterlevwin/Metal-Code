<Window x:Class="Metal_Code.BendTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        Title="Справочник гибки листового металла"
        Height="720" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource RegionBrush}">

    <Window.Resources>
        <converters:AllowedBorderConverter x:Key="AllowedBorderConverter"/>

        <Style x:Key="CenteredCellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для ячеек с усилиями: центрирование + обводка допустимости -->
        <Style x:Key="ForceCellStyle" TargetType="DataGridCell">
            <!-- Текст по центру внутри ячейки -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Обводка -->
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource AllowedBorderConverter}">
                        <Binding Path="Content.Text" RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="BendLength" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Заголовок и выбор материала ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryRegionBrush}"
                CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Таблица гибов"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Строки — толщина металла (мм). Столбцы — раскрытие матрицы V (мм). Значения — тонны на 1 метр гиба."
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Материал:" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="MaterialComboBox" Width="260"
                              Style="{StaticResource ComboBoxExtend}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectionChanged="MaterialComboBox_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Таблица матриц ═══ -->
        <DataGrid Grid.Row="1" x:Name="BendDataGrid"
                  Style="{StaticResource DataGrid.Small}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  ColumnHeaderHeight="60"
                  SelectionUnit="Cell"
                  SelectionMode="Single"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  CurrentCellChanged="BendDataGrid_CurrentCellChanged"/>

        <!-- ═══ Калькулятор реальной длины гиба ═══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryRegionBrush}"
                CornerRadius="4" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Длина гиба, мм:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <hc:NumericUpDown x:Name="BendLengthInput"
                                          Width="110"
                                          Value="1000"
                                          Minimum="1"
                                          Maximum="3000"
                                          Increment="10"
                                          VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Margin="20,0" Padding="10,4"
                            Background="{DynamicResource RegionBrush}" CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Усилие:" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CalculatedForceText" Text="—"
                                       FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock x:Name="CanBendText" Text=""
                                       Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="2"
                               Text="Кликните по ячейке таблицы для расчёта"
                               FontSize="11" FontStyle="Italic"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="MatrixInfoText"
                           Text="Выберите ячейку, чтобы увидеть параметры матрицы и расчётное усилие."
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ═══ Формула и пояснения ═══ -->
        <Border Grid.Row="3"
                Background="{DynamicResource SecondaryRegionBrush}"
                CornerRadius="4" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Формула расчёта усилия:" FontWeight="SemiBold"
                               FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock FontFamily="Consolas" FontSize="11"
                               Foreground="{DynamicResource PrimaryBrush}">
                        <Run Text="F = 1.33 × "/>
                        <Run x:Name="SigmaRun" Text="450" FontWeight="Bold"/>
                        <Run Text=" × S² × L / V"/>
                    </TextBlock>
                    <TextBlock x:Name="FormulaDescriptionText"
                               FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="24,0">
                    <TextBlock Text="Минимальная полка:" FontWeight="SemiBold"
                               FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock FontSize="11" TextWrapping="Wrap">
                        <Run Text="Зависит от раскрытия матрицы V."/>
                        <LineBreak/>
                        <Run Text="Справочно: ≈ 0,7 × V."/>
                        <LineBreak/>
                        <Run Text="Точное значение — при выборе ячейки."/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="24,0,0,0">
                    <TextBlock Text="Обозначения:" FontWeight="SemiBold"
                               FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock FontSize="11">
                        <Run Text="Пустая ячейка" FontWeight="SemiBold"/>
                        <Run Text=" — гибка недопустима"/>
                        <LineBreak/>
                        <Run Text="т/м" FontWeight="SemiBold"/>
                        <Run Text=" — тонны на метр гиба"/>
                        <LineBreak/>
                        <Run Text="✓" FontWeight="SemiBold"/>
                        <Run Text=" — усилие в пределах станка"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>