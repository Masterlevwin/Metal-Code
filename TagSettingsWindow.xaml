<Window x:Class="Metal_Code.TagSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"         
        xmlns:local="clr-namespace:Metal_Code"
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        Title="Настройка тэгов" 
        Width="500" Height="450"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="CanResize"
        MinWidth="400" MinHeight="350">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Настройте кнопки быстрого добавления комментариев"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Foreground="#666"/>

        <!-- Список тэгов -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <ListBox x:Name="TagsList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Название и текст тега -->
                            <StackPanel Grid.Column="0">
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             FontWeight="Bold" Margin="0,0,5,5" Width="200"
                             ToolTip="Название тега"/>
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Текст, добавляемый в комментарий" Width="300" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <!-- Кнопка удаления и чекбокс папки -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <CheckBox IsChecked="{Binding CreatesFolder}" ToolTip="Создавать папку" Margin="0,0,10,0"/>
                                <Button Content="❌" Click="RemoveTag_Click" ToolTip="Удалить тэг"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Добавить тэг" 
                    Click="AddTag_Click" 
                    Margin="0,0,8,0" 
                    MinWidth="100"
                    Style="{StaticResource ButtonSuccess}"/>
            <Button Content="Сбросить к стандартным" 
                    Click="ResetDefaults_Click" 
                    Margin="0,0,8,0"
                    MinWidth="140"
                    Style="{StaticResource ButtonWarning}"/>
            <Button Content="OK" 
                    IsDefault="True" 
                    Click="DialogOk" 
                    Width="80"
                    Style="{StaticResource ButtonPrimary}"/>
            <Button Content="Отмена" 
                    IsCancel="True" 
                    Margin="8,0,0,0" 
                    Width="80"/>
        </StackPanel>
    </Grid>
</Window>