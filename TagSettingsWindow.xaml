<Window x:Class="Metal_Code.TagSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Настройка тэгов" 
        Width="500" Height="450"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="CanResize"
        MinWidth="400" MinHeight="350">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Настройте кнопки быстрого добавления комментариев"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Foreground="#666"/>

        <!-- Список тэгов -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <ListBox x:Name="TagsList" 
                     BorderThickness="0"
                     ItemsSource="{Binding Tags}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#D1D9E0" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="10" 
                                Margin="0,0,0,6"
                                Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,10,0">
                                    <!-- Название кнопки -->
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                             hc:InfoElement.Placeholder="Название кнопки (например: азот)"
                                             MaxLength="30"
                                             Margin="0,0,0,6"/>

                                    <!-- Текст в комментарий -->
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" 
                                             hc:InfoElement.Placeholder="Текст, добавляемый в комментарий"
                                             MaxLength="100"/>

                                    <!-- 👇 Создание папки -->
                                    <CheckBox Content="Создавать папку при сохранении"
                                              IsChecked="{Binding CreatesFolder}"
                                              Margin="0,8,0,0"
                                              Foreground="#2E7D32"
                                              FontWeight="SemiBold">
                                        <CheckBox.ToolTip>
                                            <TextBlock Text="При сохранении расчета будет создана папка с этим названием"/>
                                        </CheckBox.ToolTip>
                                    </CheckBox>
                                </StackPanel>

                                <!-- Кнопка удаления -->
                                <Button Grid.Column="1" 
                                        Content="✕" 
                                        Width="28" Height="28"
                                        Click="RemoveTag_Click" 
                                        Padding="0"
                                        VerticalAlignment="Top"
                                        ToolTip="Удалить тэг"
                                        Style="{StaticResource ButtonDanger.Small}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Добавить тэг" 
                    Click="AddTag_Click" 
                    Margin="0,0,8,0" 
                    MinWidth="100"
                    Style="{StaticResource ButtonSuccess}"/>
            <Button Content="Сбросить к стандартным" 
                    Click="ResetDefaults_Click" 
                    Margin="0,0,8,0"
                    MinWidth="140"
                    Style="{StaticResource ButtonWarning}"/>
            <Button Content="OK" 
                    IsDefault="True" 
                    Click="DialogOk" 
                    Width="80"
                    Style="{StaticResource ButtonPrimary}"/>
            <Button Content="Отмена" 
                    IsCancel="True" 
                    Margin="8,0,0,0" 
                    Width="80"/>
        </StackPanel>
    </Grid>
</Window>