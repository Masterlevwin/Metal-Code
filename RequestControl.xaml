<UserControl x:Class="Metal_Code.RequestControl"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Metal_Code"
             mc:Ignorable="d" Loaded="RequestControl_Loaded">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:TitleLengthToForegroundConverter x:Key="TitleLengthToForegroundConverter"/>

        <!-- Единый стиль для всех ToolTip -->
        <Style x:Key="InfoToolTipStyle" TargetType="ToolTip">
            <Setter Property="Placement" Value="Mouse"/>
            <Setter Property="Background" Value="#FFF8F0"/>
            <Setter Property="BorderBrush" Value="#CC3300"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="MaxWidth" Value="280"/>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <GroupBox DockPanel.Dock="Top" Style="{StaticResource GroupBox.Small}" Visibility="{Binding IsRequest, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}" MaxHeight="150">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Режим заявки" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Button HorizontalAlignment="Left" Click="Load_Models" Margin="20,5,5,5">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/model.png"/>
                            <TextBlock Text="Добавить DXF / IGS / XLSX" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button DataContext="{Binding ProductModel, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}" Command="{Binding LoadCommand}" HorizontalAlignment="Center" Margin="20,5,5,5">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Images/xlsx_load.png"/>
                            <TextBlock Text="Загрузить раскладки" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Click="Close_RequestControl" Margin="20,5,5,5">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/close.png"/>
                            <TextBlock Text="Закрыть" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </GroupBox.Header>

            <ListView x:Name="PathsList" Style="{StaticResource ListView.Small}" Margin="5"/>
        </GroupBox>

        <DockPanel DockPanel.Dock="Bottom">

            <Button ToolTip="Сохранить заявку в формате Excel" Click="Create_Request" HorizontalAlignment="Center" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <Image Source="Images/comment.png"/>
                    <TextBlock Text="Сохранить заявку" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <Button IsEnabled="{Binding IsAvailable}" Click="Create_ExpressOffer" HorizontalAlignment="Center" Margin="5">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/open3.png"/>
                    <TextBlock Text="Доступен предварительный расчет"
                               Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <Button ToolTip="Сохранить заявку в формате Excel и создать рабочие папки" 
        Click="Launch_Tech" Margin="5"
        Style="{StaticResource ButtonPrimary}" 
        HorizontalAlignment="Right" Padding="4,2">
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" 
                CornerRadius="6"
                            Padding="3"
                VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.2"/>
                        </Border.Effect>
                        <Image Source="Images/comment.png"/>
                    </Border>
                    <TextBlock Text="Сохранить и создать папки" 
                   Margin="5,0" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>
                    <Border Background="White" 
                CornerRadius="6"
                            Padding="3"
                VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.2"/>
                        </Border.Effect>
                        <Image Source="Images/complect.png"/>
                    </Border>
                </StackPanel>
            </Button>

        </DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">

            <GroupBox DataContext="{Binding CurrentTemplate}" Style="{StaticResource GroupBox.Small}" Margin="5">
                <GroupBox.Header>
                    <TextBlock Text="Определите шаблон распознавания" FontWeight="Bold"/>
                </GroupBox.Header>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Толщина" MinWidth="70" MaxWidth="70" VerticalAlignment="Center" FontWeight="Medium"/>
                        <TextBox Text="{Binding DestinyPattern}" MinWidth="50" Margin="20,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxWidth="50"/>
                        <RadioButton x:Name="BeforeDestiny" IsChecked="{Binding PosDestiny}" Content="до" Margin="20,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="DestinyGroup" Padding="3"/>
                        <TextBlock Text="[толщ]" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="50" MaxWidth="50"/>
                        <RadioButton x:Name="AfterDestiny" Content="после" Margin="10,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="DestinyGroup" Padding="3"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Количество" MinWidth="70" MaxWidth="70" VerticalAlignment="Center" FontWeight="Medium"/>
                        <TextBox Text="{Binding CountPattern}" MinWidth="50" Margin="20,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxWidth="50"/>
                        <RadioButton x:Name="BeforeCount" IsChecked="{Binding PosCount}" Content="до" Margin="20,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="CountGroup" Padding="3"/>
                        <TextBlock Text="[кол]" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="50" MaxWidth="50"/>
                        <RadioButton x:Name="AfterCount" Content="после" Margin="10,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" GroupName="CountGroup" Padding="3"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Имя шаблона" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Medium"/>
                        <StackPanel x:Name="TemplateNameStack" Orientation="Horizontal" Background="White" Margin="20,0,0,0">
                            <TextBlock Text="{Binding DestinyPattern}" Margin="5,0,5,0" Foreground="Blue" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibilityConverter}, ElementName=BeforeDestiny}"/>
                            <TextBlock Text="[толщ]" Margin="5,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DestinyPattern}" Margin="5,0,5,0" Foreground="Blue" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibilityConverter}, ElementName=AfterDestiny}"/>
                            <TextBlock Text="{Binding CountPattern}" Margin="10,0,5,0" Foreground="Blue" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibilityConverter}, ElementName=BeforeCount}"/>
                            <TextBlock Text="[кол]" Margin="5,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CountPattern}" Margin="5,0,5,0" Foreground="Blue" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisibilityConverter}, ElementName=AfterCount}"/>
                        </StackPanel>
                        <Button Content="Сохранить шаблон" Click="Save_Template" Margin="20,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Style="{StaticResource GroupBox.Small}" Margin="5">
                <GroupBox.Header>
                    <TextBlock Text="Выберите шаблон из списка и запустите анализ" FontWeight="Bold"/>
                </GroupBox.Header>

                <StackPanel Orientation="Horizontal" Margin="5">
                    <ListBox x:Name="TemplatesList" Margin="5" Padding="2" MinWidth="150" KeyDown="Remove_Template" ToolTip="Клавиша Del - удалить шаблон">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Margin="5" VerticalAlignment="Center">
                        <Button Margin="5" Click="Analyze_Paths" Style="{StaticResource ButtonInfo}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Запустить анализ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                            <Button Content="Генерация" Click="Rename_Details"/>
                            <Image Source="/Images/question.png" Width="16">
                                <Image.ToolTip>
                                    <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Генерация имён" 
                               FontWeight="Bold" 
                               FontSize="13"
                               Foreground="#CC3300"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>
                                            <TextBlock TextWrapping="Wrap" 
                               TextAlignment="Center"
                               FontSize="12"
                               Foreground="#333333"
                               LineHeight="16">
                        Генерирует новые имена деталей в виде децимального номера. После загрузки раскладок из Ажанкам эти имена будут заменены обратно на исходные имена от заказчика.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </Image.ToolTip>
                            </Image>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </GroupBox>


            <GroupBox Style="{StaticResource GroupBox.Small}" Margin="5">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TargetTechItem.NumberName}" FontWeight="Bold" ToolTip="{Binding TargetTechItem.NumberName}" Width="120"/>
                        <Image Source="/Images/question.png" MaxHeight="10">
                            <Image.ToolTip>
                                <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="⚠ Внимание" 
                                   FontWeight="Bold" 
                                   FontSize="13"
                                   Foreground="#CC3300"
                                   TextAlignment="Center"
                                   Margin="0,0,0,8"/>
                                        <TextBlock TextWrapping="Wrap" 
                                   TextAlignment="Center"
                                   FontSize="12"
                                   Foreground="#333333"
                                   LineHeight="16">
                            Изображение приблизительно и может отличаться от исходной модели.
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </StackPanel>
                </GroupBox.Header>

                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Viewbox Stretch="Uniform" Width="80" Height="80">
                        <Path Data="{Binding TargetTechItem.DisplayGeometry}"
                              Stroke="Black" Stretch="Fill"
                              StrokeThickness="{Binding TargetTechItem.VisualStrokeThickness}"/>
                    </Viewbox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                        <Button Content="Шильда" Click="Shields_Engraving" Margin="20,0,0,0" ToolTip="Создать шильды на основе пустого шаблона"/>
                        <Image Source="/Images/question.png" Width="16">
                            <Image.ToolTip>
                                <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Гравировка шильд" 
                               FontWeight="Bold" 
                               FontSize="13"
                               Foreground="#CC3300"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>
                                        <TextBlock TextWrapping="Wrap" 
                               TextAlignment="Center"
                               FontSize="12"
                               Foreground="#333333"
                               LineHeight="16">
                        Функция нанесения гравировки на шаблон шильды. Подготовьте txt-файл с необходимыми строчками и dxf-файл с шаблоном шильды. Программа создаст шильду в формате dxf на каждую строчку текста.
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </StackPanel>

                </Grid>
            </GroupBox>

        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="RequestGrid" Style="{StaticResource DataGrid.Small}" ItemsSource="{Binding TechItems}" SelectionUnit="Cell" BorderBrush="Red" EnableColumnVirtualization="True" RowDetailsVisibilityMode="Collapsed" Margin="10"  AutoGenerateColumns="False" MouseUp="CopyValue_MouseUp" MaxHeight="300" SelectedCellsChanged="Set_TargetTechItem">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="№ чертежа" SortMemberPath="NumberName" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NumberName}" Foreground="{Binding NumberName, Converter={StaticResource TitleLengthToForegroundConverter}, ConverterParameter=30}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NumberName}" Foreground="{Binding NumberName, Converter={StaticResource TitleLengthToForegroundConverter}, ConverterParameter=30}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Профиль" Binding="{Binding Profile}" Width="100"/>
                    <DataGridTextColumn Header="Размеры" Binding="{Binding Sizes}"/>
                    <DataGridTextColumn Header="Металл" Binding="{Binding Material}"/>
                    <DataGridTextColumn Header="Толщина" Binding="{Binding Destiny}"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}"/>
                    <DataGridTextColumn Header="Маршрут" Binding="{Binding Route}"/>
                    <DataGridTextColumn Header="Давальч" Binding="{Binding HasMaterial}"/>
                    <DataGridTextColumn Header="Грав" Binding="{Binding TextMarking}"/>
                    <DataGridTemplateColumn Header="Ещё" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="DetailsButton" Click="ToggleRowDetails_Click"
                                Padding="2" Width="20" Height="20"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="Показать/скрыть подробности">
                                    <Image Source="/Images/tot.png" Width="16" Height="16"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Margin="4" Padding="4"
                                                Background="{DynamicResource RegionBrush}"
                                                CornerRadius="{DynamicResource DefaultCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"
                                                           >Исходник -</TextBlock>
                                <TextBlock Margin="5,0,0,0" Text="{Binding OriginalName}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Добавить строку" Click="Add_TechItem">
                            <MenuItem.Icon>
                                <Image Source="/Images/plus.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Удалить строку" Click="Remove_TechItem">
                            <MenuItem.Icon>
                                <Image Source="/Images/del_offer.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Добавить гравировку" Click="AddEngraving">
                            <MenuItem.Icon>
                                <Image Source="/Images/engraving.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <GroupBox Style="{StaticResource GroupBox.Small}" Grid.Column="1" VerticalAlignment="Top" Margin="0,10,0,0" Grid.RowSpan="2">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Правила именования" FontWeight="Bold"/>
                        <Image Source="/Images/question.png" MaxHeight="10">
                            <Image.ToolTip>
                                <ToolTip Style="{StaticResource InfoToolTipStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Правила именования" 
                                   FontWeight="Bold" 
                                   FontSize="13"
                                   Foreground="#CC3300"
                                   TextAlignment="Center"
                                   Margin="0,0,0,8"/>
                                        <TextBlock TextWrapping="Wrap" 
                                   TextAlignment="Center"
                                   FontSize="12"
                                   Foreground="#333333"
                                   LineHeight="16">
                            В соответствующем выпадающем списке можно увидеть, как правильно называть материалы деталей и добавляемые к ним работы.
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </StackPanel>
                </GroupBox.Header>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <hc:ComboBox x:Name="MetalsDrop" hc:InfoElement.Placeholder="Металлы" Width="120"/>
                        <Button ToolTip="Скопировать металл" Padding="0" BorderThickness="0" Background="Transparent" Click="Copy_Metal" Margin="5,0,0,0">
                            <Image Source="Images/copy.png" Width="12"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <hc:ComboBox x:Name="DestinyDrop" hc:InfoElement.Placeholder="Толщина" Width="120"/>
                        <Button ToolTip="Скопировать толщину" Padding="0" BorderThickness="0" Background="Transparent" Click="Copy_Thickness" Margin="5,0,0,0">
                            <Image Source="Images/copy.png" Width="12"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <hc:CheckComboBox x:Name="WorksDrop" ItemsSource="{Binding Works}" hc:InfoElement.Placeholder="Работы" Width="120" Style="{StaticResource CheckComboBoxPlus}"/>
                        <Button ToolTip="Скопировать работу" Padding="0" BorderThickness="0" Background="Transparent" Click="Copy_Work" Margin="5,0,0,0">
                            <Image Source="Images/copy.png" Width="12"/>
                        </Button>
                    </StackPanel>
                    <Button ToolTip="Добавить гравировку на ВСЕ детали" Margin="0,10,0,0" Padding="0" Click="AddEngraving_ToAllTechItems">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <Image Source="Images/engraving.png"/>
                            <TextBlock Text="Гравировка" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </GroupBox>
            
            <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="1" VerticalAlignment="Bottom">
                <TextBox x:Name="DeleteText" Margin="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="120" Text="Развертка - "/>
                <Button Content="Удалить" Margin="5" Padding="5" Click="Delete_WithoutNames"/>
                <Image Source="/Images/question.png" MaxHeight="20">
                    <Image.ToolTip>
                        <ToolTip Style="{StaticResource InfoToolTipStyle}">
                            <StackPanel>
                                <TextBlock Text="Укорачивание имён" 
                               FontWeight="Bold" 
                               FontSize="13"
                               Foreground="#CC3300"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" 
                               TextAlignment="Center"
                               FontSize="12"
                               Foreground="#333333"
                               LineHeight="16">
                        Функция укорачивания наименований. Введите символ или часть текста, и, если программа найдет совпадение, то удалит это из каждого наименования.
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </Image.ToolTip>
                </Image>
                <TextBlock Text="Количество комплектов" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="100,0,0,0" MaxWidth="70" TextWrapping="Wrap"/>
                <TextBox x:Name="CountText" FontWeight="Bold" Foreground="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MinWidth="40" MaxWidth="40" Margin="5" Text="1"/>
                <TextBlock Text="Строк заявки:" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100,0,0,0"/>
                <TextBlock Text="{Binding TechItems.Count}" Margin="5,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Blue"/>
                <Button Content="Очистить" Click="Clear_TechItems" Margin="10,5,5,5" Padding="5"/>
                <Image Source="/Images/question.png" MaxHeight="20">
                    <Image.ToolTip>
                        <ToolTip Style="{StaticResource InfoToolTipStyle}">
                            <StackPanel>
                                <TextBlock Text="Очистка таблицы" 
                           FontWeight="Bold" 
                           FontSize="13"
                           Foreground="#CC3300"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" 
                           TextAlignment="Center"
                           FontSize="12"
                           Foreground="#333333"
                           LineHeight="16">
                    Кнопка "Очистить" удаляет ВСЕ строки из таблицы. Чтобы удалить одну строку, нажмите по строке правой кнопкой мыши и левой по команде "Удалить строку".
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </Image.ToolTip>
                </Image>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>