<UserControl x:Class="Metal_Code.PartsControl"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Metal_Code"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800">

    <UserControl.Resources>
        <local:IsNotPlaceholderConverter x:Key="IsNotPlaceholderConverter"/>

        <!-- Цвета -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFFE1"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D1D9E0"/>
        <SolidColorBrush x:Key="FocusBorderColor" Color="#4A90E2"/>

        <!-- Общая толщина границы -->
        <Thickness x:Key="DefaultBorderThickness">1</Thickness>

        <!-- Стиль для Button -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FocusBorderColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Обновлённый стиль: сплошной оранжевый фон при активации -->
        <Style x:Key="SideIconButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                BorderThickness="{TemplateBinding BorderThickness}" 
                BorderBrush="{TemplateBinding BorderBrush}"
                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Наведение: лёгкий фон + стандартный синий цвет рамки -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="BorderBrush" Value="#4A90E2"/>
                </Trigger>

                <!-- Активное состояние: светлый оранжевый фон + отчетливая рамка -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FFB74D"/>
                    <Setter Property="BorderBrush" Value="#CC8833"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <!-- Глобальная сетка: 2 колонки, 3 строки -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <!-- Колонка сайдбара -->
            <ColumnDefinition Width="*"/>
            <!-- Колонка основного контента -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MaxHeight="400"/>
            <!-- Строка 0: Раскладки -->
            <RowDefinition Height="*" MinHeight="200"/>
            <!-- Строка 1: Стандартные детали + Список деталей -->
            <RowDefinition Height="Auto"/>
            <!-- Строка 2: Массовые операции -->
        </Grid.RowDefinitions>

        <!-- ================= СТРОКА 0: РАСКЛАДКИ ================= -->

        <!-- Кнопка раскладок (в сайдбаре, всегда сверху) -->
        <Border Background="{DynamicResource RegionBrush}"
        BorderBrush="LightGray" 
        BorderThickness="1"
        CornerRadius="6"
        VerticalAlignment="Top">
            <StackPanel>
                <ToggleButton x:Name="NestingToggle" 
                      ToolTip="Показать/скрыть раскладки" 
                      Click="ShowNesting_Click" 
                      Style="{StaticResource SideIconButton}">
                    <Image Source="Images/nesting.png" Width="24"/>
                </ToggleButton>

                <!-- 🔥 Кнопки управления листами (показываются только когда раскладки активны) -->
                <StackPanel x:Name="SheetManagementButtons" Visibility="Collapsed" Margin="0,4,0,0">

                    <!-- Кнопка добавления (обычная Button, не ToggleButton) -->
                    <Button x:Name="AddSheetBtn" 
            Content="+" 
            Click="AddSheet_Click" 
            Width="30" Height="30" Margin="4,2"
            ToolTip="Добавить новый лист" 
            FontSize="16" FontWeight="Bold" Foreground="Green"
            Background="#F0FFF0" BorderBrush="#90EE90" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Кнопка удаления -->
                    <Button Content="−" 
            Click="RemoveSheet_Click" 
            Width="30" Height="30" Margin="4,2"
            ToolTip="Удалить последний лист" 
            FontSize="16" FontWeight="Bold" Foreground="Red"
            Background="#FFF0F0" BorderBrush="#FFB6C1" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- 🔥 Inline-форма ввода размеров листа (скрыта по умолчанию) -->
                    <StackPanel x:Name="AddSheetForm" Visibility="Collapsed" Margin="4,4,4,0">
                        <TextBlock Text="Ширина" FontSize="10" Foreground="Gray" Margin="0,2,0,0"/>
                        <TextBox x:Name="SheetWidthInput" Text="2000" Margin="0,2"
             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                        <TextBlock Text="Высота" FontSize="10" Foreground="Gray" Margin="0,4,0,0"/>
                        <TextBox x:Name="SheetHeightInput" Text="1000" Margin="0,2"
             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                        <!-- Поле для отступа -->
                        <TextBlock Text="Отступ" FontSize="10" Foreground="Gray" Margin="0,4,0,0"/>
                        <TextBox x:Name="SheetSpacingInput" Text="10" Margin="0,2"
             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                            <Button Content="✓" Click="ConfirmAddSheet_Click"
                Width="26" Height="26" Margin="0,2"
                ToolTip="Создать лист" Foreground="Green" FontWeight="Bold"
                Background="#F0FFF0" BorderBrush="#90EE90" BorderThickness="1"/>
                            <Button Content="✗" Click="CancelAddSheet_Click"
                Width="26" Height="26" Margin="0,2"
                ToolTip="Отмена" Foreground="Red" FontWeight="Bold"
                Background="#FFF0F0" BorderBrush="#FFB6C1" BorderThickness="1"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Список раскладок (в основном контенте) -->
        <ScrollViewer x:Name="imagesScroll" 
              Grid.Row="0" Grid.Column="1"
              Visibility="Collapsed" 
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled"
              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">

            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <!-- Колонка 1: Листы и изображения (горизонтальная прокрутка) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Колонка 2: Пустое пространство-разделитель -->
                    <ColumnDefinition Width="20"/>
                    <!-- Колонка 3: Трубы (вертикальный стек с переносом в новый столбец) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 🔥 Горизонтальный стек для ЛИСТОВ -->
                <StackPanel x:Name="SheetImagesStack" Orientation="Horizontal" VerticalAlignment="Top"/>

                <!-- 🔥 Вертикальный WrapPanel для ТРУБ -->
                <!-- MaxHeight="300" означает, что при высоте элемента ~110px, после 2-го элемента начнется новый столбец -->
                <WrapPanel x:Name="PipeImagesStack" Grid.Column="2" Orientation="Vertical"
                           MaxHeight="300" VerticalAlignment="Top"/>
            </Grid>
        </ScrollViewer>

        <!-- ================= СТРОКА 1: СТАНДАРТНЫЕ ДЕТАЛИ + СПИСОК ДЕТАЛЕЙ ================= -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <!-- Колонка для кнопки (совпадает с глобальной) -->
                <ColumnDefinition Width="*"/>
                <!-- Колонка для списка деталей -->
            </Grid.ColumnDefinitions>

            <StackPanel>
                <!-- Кнопка стандартных деталей -->
                <Border Background="{DynamicResource RegionBrush}"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="6"
                    VerticalAlignment="Top">
                    <ToggleButton x:Name="StandardPartsToggle" 
                              ToolTip="Добавить стандартную деталь" 
                              Click="Add_StandartPart_Click" 
                              Style="{StaticResource SideIconButton}">
                        <Image Source="/Images/standard.png" Width="24"/>
                    </ToggleButton>
                </Border>

                <!-- Кнопка добавления деталей из DXF-файлов -->
                <Border Background="{DynamicResource RegionBrush}"
                        BorderBrush="LightGray" BorderThickness="1"
                        CornerRadius="6" VerticalAlignment="Top">
                    <ToggleButton x:Name="DxfToggle"
                              ToolTip="Добавить детали из DXF-файлов" 
                              Click="AddPartsFromDxf_Click" 
                              Style="{StaticResource SideIconButton}">
                        <Image Source="/Images/add_models_2.png" Width="24"/>
                    </ToggleButton>
                </Border>

                <!-- Кнопка авто-нестинга -->
                <Border Background="{DynamicResource RegionBrush}"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="6"
                    VerticalAlignment="Top">
                    <ToggleButton ToolTip="Переразложить детали с геометрией"
                              Click="AutoNest_Click"
                              Style="{StaticResource SideIconButton}">
                        <Image Source="/Images/autonest_2.png" Width="24"/>
                    </ToggleButton>
                </Border>

                <!-- Кнопка экспорта раскладок -->
                <Border Background="{DynamicResource RegionBrush}"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="6"
                    VerticalAlignment="Top">
                    <ToggleButton ToolTip="Сохранить все листы раскладки в PDF-файл"
                                  Click="ExportNestingToPdf_Click"
                                  Style="{StaticResource SideIconButton}">
                        <Image Source="/Images/pdf_generate.png" Width="24"/>
                    </ToggleButton>
                </Border>

                <!-- Кнопка пакетного экспорта всех деталей в DXF -->
                <Border Background="{DynamicResource RegionBrush}"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="6"
        VerticalAlignment="Top">
                    <ToggleButton ToolTip="Создать DXF для всех деталей заготовки"
                  Click="ExportAllToDxf_Click"
                  Style="{StaticResource SideIconButton}">
                        <Image Source="/Images/export_models.png" Width="24"/>
                    </ToggleButton>
                </Border>
            </StackPanel>

            <!-- Блок пустого состояния (виден только когда деталей нет) -->
            <Grid x:Name="EmptyStateGrid" 
      Grid.Column="1"
      HorizontalAlignment="Center" 
      VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Кнопка: Добавить DXF -->
                    <Button x:Name="EmptyStateAddDxfBtn" 
                Click="AddPartsFromDxf_Click"
                MinWidth="200" 
                MinHeight="100" 
                Padding="20,10"
                ToolTip="Добавить детали из DXF-файлов">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="/Images/add_models_2.png" Width="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Добавить DXF" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Разделитель "или" -->
                    <TextBlock Text="или" 
                   FontSize="14" 
                   Foreground="Gray" 
                   VerticalAlignment="Center" 
                   Margin="25,0,25,0"/>

                    <!-- Кнопка: Стандартные детали -->
                    <Button x:Name="EmptyStateAddStandardBtn" 
                Click="Add_StandartPart_Click"
                MinWidth="200" 
                MinHeight="100" 
                Padding="20,10"
                ToolTip="Добавить стандартную деталь">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="/Images/standard.png" Width="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="Стандартные детали" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            
            <!-- Список деталей (в основном контенте) -->
            <ScrollViewer x:Name="partsScroll" 
              Grid.Column="1" Visibility="Collapsed"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled"
              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                <!-- 🔥 Перехватываем колесико -->
                <ItemsControl x:Name="partsList" Margin="3">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ================= СТРОКА 2: МАССОВЫЕ ОПЕРАЦИИ ================= -->
        <Border Grid.Row="2" Grid.Column="1" 
         Background="{DynamicResource BackgroundBrush}"
        BorderBrush="#FFB74D" 
        BorderThickness="2"
        CornerRadius="6"
        Margin="5">
            <StackPanel Orientation="Horizontal" Margin="5" >

                <!-- Кнопка сортировки по выбранной работе -->
                <Button x:Name="SortByWorkButton"
                    Content="⇅"
                    Click="SortDetails_Click"
                    Width="32" Height="32"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="#0D47A1"
                    Background="White"
                    BorderBrush="#0D47A1"
                    BorderThickness="1"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    ToolTip="Отсортировать детали: сначала с выбранной работой, затем остальные">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="sortBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="sortBorder" Property="Background" Value="#E3F2FD"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="sortBorder" Property="Background" Value="#BBDEFB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Заголовок -->
                <TextBlock Text="Массовые операции" 
                       FontWeight="Bold" FontSize="13" Foreground="#CC8833"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>

                <!-- Выбор работы (кнопки "+" и ">" удалены из шаблона) -->
                <ComboBox x:Name="WorksDrop" Width="160" SelectionChanged="SelectedWork" VerticalAlignment="Center" Margin="12,0,0,0" SelectedIndex="1">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="2"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="3,0"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Иконка подсказки -->
                <Border Width="20" Height="20" CornerRadius="10" Background="#FFB74D" Margin="8,0"
                    VerticalAlignment="Center" Cursor="Help" ToolTipService.ShowDuration="30000">
                    <TextBlock Text="?" FontWeight="Bold" Foreground="White" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border.ToolTip>
                        <ToolTip Placement="Mouse" Background="White" BorderBrush="#FFB74D" BorderThickness="1"
                             Padding="12" MaxWidth="340" HasDropShadow="True">
                            <StackPanel>
                                <TextBlock Text="Порядок работы с массовыми операциями" FontWeight="Bold" FontSize="13"
                                       Foreground="#CC8833" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#333">
                                <Bold>Шаг 1.</Bold> Выберите работу из списка и нажмите
                                <Bold>«Добавить ко всем»</Bold> — работа добавится ко ВСЕМ деталям списка.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#333" Margin="0,8,0,0">
                                <Bold>Шаг 2.</Bold> Настройте параметры добавленной работы:
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#333" Margin="12,4,0,0">
                                • Гибка, сварка, вальцовка, фрезеровка — значения применяются
                                <Italic>сразу при вводе</Italic>.
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#333" Margin="12,4,0,0">
                                • Окраска — впишите цвет RAL и <Italic>переведите фокус</Italic>
                                на другое поле (кликните в пустое место).
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#333" Margin="12,4,0,0">
                                • Отверстия (резьба, зенковка, сверловка, заклёпки) — впишите диаметр
                                и <Italic>переведите фокус</Italic> на другое поле.
                                </TextBlock>
                                <Border BorderBrush="#FFB74D" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,6,0,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#CC8833">
                                    <Bold>Примечание:</Bold> если нужно добавить работу только к одной конкретной детали,
                                    найдите кнопку <Bold>«Добавить работы»</Bold> на карточке нужной детали в списке выше.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>
                </Border>

                <!-- Кнопка применения -->
                <Button x:Name="ApplyToAllButton" Content="✓ Добавить ко всем" Click="ApplyToAll_Click"
                        Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand"/>

                <!-- Блоки параметров работ (кнопки "Г+", "Св+" и т.д. удалены) -->
                <StackPanel x:Name="WorksGrid" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">

                    <!-- Индекс 0: Гибка (видима по умолчанию) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Г" FontWeight="Bold" ToolTip="Гибка для всех" Margin="5,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="20"/>
                        <TextBox x:Name="Bend" TextChanged="SetProperty" ToolTip="Кол-во однотипных гибов" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MaxLines="1" Width="30"/>
                        <ComboBox x:Name="BendDrop" SelectedIndex="0" ToolTip="Длина гиба" SelectionChanged="SetType" Margin="5,0,0,0" Width="85"/>
                        <Button Content="-" ToolTip="Сбросить" Margin="5,0,0,0" Click="SetDefaultBends" Width="30"/>
                    </StackPanel>

                    <!-- Индекс 1: Сварка -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Св" FontWeight="Bold" ToolTip="Сварка" Margin="5,0,0,0" VerticalAlignment="Center" Width="30"/>
                        <TextBox x:Name="Weld" TextChanged="SetProperty" ToolTip="Длина, мм" MaxLines="1" Margin="5,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="50"/>
                        <ComboBox x:Name="WeldDrop" SelectionChanged="SetType" SelectedIndex="0" Margin="5,0,0,0" Width="85"/>
                    </StackPanel>

                    <!-- Индекс 2: Окраска -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="О" FontWeight="Bold" ToolTip="Окраска" Margin="5,0,0,0" VerticalAlignment="Center" Width="30"/>
                        <TextBox x:Name="Paint" LostFocus="SetProperty" ToolTip="Цвет RAL (переведите фокус после ввода)" Margin="5,0,0,0" Width="50"/>
                        <ComboBox x:Name="PaintDrop" SelectionChanged="SetType" SelectedIndex="0" Margin="5,0,0,0" Width="85"/>
                    </StackPanel>

                    <!-- Индекс 3: Резьба -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Р" FontWeight="Bold" ToolTip="Резьба" Margin="5,0,0,0" VerticalAlignment="Center" Width="30"/>
                        <TextBlock Text="⌀" Margin="10,0,0,0" Width="10"/>
                        <TextBox x:Name="Wide1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" MaxLines="1" ToolTip="Диаметр (переведите фокус после ввода)" LostFocus="SetPropertyThread" Width="40"/>
                        <TextBlock Text="N" Margin="10,0,0,0" Width="10"/>
                        <TextBox x:Name="Holes1" TextChanged="SetProperty" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" MaxLines="1" ToolTip="Кол-во" Width="40"/>
                    </StackPanel>

                    <!-- Индекс 4: Зенковка -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="З" FontWeight="Bold" ToolTip="Зенковка" Margin="5,0,0,0" VerticalAlignment="Center" Width="30"/>
                        <TextBlock Text="⌀" Margin="10,0,0,0" Width="10"/>
                        <TextBox x:Name="Wide2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" MaxLines="1" ToolTip="Диаметр (переведите фокус после ввода)" LostFocus="SetPropertyThread" Width="40"/>
                        <TextBlock Text="N" Margin="10,0,0,0" Width="10"/>
                        <TextBox x:Name="Holes2" TextChanged="SetProperty" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" MaxLines="1" ToolTip="Кол-во" Width="40"/>
                    </StackPanel>

                    <!-- Индекс 5: Сверловка -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="С" FontWeight="Bold" ToolTip="Сверловка" Margin="5,0,0,0" VerticalAlignment="Center" Width="30"/>
                        <TextBlock Text="⌀" Margin="10,0,0,0" Width="10"/>
                        <TextBox x:Name="Wide3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" MaxLines="1" ToolTip="Диаметр (переведите фокус после ввода)" LostFocus="SetPropertyThread" Width="40"/>
                        <TextBlock Text="N" Margin="10,0,0,0" Width="10"/>
                        <TextBox x:Name="Holes3" TextChanged="SetProperty" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" MaxLines="1" ToolTip="Кол-во" Width="40"/>
                    </StackPanel>

                    <!-- Индекс 6: Вальцовка -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="В" FontWeight="Bold" ToolTip="Вальцовка" Margin="5,0,0,0" VerticalAlignment="Center" Width="30"/>
                        <ComboBox x:Name="RollDrop" SelectedIndex="0" ToolTip="Сторона" SelectionChanged="SetType" Margin="5,0,0,0" Width="85"/>
                    </StackPanel>

                    <!-- Индекс 7: Оцинковка -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Ц" FontWeight="Bold" ToolTip="Оцинковка" Margin="5,0,0,0" VerticalAlignment="Center" Width="30"/>
                        <TextBox IsReadOnly="True" ToolTip="Вес" Margin="5,0,0,0" Width="50"/>
                        <TextBlock Text="кг" Margin="5,0,0,0" Width="25"/>
                    </StackPanel>

                    <!-- Индекс 8: Фрезеровка -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Ф" FontWeight="Bold" ToolTip="Фрезеровка" Margin="5,0,0,0" VerticalAlignment="Center" Width="30"/>
                        <TextBox x:Name="TotalTime" TextChanged="SetProperty" ToolTip="Время" Margin="5,0,0,0" Width="50"/>
                        <TextBlock Text="мин" Margin="5,0,0,0" Width="25"/>
                    </StackPanel>

                    <!-- Индекс 9: Заклепки -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Зк" FontWeight="Bold" ToolTip="Заклепки" Margin="5,0,0,0" VerticalAlignment="Center" Width="30"/>
                        <TextBlock Text="⌀" Margin="10,0,0,0" Width="10"/>
                        <TextBox x:Name="Wide4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" MaxLines="1" ToolTip="Диаметр (переведите фокус после ввода)" LostFocus="SetPropertyThread" Width="40"/>
                        <TextBlock Text="N" Margin="10,0,0,0" Width="10"/>
                        <TextBox x:Name="Holes4" TextChanged="SetProperty" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0" MaxLines="1" ToolTip="Кол-во" Width="40"/>
                    </StackPanel>

                    <!-- Индекс 10: Аквабластинг -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="А" FontWeight="Bold" ToolTip="Аквабластинг" Margin="5,0,0,0" VerticalAlignment="Center" Width="30"/>
                        <TextBox IsReadOnly="True" ToolTip="Площадь" Margin="5,0,0,0" Width="50"/>
                        <TextBlock Text="кв м" Margin="5,0,0,0" Width="25"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>