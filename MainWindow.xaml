             MaxLines="1" Margin="6,0,0,0" Width="60"
             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <TextBlock Text="раб/дней" Margin="6,0,0,0" VerticalAlignment="Center"/>

                        <ToggleButton Content="⚡ Экспресс"
                  IsChecked="{Binding HasAssembly, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}"
                  Style="{StaticResource ExpressToggleStyle}"
                  ToolTip="Добавить наценку за срочность" Margin="10,0,0,0"/>

                        <Button Command="{Binding SaveCommand}" ToolTip="Сохранить расчет (Ctrl+D)" Margin="65,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="Images/save.png"/>
                                <TextBlock Text="Сохранить КП" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="12,4" VerticalAlignment="Center">
