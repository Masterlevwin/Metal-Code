                        BorderBrush="#E5E7EB" BorderThickness="1" MinWidth="260">
                                <StackPanel>
                                    <TextBlock Text="ПОМЕТКА К КП" FontWeight="SemiBold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                    <hc:TextBox x:Name="OfferNote" hc:InfoElement.Placeholder="Эта пометка будет добавлена к имени папки КП и папки заказа при запуске в работу"
