<Window x:Class="Metal_Code.MainWindow" x:Name="MainWindowRoot"
        xmlns:hc="https://handyorg.github.io/handycontrol" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Metal_Code"
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        mc:Ignorable="d" AutomationProperties.Name="" WindowStartupLocation="CenterScreen" Closing="Exit" WindowState="Maximized" Icon="/app_logo.jpeg" Background="{DynamicResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" FontFamily="Century" MinWidth="1280" MinHeight="720" Activated="MainWindow_Activated">

    <Window.Resources>
        <!-- Конвертеры -->
        <local:CostConverter x:Key="CostConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:DateToBoolConverter x:Key="DateToBoolConverter"/>
        <local:OrderToBoolConverter x:Key="OrderToBoolConverter"/>
        <converters:GroupCompanyNamesConverter x:Key="GroupCompanyNamesConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
        <converters:ShipmentButtonTextConverter x:Key="ShipmentButtonTextConverter"/>
        <converters:LocalOfferColorConverter x:Key="LocalOfferColorConverter"/>

        <!-- Цвета -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFFE1"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D1D9E0"/>
        <SolidColorBrush x:Key="FocusBorderColor" Color="#4A90E2"/>

        <!-- Общая толщина границы -->
        <Thickness x:Key="DefaultBorderThickness">1</Thickness>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}" />
            <Setter Property="Padding" Value="4" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для Button -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FocusBorderColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TabControl -->
        <Style x:Key="OffersTabControl" BasedOn="{StaticResource TabControlSliding}" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource TabItemInLine}"/>
        </Style>

        <!-- Стиль для выбора компании (Логотипы) -->
        <Style x:Key="CompanyRadioStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="White">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90E2"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Компактный тоггл-иконка для заголовка -->
        <Style x:Key="IconToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E8F0FE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90E2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4A90E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль тоггла пометки: подсвечен по умолчанию, гаснет при пустой пометке -->
        <Style x:Key="NoteToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource IconToggleStyle}">
            <!-- СОСТОЯНИЕ ПО УМОЛЧАНИЮ: пометка есть → подсветка -->
            <Setter Property="Background" Value="#E8F0FE"/>
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="ToolTip" Value="{Binding Text, ElementName=OfferNote}"/>
            <Style.Triggers>
                <!-- ПОМЕТКИ НЕТ: возвращаем обычный вид -->
                <DataTrigger Binding="{Binding Text.Length, ElementName=OfferNote, FallbackValue=0}" Value="0">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                    <Setter Property="ToolTip" Value="Пометка не задана"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Компактная версия сегмента НДС -->
        <Style x:Key="SegmentedRadioStyleSmall" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4A90E2"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EBF5FB"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#357ABD"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопки Экспресс -->
        <Style x:Key="ExpressToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonDefault}">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#F59E0B"/>
                    <Setter Property="BorderBrush" Value="#D97706"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#D97706"/>
                    <Setter Property="Foreground" Value="White"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Q" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding LoadCommand}"/>
        <KeyBinding Key="F5" Command="{Binding UpdateCommand}"/>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenAssistantCommand}"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <Menu x:Name="MenuMain" DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="10,0,0,0" FontFamily="Leelawadee UI" DisplayMemberPath="{Binding CurrentManager.Name, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}" VerticalAlignment="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Новый расчет" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+Q">
                    <MenuItem.Icon>
                        <Image Source="/Images/new3.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Открыть" Command="{Binding OpenCommand}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <Image Source="/Images/open4.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Сохранить" Command="{Binding SaveCommand}" InputGestureText="Ctrl+D">
                    <MenuItem.Icon>
                        <Image Source="/Images/save.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Выход" Click="Exit">
                    <MenuItem.Icon>
                        <Image Source="/Images/exit.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem x:Name="Settings" Header="Базы">
                <MenuItem Header="База заготовок" Tag="settings.details" Click="OpenSettings"/>
                <MenuItem Header="База работ" Tag="settings.works" Click="OpenSettings"/>
                <MenuItem Header="База менеджеров" Tag="settings.managers" Click="OpenSettings"/>
                <MenuItem Header="База материалов" Tag="settings.metals" Click="OpenSettings"/>

                <Separator>
                    <Separator.Style>
                        <Style TargetType="Separator">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentManager.IsAdmin, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Separator.Style>
                </Separator>
                <MenuItem Header="Обновить эталон справочников" Click="ExportReferenceSeed_Click">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemBaseStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentManager.IsAdmin, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Инструменты">
                <MenuItem Header="Таблица гибов" Click="ShowTableOfBends">
                    <MenuItem.Icon>
                        <Image Source="/Images/bends.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Маршрут производства" Click="ShowRouteWindow">
                    <MenuItem.Icon>
                        <Image Source="/Images/route.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Спецификация" Click="CreateSpec">
                    <MenuItem.Icon>
                        <Image Source="/Images/open.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Паспорт качества" Click="CreatePassport">
                    <MenuItem.Icon>
                        <Image Source="/Images/list.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Акт приема-передачи" Click="CreateAct">
                    <MenuItem.Icon>
                        <Image Source="/Images/blueprint.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Простая комплектация" Click="CreateComplect">
                    <MenuItem.Icon>
                        <Image Source="/Images/complect2.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Конвертер DWG в DXF" Click="Convert_dwg_to_dxf">
                    <MenuItem.Icon>
                        <Image Source="/Images/convert.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Список задач" Click="CreateRegistryWindow">
                    <MenuItem.Icon>
                        <Image Source="/Images/express.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Сортировка файлов" Click="SortFilesByMonth">
                    <MenuItem.Icon>
                        <Image Source="/Images/screen.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Отчеты">
                <MenuItem Header="📊 По отгруженным заказам за выбранный период" Click="Report_On_Shipped_Orders">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentManager.IsEngineer, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="🏭 По заказам в производстве" Click="Report_On_Production_Orders">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentManager.IsEngineer, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="О программе">
                <MenuItem Header="Руководство" Click="OpenExample">
                    <MenuItem.Icon>
                        <Image Source="/Images/lamp.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="История обновлений" Click="OnUpdatesMenuItemClick"/>
                <Separator/>
                <MenuItem Header="Обновить программу" Click="Restart"/>
            </MenuItem>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="OnlineIndicator" Width="12" Height="12" CornerRadius="6"
                        Background="Gray" Margin="0,0,5,0" ToolTip="Статус подключения"/>
                <Button x:Name="Login" Content="Пользователь" ToolTip="Сменить пользователя" Click="ShowLoginWindow"/>
            </StackPanel>

            <Button x:Name="AssistantButton" 
                    Click="OpenAssistantWindow"
                    ToolTip="Открыть ассистента (Ctrl+K)"
                    Margin="15,0,0,0" 
                    Padding="8,2"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🤖" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Спросить МИШУ" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Menu>

        <StatusBar x:Name="Status" DockPanel.Dock="Bottom" Margin="10">
            <StackPanel Orientation="Horizontal">
                <ProgressBar x:Name="InsertProgressBar" MinWidth="200" Visibility="Collapsed" IsIndeterminate="True" />
                <TextBox x:Name="NotifyText" BorderThickness="0" Margin="5,0,0,0" Background="{x:Null}"/>
            </StackPanel>
        </StatusBar>

        <Grid x:Name="WindowGrid" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="600"/>
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="DetailsBox" Style="{StaticResource GroupBoxOriginal}" Margin="5">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Click="AddDetail" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/plus.png"/>
                                <TextBlock Text="Деталь" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Click="ShowAssemblyWindow" Margin="10,0,0,0" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/assembly.png"/>
                                <TextBlock Text="СБ" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Click="AddBasket" Margin="10,0,0,0" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/basket.png"/>
                                <TextBlock Text="ПКИ" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button ToolTip="Создать новый расчет (Ctrl+Q)" Command="{Binding NewProjectCommand}"
                                Padding="0" Margin="30,0,0,0" VerticalAlignment="Top">
                            <Image Source="Images/new3.png"/>
                        </Button>

                        <Button ToolTip="Открыть сохраненный расчет (Ctrl+S)" Command="{Binding OpenCommand}"
                                Padding="0" Margin="15,0,0,0" VerticalAlignment="Top">
                            <Image Source="Images/open4.png"/>
                        </Button>

                        <Button ToolTip="Создать папку проекта" Click="CreateProjectFolder"
                                Padding="0" Margin="70,0,0,0" VerticalAlignment="Top">
                            <Image Source="Images/save3.png"/>
                        </Button>

                        <Button ToolTip="Создать заявку за клиента" Click="CreateRequest"
                                Padding="0" Margin="15,0,0,0" VerticalAlignment="Top">
                            <Image Source="Images/comment.png"/>
                        </Button>

                        <Button ToolTip="Загрузить раскладки (Ctrl+F)" Command="{Binding LoadCommand}"
                                Padding="0" Margin="15,0,0,0" VerticalAlignment="Top">
                            <Image Source="Images/xlsx_load.png"/>
                        </Button>

                        <Expander Header="Коэффициенты" IsExpanded="False" Margin="20,0,0,0" VerticalAlignment="Top" Width="150">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Общий" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <hc:NumericUpDown Grid.Column="1"
                          Value="{Binding Ratio, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}, StringFormat='{}{0:F2}'}"
                          Minimum="0" Maximum="10" Increment="0.01" ToolTip="Введите наценку на всё КП"/>

                                <TextBlock Grid.Row="1" Text="Материал" Margin="0,8,8,0" VerticalAlignment="Center" />
                                <hc:NumericUpDown Grid.Row="1" Grid.Column="1"
                          Value="{Binding MaterialFactor, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}, StringFormat='{}{0:F2}'}"
                          Minimum="0" Maximum="10" Increment="0.01" Margin="0,8,0,0" ToolTip="Введите наценку на весь материал"/>

                                <TextBlock Grid.Row="2" Text="Услуги" Margin="0,8,8,0" VerticalAlignment="Center" />
                                <hc:NumericUpDown x:Name="ServiceFactorBox" Grid.Row="2" Grid.Column="1"
                          Value="{Binding ServiceFactor, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}, StringFormat='{}{0:F2}'}"
                          Minimum="0" Maximum="10" Increment="0.01" Margin="0,8,0,0" ToolTip="Введите наценку на все услуги"/>
                            </Grid>
                        </Expander>

                        <StackPanel Margin="10,0,0,0" Width="150" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="DetailsToggle" Content="{Binding Result, Converter={StaticResource CostConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}"
                  Click="OnDetailsToggleClick" Width="150"
                  Cursor="Hand" FontSize="14" MouseEnter="UpdateResult"
                  Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>

                                <Button ToolTip="Скопировать стоимость" Padding="0" BorderThickness="0" VerticalAlignment="Top" Width="12" Height="12" Margin="-12,0,0,0" Background="Transparent" Click="Copy_Result">
                                    <Image Source="Images/copy.png"/>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="Металл — " FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MaterialTotal" Foreground="Blue"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,3" Opacity="0.7">
                                    <TextBlock Text="ПКИ: "/>
                                    <TextBlock x:Name="BasketTotal" Foreground="Blue"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="Работы — " FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ServicesTotal" Foreground="Blue"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,3" Opacity="0.7">
                                    <TextBlock Text="Сварка СБ: "/>
                                    <TextBlock x:Name="WeldTotal" Foreground="Blue"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,3" Opacity="0.7">
                                    <TextBlock Text="Окраска СБ: "/>
                                    <TextBlock x:Name="PaintTotal" Foreground="Blue"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </GroupBox.Header>

                <hc:ScrollViewer x:Name="DetailsScroll" IsInertiaEnabled="True">
                    <StackPanel>
                        <StackPanel x:Name="DetailsStack" Margin="5"/>
                        <hc:GotoTop Target="{Binding ElementName=DetailsScroll}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" AnimationTime="500" ToolTip="Наверх"/>
                    </StackPanel>
                </hc:ScrollViewer>
            </GroupBox>

            <Popup x:Name="Popup" Placement="Mouse" AllowsTransparency="True" PopupAnimation="Scroll" StaysOpen="False">
                <Border BorderThickness="1" CornerRadius="1" BorderBrush="Red">
                    <StackPanel Background="Snow">
                        <TextBlock x:Name="Details" TextAlignment="Center" Padding="5"/>
                    </StackPanel>
                </Border>
            </Popup>

            <GridSplitter Grid.Column="1" ShowsPreview="False" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" BorderThickness="1"/>

            <GroupBox Grid.Column="2" Style="{StaticResource GroupBoxOriginal}" Margin="5">

                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="КП №" VerticalAlignment="Center" FontWeight="Bold" Width="40"/>
                        <TextBox x:Name="Order" MaxLines="1" ToolTip="Введите номер предложения"
                     Width="60" Margin="6,0,0,0" HorizontalContentAlignment="Center"
                     LostFocus="Order_LostFocus"/>

                        <Grid Margin="10,0,0,0">
                            <!-- Тоггл пометки с подсветкой -->
                            <ToggleButton x:Name="NoteToggle" ToolTip="Пометка к КП"
                  Style="{StaticResource NoteToggleStyle}">
                                <TextBlock Text="📝"/>
                            </ToggleButton>

                            <!-- Точка-индикатор: видна только при непустой пометке -->
                            <Ellipse Width="8" Height="8" Fill="#4A90E2" Stroke="White" StrokeThickness="1.5"
             VerticalAlignment="Top" Margin="0,-2,-2,0"
             IsHitTestVisible="False">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=OfferNote, FallbackValue=0}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
