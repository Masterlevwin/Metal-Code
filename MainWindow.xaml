<Window x:Class="Metal_Code.MainWindow" x:Name="MainWindowRoot"
        xmlns:hc="https://handyorg.github.io/handycontrol" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Metal_Code"
        xmlns:converters="clr-namespace:Metal_Code.Converters"
        mc:Ignorable="d" AutomationProperties.Name="" WindowStartupLocation="CenterScreen" Closing="Exit" WindowState="Maximized" Icon="/app_logo.jpeg" Background="{DynamicResource {x:Static SystemColors.GradientInactiveCaptionBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionTextBrushKey}}" FontFamily="Century" MinWidth="1280" MinHeight="720" Activated="MainWindow_Activated">

    <Window.Resources>
        <local:CostConverter x:Key="CostConverter"/>
        <local:IsAgentToTextConverter x:Key="IsAgentToTextConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:DateToBoolConverter x:Key="DateToBoolConverter"/>
        <local:OrderToBoolConverter x:Key="OrderToBoolConverter"/>
        <converters:GroupCompanyNamesConverter x:Key="GroupCompanyNamesConverter"/>
        <converters:ShipmentButtonTextConverter x:Key="ShipmentButtonTextConverter"/>
        
        <!-- Плавные функции для анимации -->
        <PowerEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <PowerEase x:Key="EaseIn" EasingMode="EaseIn"/>

        <Storyboard x:Key="ExpandParts">
            <DoubleAnimation Storyboard.TargetName="PartsStack"
                     Storyboard.TargetProperty="Height"
                     Duration="0:0:0.35"
                     EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <Storyboard x:Key="CollapseParts">
            <DoubleAnimation Storyboard.TargetName="PartsStack"
                     Storyboard.TargetProperty="Height"
                     To="0"
                     Duration="0:0:0.3"
                     EasingFunction="{StaticResource EaseIn}"/>
        </Storyboard>

        <!-- Цвета -->
        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFFE1"/>
        <SolidColorBrush x:Key="BorderColor" Color="#D1D9E0"/>
        <SolidColorBrush x:Key="FocusBorderColor" Color="#4A90E2"/>

        <!-- Общая толщина границы -->
        <Thickness x:Key="DefaultBorderThickness">1</Thickness>

        <!-- Стиль для TextBox -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}" />
            <Setter Property="Padding" Value="4" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}" />
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для Button -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="{StaticResource DefaultBorderThickness}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FocusBorderColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ToggleButton -->
        <Style x:Key="ExpandToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <!-- Основной текст из Content -->
                                <ContentPresenter x:Name="ContentPresenter"
                                          ContentSource="Content"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>
                                <!-- Стрелка-индикатор состояния -->
                                <TextBlock x:Name="Arrow"
                                   Text="▼"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Text" Value="▲"/>
                                <!-- Опционально: подсветка при раскрытом состоянии -->
                                <Setter Property="Background" Value="#F0F8FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource FocusBorderColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для TabControl -->
        <Style x:Key="OffersTabControl" BasedOn="{StaticResource TabControlSliding}" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource TabItemInLine}"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Q"
              Modifiers="Control" 
              Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="S"
              Modifiers="Control" 
              Command="{Binding OpenCommand}"/>
        <KeyBinding Key="D"
              Modifiers="Control" 
              Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F"
              Modifiers="Control" 
              Command="{Binding LoadCommand}"/>
        <KeyBinding Key="F5"
              Command="{Binding UpdateCommand}"/>
    </Window.InputBindings>

    <DockPanel LastChildFill="True">

        <Menu x:Name="MenuMain" DockPanel.Dock="Top" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="10,0,0,0" FontFamily="Leelawadee UI" DisplayMemberPath="{Binding CurrentManager.Name, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}" VerticalAlignment="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Новый расчет" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+Q">
                    <MenuItem.Icon>
                        <Image Source="/Images/new3.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Открыть" Command="{Binding OpenCommand}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <Image Source="/Images/open4.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Сохранить" Command="{Binding SaveCommand}" InputGestureText="Ctrl+D">
                    <MenuItem.Icon>
                        <Image Source="/Images/save.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Выход" Click="Exit">
                    <MenuItem.Icon>
                        <Image Source="/Images/exit.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="Settings" Header="Базы">
                <MenuItem Header="База типовых деталей" Click="OpenSettings"/>
                <MenuItem Header="База работ" Click="OpenSettings"/>
                <MenuItem Header="База менеджеров" Click="OpenSettings"/>
                <MenuItem Header="База материалов" Click="OpenSettings"/>
            </MenuItem>
            <MenuItem Header="Инструменты">
                <MenuItem Header="Таблица гибов" Click="ShowTableOfBends">
                    <MenuItem.Icon>
                        <Image Source="/Images/bends.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Маршрут производства" Click="ShowRouteWindow">
                    <MenuItem.Icon>
                        <Image Source="/Images/route.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Спецификация" Click="CreateSpec">
                    <MenuItem.Icon>
                        <Image Source="/Images/open.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Паспорт качества" Click="CreatePassport">
                    <MenuItem.Icon>
                        <Image Source="/Images/list.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Простая комплектация" Click="CreateComplect">
                    <MenuItem.Icon>
                        <Image Source="/Images/complect2.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Конвертер DWG в DXF" Click="Convert_dwg_to_dxf">
                    <MenuItem.Icon>
                        <Image Source="/Images/convert.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Список задач" Click="CreateRegistryWindow">
                    <MenuItem.Icon>
                        <Image Source="/Images/express.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Сортировка файлов" Click="SortFilesByMonth">
                    <MenuItem.Icon>
                        <Image Source="/Images/screen.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Отчеты">
                <MenuItem Header="По отгруженным заказам за выбранный период" Click="Report_On_Shipped_Orders">
                    <MenuItem.Icon>
                        <Image Source="/Images/report.png"/>
                    </MenuItem.Icon>
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemBaseStyle}">
                            <Style.Triggers>
                                <!-- Скрываем для инженеров -->
                                <DataTrigger Binding="{Binding CurrentManager.IsEngineer,
                                    RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="О программе">
                <MenuItem Header="Руководство" Click="OpenExample">
                    <MenuItem.Icon>
                        <Image Source="/Images/lamp.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="История обновлений" Click="OnUpdatesMenuItemClick"/>
                <Separator/>
                <MenuItem Header="Обновить программу" Click="Restart"/>
            </MenuItem>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Индикатор статуса -->
                <Border x:Name="OnlineIndicator" Width="12" Height="12" CornerRadius="6"
                        Background="Gray" Margin="0,0,5,0" ToolTip="Статус подключения"/>
                <Button x:Name="Login" Content="Пользователь" ToolTip="Сменить пользователя" Click="ShowLoginWindow"/>
            </StackPanel>
        </Menu>

        <StatusBar x:Name="Status" DockPanel.Dock="Bottom" Margin="10">
            <StackPanel Orientation="Horizontal">
                <ProgressBar x:Name="InsertProgressBar" MinWidth="200" Visibility="Collapsed" IsIndeterminate="True" />
                <TextBox x:Name="NotifyText" BorderThickness="0" Margin="5,0,0,0" Background="{x:Null}"/>
            </StackPanel>
        </StatusBar>

        <Grid x:Name="WindowGrid" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="600"/>
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="DetailsBox" Style="{StaticResource GroupBoxOriginal}" Margin="5">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal" Margin="5">

                        <Button Click="AddDetail" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/plus.png"/>
                                <TextBlock Text="Деталь" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Click="ShowAssemblyWindow" Margin="10,0,0,0" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/assembly.png"/>
                                <TextBlock Text="СБ" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Click="AddBasket" Margin="10,0,0,0" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/basket.png"/>
                                <TextBlock Text="ПКИ" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button ToolTip="Создать новый расчет (Ctrl+Q)" Command="{Binding NewProjectCommand}"
                                Padding="0" Margin="30,0,0,0" VerticalAlignment="Top">
                            <Image Source="Images/new3.png"/>
                        </Button>

                        <Button ToolTip="Открыть сохраненный расчет (Ctrl+S)" Command="{Binding OpenCommand}"
                                Padding="0" Margin="15,0,0,0" VerticalAlignment="Top">
                            <Image Source="Images/open4.png"/>
                        </Button>

                        <Button ToolTip="Создать папку проекта" Click="CreateProjectFolder"
                                Padding="0" Margin="70,0,0,0" VerticalAlignment="Top">
                            <Image Source="Images/save3.png"/>
                        </Button>

                        <Button ToolTip="Создать заявку за клиента" Click="CreateRequest"
                                Padding="0" Margin="15,0,0,0" VerticalAlignment="Top">
                            <Image Source="Images/comment.png"/>
                        </Button>

                        <Button ToolTip="Загрузить раскладки (Ctrl+F)" Command="{Binding LoadCommand}"
                                Padding="0" Margin="15,0,0,0" VerticalAlignment="Top">
                            <Image Source="Images/xlsx_load.png"/>
                        </Button>

                        <Expander Header="Коэффициенты" IsExpanded="False" Margin="20,0,0,0" VerticalAlignment="Top" Width="150">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Общий" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <hc:NumericUpDown Grid.Column="1"
                          Value="{Binding Ratio, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}, StringFormat='{}{0:F2}'}"
                          Minimum="0" Maximum="10" Increment="0.01" ToolTip="Введите наценку на всё КП"/>

                                <TextBlock Grid.Row="1" Text="Материал" Margin="0,8,8,0" VerticalAlignment="Center" />
                                <hc:NumericUpDown Grid.Row="1" Grid.Column="1"
                          Value="{Binding MaterialFactor, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}, StringFormat='{}{0:F2}'}"
                          Minimum="0" Maximum="10" Increment="0.01" Margin="0,8,0,0" ToolTip="Введите наценку на весь материал"/>

                                <TextBlock Grid.Row="2" Text="Услуги" Margin="0,8,8,0" VerticalAlignment="Center" />
                                <hc:NumericUpDown x:Name="ServiceFactorBox" Grid.Row="2" Grid.Column="1"
                          Value="{Binding ServiceFactor, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}, StringFormat='{}{0:F2}'}"
                          Minimum="0" Maximum="10" Increment="0.01" Margin="0,8,0,0" ToolTip="Введите наценку на все услуги"/>

                            </Grid>
                        </Expander>

                        <StackPanel Margin="10,0,0,0" Width="150" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="DetailsToggle" Content="{Binding Result, Converter={StaticResource CostConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}"
                                          Click="OnDetailsToggleClick" Width="150"
                                          Cursor="Hand" FontSize="14" MouseEnter="UpdateResult"
                                          Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"/>

                                <Button ToolTip="Скопировать стоимость" Padding="0" BorderThickness="0" VerticalAlignment="Top" Width="12" Height="12" Margin="-12,0,0,0" Background="Transparent" Click="Copy_Result">
                                    <Image Source="Images/copy.png"/>
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="Металл - "/>
                                    <TextBlock x:Name="MaterialTotal" Foreground="Blue"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="Услуги - "/>
                                    <TextBlock x:Name="ServicesTotal" Foreground="Blue"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="Сварка СБ - "/>
                                    <TextBlock x:Name="WeldTotal" Foreground="Blue"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="Окраска СБ - "/>
                                    <TextBlock x:Name="PaintTotal" Foreground="Blue"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="3">
                                    <TextBlock Text="ПКИ - "/>
                                    <TextBlock x:Name="BasketTotal" Foreground="Blue"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </GroupBox.Header>

                <hc:ScrollViewer x:Name="DetailsScroll" IsInertiaEnabled="True">
                    <StackPanel>
                        <StackPanel x:Name="DetailsStack" Margin="5"/>
                        <hc:GotoTop Target="{Binding ElementName=DetailsScroll}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" AnimationTime="500" ToolTip="Наверх"/>
                    </StackPanel>
                </hc:ScrollViewer>
            </GroupBox>

            <Popup x:Name="Popup" Placement="Mouse" AllowsTransparency="True" PopupAnimation="Scroll" StaysOpen="False">
                <Border BorderThickness="1" CornerRadius="1" BorderBrush="Red">
                    <StackPanel Background="Snow">
                        <TextBlock x:Name="Details" TextAlignment="Center" Padding="5"/>
                    </StackPanel>
                </Border>
            </Popup>

            <GridSplitter Grid.Column="1" ShowsPreview="False" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" BorderThickness="1"/>

            <GroupBox Grid.Column="2" Style="{StaticResource GroupBoxOriginal}" Margin="5">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="КП №" VerticalAlignment="Center" FontWeight="Bold" Width="40"/>
                        <TextBox x:Name="Order" MaxLines="1" ToolTip="Введите номер предложения" Width="60" Margin="5,0,0,0" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="{Binding IsAgent, Converter={StaticResource IsAgentToTextConverter}, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Blue" Width="50"/>
                        <hc:ComboBox hc:InfoElement.Placeholder="Выбор заказчика" x:Name="CustomerDrop" DisplayMemberPath="Name" IsEditable="True" SelectedIndex="0" SelectionChanged="CustomerChanged" Margin="10,0,0,0" Width="210" ToolTip="Выберите заказчика"/>
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <Button ToolTip="Добавить заказчика" Click="AddCustomer" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="5,1" Height="20">
                                <Image Source="/Images/add.png"/>
                            </Button>
                            <Button ToolTip="Изменить данные заказчика" Click="EditCustomer" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="5,1" Margin="10,0,0,0" Height="20">
                                <Image Source="/Images/edit.png"/>
                            </Button>
                            <Button ToolTip="Удалить заказчика" Click="DeleteCustomer" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="0" Padding="5,1" Margin="10,0,0,0" Height="20">
                                <Image Source="/Images/del.png"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </GroupBox.Header>

                <Grid x:Name="OrderGrid">
                    <Grid.RowDefinitions>
                        <!-- Верхняя панель с кнопками -->
                        <RowDefinition Height="Auto"/>
                        <!-- Раскрывающаяся панель PartsStack -->
                        <RowDefinition Height="Auto"/>
                        <!-- Основное содержимое: TabControl -->
                        <RowDefinition Height="*"/>
                        <!-- Занимает всё оставшееся пространство -->
                    </Grid.RowDefinitions>

                    <StackPanel Margin="15,5,5,5" Orientation="Horizontal">

                        <TextBlock Text="Срок" VerticalAlignment="Center" Width="40"/>
                        <TextBox x:Name="DateProduction" ToolTip="Введите срок изготовления" FontWeight="Bold" MaxLines="1" Margin="5,0,0,0" Width="60" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="раб/дней" Margin="10,0,0,0" VerticalAlignment="Center" Width="55"/>
                        <CheckBox Content="Экспресс" VerticalAlignment="Center" ToolTip="Добавить наценку за срочность"
                                    IsChecked="{Binding HasAssembly, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" Margin="5,0,0,0"/>
                        <ToggleButton x:Name="OfferToggle"
                                      Style="{StaticResource ExpandToggleButtonStyle}"
                                      Content="дополнительно" Width="125" Margin="10,0,0,0"
                                      ToolTip="Настройки КП — коэффициенты, доставка и прочее"
                                      Click="OnOfferToggleClick" IsChecked="True" Cursor="Hand"/>

                        <Button Command="{Binding SaveCommand}" ToolTip="Сохранить расчет (Ctrl+D)" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="Images/save.png"/>
                                <TextBlock Text="Сохранить КП" VerticalAlignment="Center" Margin="5,0,0,0" Width="85"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <StackPanel Grid.Row="1" x:Name="PartsStack" Margin="5" Height="0">
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <RadioButton GroupName="Invoice" x:Name="OOORadioButton" Content="счет с НДС" VerticalAlignment="Center" Checked="IsAgentChanged" ToolTip="К наименованию детали будет добавлено &quot;Деталь&quot;" Margin="5,0,0,0"/>
                            <RadioButton GroupName="Invoice" x:Name="IPRadioButton" Content="счет без НДС" VerticalAlignment="Center" Checked="IsAgentChanged" IsChecked="True" ToolTip="К наименованию детали будет добавлено &quot;Изготовление детали&quot;" Margin="10,0,0,0"/>
                            <Border x:Name="LimitCheckBorder" Margin="10,0,0,0" Padding="4" CornerRadius="{DynamicResource DefaultCornerRadius}">
                                <CheckBox x:Name="LimitCheck" VerticalAlignment="Center" Width="140" Click="LimitCheck_Click"/>
                            </Border>
                            <hc:SearchBar hc:InfoElement.Placeholder="Поиск детали" Style="{StaticResource SearchBarExtend}" Text="{Binding SearchDetails, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="170" SearchStarted="Search_Details"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="Конструктор" VerticalAlignment="Center" Width="75"/>
                                    <TextBox x:Name="ConstructRatio" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLines="1" ToolTip="Коэффициент" TextChanged="UpdateResult" Margin="10,0,0,0" Width="40"/>
                                    <CheckBox x:Name="CheckConstruct" Content="{Binding Construct, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" VerticalAlignment="Center" VerticalContentAlignment="Center" ToolTip="v - работа включена в цены деталей, ■ - отдельной строкой в КП" Click="UpdateResult" IsThreeState="True" IsChecked="False" Margin="10,0,0,0" HorizontalContentAlignment="Center" Width="60"/>
                                </StackPanel>
                                <StackPanel x:Name="BonusStack" Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="Бонус, %" VerticalAlignment="Center" Width="75"/>
                                    <TextBox Text="{Binding BonusRatio, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLines="1" ToolTip="Введите процент наценки" TextChanged="SetBonusRatio" Margin="10,0,0,0" Width="40"/>
                                    <TextBlock Text="{Binding Bonus, Converter={StaticResource CostConverter}, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <hc:TextBox x:Name="Comment" hc:InfoElement.Placeholder="Комментарий для клиента" ToolTip="Введите комментарий" TextWrapping="Wrap" Width="250" HorizontalContentAlignment="Center" Height="45"/>
                                    <Image Source="/Images/comment2.png" Margin="-10,-2,0,0" Width="20" VerticalAlignment="Top"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <!-- Основная кнопка выбора папок -->
                                    <Button Content="📁 Папки" Margin="0,0,5,0"
                                            Click="ShowFolderPresetsDialog"
                                            ToolTip="Выбрать папки для создания при сохранении"
                                            Style="{StaticResource ButtonPrimary.Small}"/>
                                    <!-- Кнопка настройки шаблонов -->
                                    <Button Content="⚙ Настроить"
                                            Click="OpenFolderPresetSettings"
                                            ToolTip="Добавить, переименовать или удалить шаблоны папок"
                                            Style="{StaticResource ButtonDashed.Small}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <Button Click="CreateOfferDelivery" IsEnabled="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" ToolTip="Создать расчет на доставку" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" BorderThickness="0" Margin="5,0,0,0">
                                        <Image Source="/Images/address.png" Width="20"/>
                                    </Button>
                                    <CheckBox x:Name="DeliveryCheck" Content="Доставка" IsChecked="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" ToolTip="v - отдельной строкой в КП, ■ - включена в цены деталей" VerticalAlignment="Center" Click="HasDeliveryChanged" IsThreeState="True" Margin="10,0,0,0" Width="80"/>
                                    <TextBox IsEnabled="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" Text="{Binding Delivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" x:Name="DeliveryPrice" MaxLines="1" ToolTip="Введите цену доставки" TextChanged="SetDelivery" Margin="5,0,0,0" Width="50" HorizontalContentAlignment="Center"/>
                                    <Button Click="OpenMaps" IsEnabled="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" Margin="5,0,0,0" ToolTip="Открыть карты" Padding="0" BorderThickness="0" Background="{x:Null}">
                                        <Image Source="/Images/maps.png"  Width="16"/>
                                    </Button>
                                    <TextBox IsEnabled="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" Text="{Binding DeliveryRatio, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLines="1" ToolTip="Количество доставок" TextChanged="SetDeliveryRatio" Margin="10,0,0,0" Width="30"/>
                                    <TextBlock Text="шт" VerticalAlignment="Center" Margin="5,0,0,0" Width="20"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <hc:TextBox IsEnabled="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" x:Name="Adress" hc:InfoElement.Placeholder="Адрес и контакты клиента" ToolTip="Введите адрес доставки" TextWrapping="Wrap" Margin="5,0,0,0" Width="250" Height="80" HorizontalContentAlignment="Center"/>
                                    <Button Click="CreateDelivery" IsEnabled="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" ToolTip="Создать запрос в логистику" Padding="0" BorderThickness="0" VerticalAlignment="Top" Background="{x:Null}">
                                        <Image Source="/Images/new.png" VerticalAlignment="Top" Margin="-10,-5,0,0" Width="20"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="Ваш менеджер:" VerticalAlignment="Center" Width="90" Margin="5,0,0,0"/>
                                    <ComboBox x:Name="ManagerDrop" DisplayMemberPath="Name" ToolTip="Выберите менеджера" SelectionChanged="ManagerChanged" VerticalAlignment="Center" Width="150" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <hc:TabControl Grid.Row="2" Margin="5" Style="{StaticResource OffersTabControl}"
                                   SelectionChanged="MainTabControl_SelectionChanged">
                        <hc:TabItem x:Name="OffersTab">
                            <hc:TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Расчеты" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    <hc:SearchBar hc:InfoElement.Placeholder="Поиск расчета"
                                                  Style="{StaticResource SearchBarExtend}"
                                                  Text="{Binding SearchOffers, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}"
                                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                  Margin="5,0,0,0" Width="150" SearchStarted="Search_Offers"/>
                                </StackPanel>
                            </hc:TabItem.Header>

                            <Border Style="{StaticResource BorderRegion}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="OffersGrid"
                                              Style="{StaticResource DataGrid.Small}" CanUserReorderColumns="False"
                                              CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False"
                                              LoadingRow="OffersGrid_LoadingRow" EnableColumnVirtualization="True"
                                              AutoGenerateColumns="False" RowDetailsVisibilityMode="Collapsed"
                                              BorderBrush="Red" CellEditEnding="OffersGrid_CellEditEnding"
                                              IsReadOnly="{Binding IsOffersGridReadOnly, ElementName=MainWindowRoot}">

                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="{x:Type GroupItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                    <!-- ⭐ Слегка серый фон для всей области заголовка, чтобы отделить её от белых строк -->
                                                                    <Expander x:Name="GroupExpander"
                                                                              BorderBrush="{DynamicResource BorderBrush}"
                                                                              BorderThickness="0,0,0,1">

                                                                        <Expander.Header>
                                                                            <!-- ⭐ Рамка, ограничивающая текст заголовка (стиль "плашка" или "бейдж") -->
                                                                            <Border Background="#FFFFFF"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,6,10,6"
                                            Margin="8,6,0,6"
                                            SnapsToDevicePixels="True">

                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Converter={StaticResource GroupCompanyNamesConverter}}" 
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} шт.)'}" 
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Expander.Header>

                                                                        <!-- Содержимое группы строго внутри Expander -->
                                                                        <ItemsPresenter Margin="0,2,0,0"/>
                                                                    </Expander>

                                                                    <!-- ⭐ ТРИГГЕР: для одиночных расчётов полностью убираем "обёртку" Expander -->
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding ItemCount}" Value="1">
                                                                            <Setter TargetName="GroupExpander" Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="{x:Type Expander}">
                                                                                        <ContentPresenter Content="{TemplateBinding Content}" Margin="0"/>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter TargetName="GroupExpander" Property="Background" Value="Transparent"/>
                                                                            <Setter TargetName="GroupExpander" Property="BorderThickness" Value="0"/>
                                                                            <Setter TargetName="GroupExpander" Property="Padding" Value="0"/>
                                                                            <Setter TargetName="GroupExpander" Property="Margin" Value="0"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>
                                        
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="№" Binding="{Binding N}" IsReadOnly="True" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Компания" Binding="{Binding Company}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Итого" Binding="{Binding Amount, Converter={StaticResource CostConverter}}" IsReadOnly="True" Foreground="Blue"/>
                                            <DataGridCheckBoxColumn Header="Нал" Binding="{Binding Agent}"/>
                                            <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}"/>
                                            <DataGridTextColumn Header="Заказ" Binding="{Binding Order}" Foreground="OrangeRed"/>

                                            <DataGridTemplateColumn Header="Дата отгрузки" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ToggleButton Click="OnShipmentToggleClick"
              hc:VisualElement.HighlightBrush="{DynamicResource SuccessBrush}"
              IsChecked="{Binding EndDate, Converter={StaticResource DateToBoolConverter}}"
              IsEnabled="{Binding Order, Converter={StaticResource OrderToBoolConverter}}"
              Content="{Binding EndDate, Converter={StaticResource ShipmentButtonTextConverter}}">

                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonDefault.Small}">
                                                                        <Style.Triggers>
                                                                            <!-- ⭐ Если отгружен — зелёный фон -->
                                                                            <DataTrigger Binding="{Binding EndDate, Converter={StaticResource DateToBoolConverter}}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>

                                                                            <!-- ⭐ Если редактирование запрещено — скрываем кнопку -->
                                                                            <DataTrigger Binding="{Binding IsOffersGridReadOnly,
                                                                                RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}"
                                                                                         Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            
                                            <DataGridTemplateColumn Header="Ещё" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Click="ToggleRowDetails_Click" Padding="2" Width="20" Height="20"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Показать/скрыть подробности">
                                                            <Image Source="/Images/tot.png" Width="16" Height="16"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>

                                        <DataGrid.RowDetailsTemplate>
                                            <DataTemplate>
                                                <Border Margin="4" Padding="4"
                Background="{DynamicResource RegionBrush}"
                CornerRadius="{DynamicResource DefaultCornerRadius}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Материал -</TextBlock>
                                                        <TextBlock Margin="5,0,0,0" Text="{Binding Material, Converter={StaticResource CostConverter}}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Создан -</TextBlock>
                                                        <TextBlock Margin="5,0,0,0" Text="{Binding CreatedDate, StringFormat=d.MM.y}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Автор -</TextBlock>
                                                        <TextBlock Margin="5,0,0,0" Text="{Binding Autor}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGrid.RowDetailsTemplate>
                                       
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Загрузить" Command="{Binding OpenOfferCommand}">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/load.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Удалить" Command="{Binding RemoveOfferCommand}">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/del_offer.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Запустить в производство" Click="LaunchToWork">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/order.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Открыть для чтения" Click="OpenOffer">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/compare.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Объединить в одно КП" Command="{Binding MergeOffersCommand}">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/merge.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>

                                    <StackPanel Grid.Row="1" Margin="5" VerticalAlignment="Bottom">

                                        <!-- 🔹 СТРОКА 1: Управление + Сводка -->
                                        <Grid>
                                            <!-- Слева: Кнопка обновления + Фильтр "В производстве" -->
                                            <StackPanel Orientation="Horizontal">

                                                <!-- ⭐ КНОПКА ОБНОВЛЕНИЯ - теперь с текстом и иконкой -->
                                                <Button x:Name="UpdateBtn" Click="UpdateOffersCollection"
                                                        ToolTip="Обновить список расчетов" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="/Images/update.png" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Обновить" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <ToggleButton x:Name="InProductionFilterToggle"
                          Style="{StaticResource InputElementBaseStyle}"
                          HorizontalAlignment="Left"
                          Checked="ProductionToggle_StateChanged"
                          Unchecked="ProductionToggle_StateChanged"
                          ToolTip="Показать заказы в производстве" 
                          Content="В производстве"/>

                                                <TextBlock x:Name="SummaryInfoTextBlock" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>

                                            <!-- Справа: Сводка + Переключатель режима прогноза -->
                                            <ToggleButton x:Name="ForecastModeToggle"
                      Style="{StaticResource ToggleButtonSwitch.Small}"
                      HorizontalAlignment="Right" 
                      Click="ForecastModeToggle_Click"
                      Visibility="{Binding IsChecked, ElementName=InProductionFilterToggle, Converter={StaticResource BoolToVisibilityConverter}}"
                      ToolTip="Режим расчета: только текущие / смешанный (отгруженные + производство)">
                                                <ToggleButton.Content>
                                                    <TextBlock x:Name="ForecastModeText" Text="📦 Текущие"/>
                                                </ToggleButton.Content>
                                            </ToggleButton>
                                        </Grid>

                                        <!-- 🔹 СТРОКА 2: Панель прогноза -->
                                        <StackPanel x:Name="ForecastPanel"
                Orientation="Horizontal" 
                VerticalAlignment="Center" 
                Margin="0,4,0,0" 
                Visibility="Collapsed">

                                            <TextBlock Text="Прибыль:" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ForecastPlan" Margin="3,0,0,0" Width="65" TextAlignment="Center" 
                 VerticalContentAlignment="Center" IsReadOnly="True"/>

                                            <TextBlock Text="Бонус ООО:" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ForecastBonusOoo" Margin="3,0,0,0" Width="60" TextAlignment="Center" 
                 VerticalContentAlignment="Center" IsReadOnly="True"/>

                                            <TextBlock Text="Бонус ИП и ПК:" Margin="8,0,0,0" VerticalAlignment="Center" Width="90"/>
                                            <TextBox x:Name="ForecastBonusIp" Margin="3,0,0,0" Width="60" TextAlignment="Center" 
                 VerticalContentAlignment="Center" IsReadOnly="True"/>

                                            <TextBlock Text="Итого:" Margin="8,0,0,0" VerticalAlignment="Center" Width="40"/>
                                            <TextBox x:Name="ForecastSalary" Margin="3,0,0,0" Width="65" TextAlignment="Center" 
                 VerticalContentAlignment="Center" IsReadOnly="True"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </hc:TabItem>

                        <hc:TabItem x:Name="PreviewTab" Header="Предпросмотр КП">
                            <Border Style="{StaticResource BorderRegion}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Контейнер для переключения между "пусто" и "таблица" -->
                                    <Grid x:Name="ContentContainer">
                                        <!-- Таблица (изначально скрыта) -->
                                        <DataGrid x:Name="PartsGrid" Style="{StaticResource DataGrid.Small}" 
                                        IsReadOnly="True" AutoGenerateColumns="False" 
                                        RowDetailsVisibilityMode="Collapsed" FrozenColumnCount="1"
                                        Visibility="Hidden" BorderBrush="#FF7D00FF">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Наименование" Binding="{Binding Title}" Width="200"/>
                                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}"/>
                                                <DataGridTextColumn Header="Цена за шт" Binding="{Binding Price, Converter={StaticResource CostConverter}}"/>
                                                <DataGridTextColumn Header="Стоимость" Binding="{Binding Total, Converter={StaticResource CostConverter}}"/>
                                                <DataGridCheckBoxColumn Header="Скрыта" Binding="{Binding IsHiddenInOffer}"/>
                                                <DataGridTemplateColumn Header="Ещё" CanUserResize="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button x:Name="DetailsButton" Click="ToggleRowDetails_Click"
                                                                Padding="2" Width="20" Height="20"
                                                                Background="Transparent" BorderThickness="0"
                                                                ToolTip="Показать/скрыть подробности">
                                                                <Image Source="/Images/tot.png" Width="16" Height="16"/>
                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                            <DataGrid.RowDetailsTemplate>
                                                <DataTemplate>
                                                    <Border Margin="4" Padding="4"
                                                    Background="{DynamicResource RegionBrush}"
                                                    CornerRadius="{DynamicResource DefaultCornerRadius}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Материал -</TextBlock>
                                                            <TextBlock Margin="5,0,0,0" Text="{Binding Metal}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Толщина -</TextBlock>
                                                            <TextBlock Margin="5,0,0,0" Text="{Binding Destiny}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Работы -</TextBlock>
                                                            <TextBlock Margin="5,0,0,0" Text="{Binding Description}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Размеры -</TextBlock>
                                                            <TextBlock Margin="5,0,0,0" Text="{Binding Accuracy}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGrid.RowDetailsTemplate>
                                        </DataGrid>

                                        <!-- Кнопка-заглушка: показана изначально -->
                                        <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Данные ещё не загружены" Foreground="{DynamicResource PrimaryTextBrush}"
                                            FontSize="14" Margin="0,0,0,10" TextAlignment="Center"/>
                                            <Button Content="Обновить данные КП" Click="LoadPartsData_Click"
                                            MinWidth="200" Style="{StaticResource ButtonPrimary}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Button Click="PartsView" ToolTip="Обновить цены деталей"
                                            Margin="0,0,8,0" Visibility="{Binding ElementName=PartsGrid, Path=Visibility}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Images/preview3.png" Margin="0,0,4,0"/>
                                                <TextBlock Text="Обновить КП" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                            <TextBlock Text="Общее кол-во деталей:" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TotalCount" MinWidth="60" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" BorderThickness="2" Margin="5,0,0,0" MaxWidth="60"/>
                                            <TextBlock Text="Итого:" Margin="10,0,0,0" TextAlignment="Center" VerticalAlignment="Center" MinWidth="40" MaxWidth="40"/>
                                            <TextBox x:Name="TotalPrice" MinWidth="60" Margin="5,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" BorderThickness="2" MaxWidth="60"/>
                                        </StackPanel>

                                    </Grid>
                                </Grid>
                            </Border>
                        </hc:TabItem>

                        <hc:TabItem x:Name="ReportTab">
                            <hc:TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Отчет за" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ReportDrop" Margin="5,0,0,0" SelectionChanged="ReportChanged" Width="95"/>
                                    <Button Click="CreateManagerReport" Margin="5,0,0,0" ToolTip="Сохранить отчет в папке"
                                            BorderThickness="0" Padding="1">
                                        <Image Source="/Images/report.png" Width="16"/>
                                    </Button>
                                </StackPanel>
                            </hc:TabItem.Header>

                            <Border Style="{StaticResource BorderRegion}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="ReportGrid" Style="{StaticResource DataGrid.Small}" CanUserReorderColumns="False" CanUserAddRows="False" BorderBrush="Blue" LoadingRow="ReportGrid_LoadingRow" EnableColumnVirtualization="True" CanUserResizeRows="False" AutoGenerateColumns="False" RowDetailsVisibilityMode="Collapsed" FrozenColumnCount="2" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="№" Binding="{Binding N}" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Компания" Binding="{Binding Company}"/>
                                            <DataGridTextColumn Header="Итого" Binding="{Binding Amount, Converter={StaticResource CostConverter}}" Foreground="Blue"/>
                                            <DataGridCheckBoxColumn Header="Нал" Binding="{Binding Agent}"/>
                                            <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}"/>
                                            <DataGridTextColumn Header="Заказ" Binding="{Binding Order}" Foreground="OrangeRed"/>
                                            <DataGridTextColumn Header="Дата отгрузки" Binding="{Binding EndDate, StringFormat=d.MM.y}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Bottom" Grid.Row="1">
                                        <TextBlock Text="Прибыль:" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Plan" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" BorderThickness="2" Margin="5,0,0,0" Width="50"/>
                                        <TextBlock Text="Бонус ООО:" Margin="5,0,0,0" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox x:Name="BonusOOO" Margin="5,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" Width="50"/>
                                        <TextBlock Text="Бонус ИП и ПК:" Margin="5,0,0,0" TextAlignment="Center" VerticalAlignment="Center" Width="100"/>
                                        <TextBox x:Name="BonusIP" Margin="5,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" Width="50"/>
                                        <TextBlock Text="Итого:" Margin="5,0,0,0" TextAlignment="Center" VerticalAlignment="Center" Width="40"/>
                                        <TextBox x:Name="Salary" Margin="5,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" Width="50"/>
                                        <ToggleButton IsChecked="{Binding IsReportByCreated, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}"
                                                      Margin="5,0,0,0" Style="{StaticResource ToggleButtonSwitch.Small}" ToolTip="Перестроить отчет по дате создания / по дате отрузки"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </hc:TabItem>
                    </hc:TabControl>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>