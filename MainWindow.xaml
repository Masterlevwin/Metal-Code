                                          Style="{StaticResource ToggleButtonSwitch.Small}" ToolTip="Параметры расчета и доставка"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="BonusStack" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="85,0,0,0">
                            <TextBlock Text="Бонус, %" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding BonusRatio, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}"
                 Width="45" Margin="6,0,0,0"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="SetBonusRatio"/>
                            <TextBlock Text="{Binding Bonus, Converter={StaticResource CostConverter}, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}"
                   VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Green" FontWeight="SemiBold" MinWidth="50"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Margin="12,0" Background="#F9FAFB" CornerRadius="{DynamicResource DefaultCornerRadius}" Padding="10,6,10,6"
                BorderBrush="#E5E7EB" BorderThickness="1"
                Visibility="{Binding IsChecked, ElementName=SettingsToggle, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="54"/>
                                <RowDefinition Height="8"/>
                            </Grid.RowDefinitions>

                            <Rectangle Grid.Column="1" Grid.RowSpan="6" Width="1" Fill="#E5E7EB" Margin="10,0"/>

                            <Border Grid.Column="2" Grid.ColumnSpan="3" Grid.RowSpan="6" CornerRadius="6" Margin="3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" Value="True">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                <Setter Property="BorderBrush" Value="#93C5FD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ПАРАМЕТРЫ РАСЧЕТА" FontWeight="SemiBold"
                           Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                            <Grid Grid.Row="1" Grid.Column="3" Margin="0,0,0,6">
                                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="ДОСТАВКА"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}" Value="True">
                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ToggleButton HorizontalAlignment="Right" Cursor="Hand"
                                  Style="{StaticResource ToggleButtonSwitch.Small}"
                                  IsChecked="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}"
                                  Click="HasDeliveryChanged"
                                  ToolTip="Включить доставку"/>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Конструктор" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="ConstructRatio" Width="60" Height="26"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="UpdateResult"/>
                                <CheckBox Grid.Column="3" x:Name="CheckConstruct" Width="72"
                              Content="{Binding Construct, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}, Converter={StaticResource CostConverter}}"
                              VerticalAlignment="Center" Click="UpdateResult" IsThreeState="True" IsChecked="False"
                              ToolTip="v - в ценах, ■ - отдельной строкой"/>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="3"
                      IsEnabled="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Цена" VerticalAlignment="Center" Foreground="#6B7280"/>
                                <TextBox Grid.Column="1" x:Name="DeliveryPrice" Margin="4,0,0,0" Height="26"
                             Text="{Binding Delivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="SetDelivery"/>
                                <TextBlock Grid.Column="2" Text="Кол-во" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#6B7280"/>
                                <TextBox Grid.Column="3" Margin="4,0,0,0" Height="26"
                             Text="{Binding DeliveryRatio, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="SetDeliveryRatio"/>
                                <TextBlock Grid.Column="4" Text="шт" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="#6B7280"/>
                            </Grid>

                            <Grid Grid.Row="3" Grid.Column="0" x:Name="FoldersRowGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="LimitCheckBorder" Padding="4" CornerRadius="{DynamicResource DefaultCornerRadius}">
                                    <CheckBox x:Name="LimitCheck" Content="Снять ограничения" VerticalAlignment="Center" Click="LimitCheck_Click"/>
                                </Border>
                                <Button Grid.Column="1" Content="📁" Click="ShowFolderPresetsDialog" ToolTip="Выбрать папки"
                            Style="{StaticResource ButtonDashed.Small}" Margin="8,0,0,0"
                            Width="28" Height="26" Padding="2" FontSize="13"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="2" Content="⚙" Click="OpenFolderPresetSettings" ToolTip="Настройка шаблонов папок"
                            Style="{StaticResource ButtonDashed.Small}" Margin="4,0,0,0"
                            Width="28" Height="26" Padding="2" FontSize="13"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            IsEnabled="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}">
                                <Button Click="OpenMaps" ToolTip="Карта зон доставки" Padding="6,3" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Images/maps.png" Width="14"/>
                                        <TextBlock Text="Карта" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="CreateOfferDelivery" ToolTip="Создать расчет на доставку" Padding="6,3" Margin="6,0,0,0" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Images/address.png" Width="14"/>
                                        <TextBlock Text="Расчет" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="CreateDelivery" ToolTip="Запрос в логистику" Padding="6,3" Margin="6,0,0,0" Background="Transparent" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Images/new.png" Width="14"/>
                                        <TextBlock Text="Логистика" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="4" Grid.Column="0">
                                <hc:TextBox x:Name="Comment" hc:InfoElement.Placeholder="Комментарий для клиента"
                                TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8"/>
                                <Image Source="/Images/comment2.png" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,6,8,0" Width="14" Opacity="0.4"/>
                            </Grid>
                            <Grid Grid.Row="4" Grid.Column="3"
                      IsEnabled="{Binding HasDelivery, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}">
                                <hc:TextBox x:Name="Adress" hc:InfoElement.Placeholder="Адрес и контакты"
                                TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8"/>
                                <TextBlock Text="🚚" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,6,8,0" FontSize="13" Opacity="0.5"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,6" VerticalAlignment="Center">
                        <TextBlock Text="Ответственный менеджер" VerticalAlignment="Center" Foreground="#374151" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ManagerDrop" DisplayMemberPath="Name" ToolTip="Выберите менеджера"
              SelectionChanged="ManagerChanged" Height="28" Margin="12,0,0,0"
              VerticalContentAlignment="Center" Width="150"/>

                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <RadioButton x:Name="RadioLaser" GroupName="CompanyGroup" VerticalAlignment="Center"
                     IsChecked="{Binding IsLaser, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                     Style="{StaticResource CompanyRadioStyle}">
                                <Image Source="laser_logo.jpg" Height="18" Stretch="Uniform"/>
                            </RadioButton>
                            <RadioButton x:Name="RadioApp" GroupName="CompanyGroup" Margin="8,0,0,0" VerticalAlignment="Center"
                     IsChecked="{Binding IsLaser, Converter={StaticResource InverseBoolConverter}, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=Window}}"
                     Style="{StaticResource CompanyRadioStyle}">
                                <Image Source="app_logo.jpg" Height="18" Stretch="Uniform"/>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>

                    <hc:TabControl Grid.Row="4" Margin="5" Style="{StaticResource OffersTabControl}"
                                   SelectionChanged="MainTabControl_SelectionChanged">
                        <hc:TabItem x:Name="OffersTab">
                            <hc:TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Расчеты" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    <hc:SearchBar hc:InfoElement.Placeholder="Поиск расчета"
                                                  Style="{StaticResource SearchBarExtend}"
                                                  Text="{Binding SearchOffers, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}, Mode=FindAncestor}}"
                                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                  Margin="5,0,0,0" Width="150" SearchStarted="Search_Offers"/>
                                </StackPanel>
                            </hc:TabItem.Header>

                            <Border Style="{StaticResource BorderRegion}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="OffersGrid"
                                              Style="{StaticResource DataGrid.Small}" CanUserReorderColumns="False"
                                              CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False"
                                              LoadingRow="OffersGrid_LoadingRow" EnableColumnVirtualization="True"
                                              AutoGenerateColumns="False" RowDetailsVisibilityMode="Collapsed"
                                              BorderBrush="Red" CellEditEnding="OffersGrid_CellEditEnding"
                                              IsReadOnly="{Binding IsOffersGridReadOnly, ElementName=MainWindowRoot}"
                                              ContextMenuOpening="OffersGrid_ContextMenuOpening"
                                              Sorting="OffersGrid_Sorting">

                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <EventSetter Event="MouseDoubleClick" Handler="OffersGrid_RowDoubleClick"/>
                                            </Style>
                                        </DataGrid.RowStyle>

                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle.Small}">
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#D6EAF8"/>
                                                        <Setter Property="BorderBrush" Value="#85C1E9"/>
                                                        <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="Background" Value="#AED6F1"/>
                                                        <Setter Property="BorderBrush" Value="#5DADE2"/>
                                                        <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.CellStyle>

                                        <DataGrid.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="{x:Type GroupItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                    <Expander x:Name="GroupExpander"
                                                                              BorderBrush="{DynamicResource BorderBrush}"
                                                                              BorderThickness="0,0,0,1">
                                                                        <Expander.Header>
                                                                            <Border Background="#FFFFFF"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10,6,10,6"
                                            Margin="8,6,0,6"
                                            SnapsToDevicePixels="True">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Converter={StaticResource GroupCompanyNamesConverter}}" 
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} шт.)'}" 
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Expander.Header>
                                                                        <ItemsPresenter Margin="0,2,0,0"/>
                                                                    </Expander>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding ItemCount}" Value="1">
                                                                            <Setter TargetName="GroupExpander" Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="{x:Type Expander}">
                                                                                        <ContentPresenter Content="{TemplateBinding Content}" Margin="0"/>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter TargetName="GroupExpander" Property="Background" Value="Transparent"/>
                                                                            <Setter TargetName="GroupExpander" Property="BorderThickness" Value="0"/>
                                                                            <Setter TargetName="GroupExpander" Property="Padding" Value="0"/>
                                                                            <Setter TargetName="GroupExpander" Property="Margin" Value="0"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </DataGrid.GroupStyle>

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="№" Binding="{Binding N}" SortMemberPath="ParentQuoteNumber" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="Компания" Binding="{Binding Company}" SortMemberPath="Company" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="Итого" Binding="{Binding Amount, Converter={StaticResource CostConverter}}" SortMemberPath="Amount" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="Blue"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridCheckBoxColumn Header="Нал" Binding="{Binding Agent}" SortMemberPath="Agent"/>

                                            <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}" SortMemberPath="Invoice">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="Black"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="Заказ" Binding="{Binding Order}" SortMemberPath="Order">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="OrangeRed"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Header="Дата отгрузки" SortMemberPath="EndDate" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ToggleButton Click="OnShipmentToggleClick"
                                  hc:VisualElement.HighlightBrush="{DynamicResource SuccessBrush}"
                                  IsChecked="{Binding EndDate, Converter={StaticResource DateToBoolConverter}}"
                                  IsEnabled="{Binding Order, Converter={StaticResource OrderToBoolConverter}}"
                                  Content="{Binding EndDate, Converter={StaticResource ShipmentButtonTextConverter}}">
                                                                <ToggleButton.Style>
                                                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonDefault.Small}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EndDate, Converter={StaticResource DateToBoolConverter}}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsOffersGridReadOnly, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ToggleButton.Style>
                                                            </ToggleButton>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Ещё" CanUserResize="False">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Click="ToggleRowDetails_Click" Padding="2" Width="20" Height="20"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Показать/скрыть подробности">
                                                            <Image Source="/Images/tot.png" Width="16" Height="16"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                        <DataGrid.RowDetailsTemplate>
                                            <DataTemplate>
                                                <Border Margin="4" Padding="4"
                Background="{DynamicResource RegionBrush}"
                CornerRadius="{DynamicResource DefaultCornerRadius}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Margin="10,0,0,0">
                                                            <Ellipse.Fill>
                                                                <SolidColorBrush Color="{Binding IsLocalOffer, Converter={StaticResource LocalOfferColorConverter}}"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Автор -</TextBlock>
                                                        <TextBlock Margin="5,0,0,0" Text="{Binding Autor}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Путь к КП -</TextBlock>
                                                        <TextBlock Margin="5,0,0,0" Text="{Binding Act}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGrid.RowDetailsTemplate>

                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Загрузить" Command="{Binding OpenOfferCommand}">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/load.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Удалить" Command="{Binding RemoveOfferCommand}">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/del_offer.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem x:Name="LaunchToWorkMenuItem" Header="Запустить в производство" Click="LaunchToWork">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/order.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Открыть для чтения" Click="OpenOffer">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/compare.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Объединить в одно КП" Command="{Binding MergeOffersCommand}">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/merge.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem x:Name="CompareWithCurrentMenuItem"
                                                          Header="Сравнить с текущим расчётом"
                                                          Click="CompareOfferWithCurrent"
                                                          ToolTip="Сравнивает сохранённый расчёт с текущим состоянием главного окна">
                                                    <MenuItem.Icon>
                                                        <Image Source="/Images/edit_offer.png"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>

                                    <StackPanel Grid.Row="1" Margin="5" VerticalAlignment="Bottom">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="UpdateBtn" Click="UpdateOffersCollection"
                                                        ToolTip="Обновить список расчетов" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="/Images/update.png" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Обновить" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <ToggleButton x:Name="InProductionFilterToggle"
                          Style="{StaticResource InputElementBaseStyle}"
                          HorizontalAlignment="Left"
                          Checked="ProductionToggle_StateChanged"
                          Unchecked="ProductionToggle_StateChanged"
                          ToolTip="Показать заказы в производстве" 
                          Content="В производстве"/>

                                                <TextBlock x:Name="SummaryInfoTextBlock" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </StackPanel>

                                            <ToggleButton x:Name="ForecastModeToggle"
                      Style="{StaticResource ToggleButtonSwitch.Small}"
                      HorizontalAlignment="Right" 
                      Click="ForecastModeToggle_Click"
                      Visibility="{Binding IsChecked, ElementName=InProductionFilterToggle, Converter={StaticResource BoolToVisibilityConverter}}"
                      ToolTip="Режим расчета: только текущие / смешанный (отгруженные + производство)">
                                                <ToggleButton.Content>
                                                    <TextBlock x:Name="ForecastModeText" Text="📦 Текущие"/>
                                                </ToggleButton.Content>
                                            </ToggleButton>
                                        </Grid>

                                        <StackPanel x:Name="ForecastPanel"
                Orientation="Horizontal" 
                VerticalAlignment="Center" 
                Margin="0,4,0,0" 
                Visibility="Collapsed">
                                            <TextBlock Text="Прибыль:" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ForecastPlan" Margin="3,0,0,0" Width="65" TextAlignment="Center" 
                 VerticalContentAlignment="Center" IsReadOnly="True"/>
                                            <TextBlock Text="Бонус ООО:" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="ForecastBonusOoo" Margin="3,0,0,0" Width="60" TextAlignment="Center" 
                 VerticalContentAlignment="Center" IsReadOnly="True"/>
                                            <TextBlock Text="Бонус ИП и ПК:" Margin="8,0,0,0" VerticalAlignment="Center" Width="90"/>
                                            <TextBox x:Name="ForecastBonusIp" Margin="3,0,0,0" Width="60" TextAlignment="Center" 
                 VerticalContentAlignment="Center" IsReadOnly="True"/>
                                            <TextBlock Text="Итого:" Margin="8,0,0,0" VerticalAlignment="Center" Width="40"/>
                                            <TextBox x:Name="ForecastSalary" Margin="3,0,0,0" Width="65" TextAlignment="Center" 
                 VerticalContentAlignment="Center" IsReadOnly="True"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </hc:TabItem>

                        <hc:TabItem x:Name="PreviewTab" Header="Предпросмотр КП">
                            <Border Style="{StaticResource BorderRegion}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="ContentContainer">
                                        <DataGrid x:Name="PartsGrid" Style="{StaticResource DataGrid.Small}" 
                                        IsReadOnly="True" AutoGenerateColumns="False" 
                                        RowDetailsVisibilityMode="Collapsed" FrozenColumnCount="1"
                                        Visibility="Hidden" BorderBrush="#FF7D00FF">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Наименование" Binding="{Binding Title}" Width="200"/>
                                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}"/>
                                                <DataGridTextColumn Header="Цена за шт" Binding="{Binding Price, Converter={StaticResource CostConverter}}"/>
                                                <DataGridTextColumn Header="Стоимость" Binding="{Binding Total, Converter={StaticResource CostConverter}}"/>
                                                <DataGridCheckBoxColumn Header="Скрыта" Binding="{Binding IsHiddenInOffer}"/>
                                                <DataGridTemplateColumn Header="Ещё" CanUserResize="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button x:Name="DetailsButton" Click="ToggleRowDetails_Click"
                                                                Padding="2" Width="20" Height="20"
                                                                Background="Transparent" BorderThickness="0"
                                                                ToolTip="Показать/скрыть подробности">
                                                                <Image Source="/Images/tot.png" Width="16" Height="16"/>
                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                            <DataGrid.RowDetailsTemplate>
                                                <DataTemplate>
                                                    <Border Margin="4" Padding="4"
                                                    Background="{DynamicResource RegionBrush}"
                                                    CornerRadius="{DynamicResource DefaultCornerRadius}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Материал -</TextBlock>
                                                            <TextBlock Margin="5,0,0,0" Text="{Binding Metal}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Толщина -</TextBlock>
                                                            <TextBlock Margin="5,0,0,0" Text="{Binding Destiny}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Работы -</TextBlock>
                                                            <TextBlock Margin="5,0,0,0" Text="{Binding Description}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                            <TextBlock Margin="10,0,0,0" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}">Размеры -</TextBlock>
                                                            <TextBlock Margin="5,0,0,0" Text="{Binding Accuracy}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGrid.RowDetailsTemplate>
                                        </DataGrid>

                                        <StackPanel x:Name="PlaceholderPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Данные ещё не загружены" Foreground="{DynamicResource PrimaryTextBrush}"
                                            FontSize="14" Margin="0,0,0,10" TextAlignment="Center"/>
                                            <Button Content="Обновить данные КП" Click="LoadPartsData_Click"
                                            MinWidth="200" Style="{StaticResource ButtonPrimary}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Click="PartsView" ToolTip="Обновить цены деталей"
                                            Margin="0,0,8,0" Visibility="{Binding ElementName=PartsGrid, Path=Visibility}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Images/preview3.png" Margin="0,0,4,0"/>
                                                <TextBlock Text="Обновить КП" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                            <TextBlock Text="Общее кол-во деталей:" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TotalCount" MinWidth="60" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" BorderThickness="2" Margin="5,0,0,0" MaxWidth="60"/>
                                            <TextBlock Text="Итого:" Margin="10,0,0,0" TextAlignment="Center" VerticalAlignment="Center" MinWidth="40" MaxWidth="40"/>
                                            <TextBox x:Name="TotalPrice" MinWidth="60" Margin="5,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" BorderThickness="2" MaxWidth="60"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </hc:TabItem>

                        <hc:TabItem x:Name="ReportTab">
                            <hc:TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Отчет за" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ReportDrop" Margin="5,0,0,0" SelectionChanged="ReportChanged" Width="95"/>
                                    <Button Click="CreateManagerReport" Margin="5,0,0,0" ToolTip="Сохранить отчет в папке"
                                            BorderThickness="0" Padding="1">
                                        <Image Source="/Images/report.png" Width="16"/>
                                    </Button>
                                </StackPanel>
                            </hc:TabItem.Header>

                            <Border Style="{StaticResource BorderRegion}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="ReportGrid" Style="{StaticResource DataGrid.Small}"
                                              CanUserReorderColumns="False" CanUserAddRows="False"
                                              BorderBrush="Blue" LoadingRow="ReportGrid_LoadingRow"
                                              EnableColumnVirtualization="True" CanUserResizeRows="False"
                                              AutoGenerateColumns="False" RowDetailsVisibilityMode="Collapsed"
                                              FrozenColumnCount="2" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="№" Binding="{Binding N}" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Компания" Binding="{Binding Company}"/>
                                            <DataGridTextColumn Header="Итого" Binding="{Binding Amount, Converter={StaticResource CostConverter}}" Foreground="Blue"/>
                                            <DataGridCheckBoxColumn Header="Нал" Binding="{Binding Agent}"/>
                                            <DataGridTextColumn Header="Счёт" Binding="{Binding Invoice}"/>
                                            <DataGridTextColumn Header="Заказ" Binding="{Binding Order}" Foreground="OrangeRed"/>
                                            <DataGridTextColumn Header="Дата отгрузки" Binding="{Binding EndDate, StringFormat=d.MM.y}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Bottom" Grid.Row="1">
                                        <TextBlock Text="Прибыль:" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Plan" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" BorderThickness="2" Margin="5,0,0,0" Width="50"/>
                                        <TextBlock Text="Бонус ООО:" Margin="5,0,0,0" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox x:Name="BonusOOO" Margin="5,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" Width="50"/>
                                        <TextBlock Text="Бонус ИП и ПК:" Margin="5,0,0,0" TextAlignment="Center" VerticalAlignment="Center" Width="100"/>
                                        <TextBox x:Name="BonusIP" Margin="5,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" Width="50"/>
                                        <TextBlock Text="Итого:" Margin="5,0,0,0" TextAlignment="Center" VerticalAlignment="Center" Width="40"/>
                                        <TextBox x:Name="Salary" Margin="5,0,0,0" TextAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True" Width="50"/>
                                        <Button Content="📊" Click="SyncWithCrm_Click" Margin="10,0,0,0" ToolTip="Сравнить с отчетом CRM и выделить отсутствующие расчеты"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </hc:TabItem>
                    </hc:TabControl>
                </Grid>
            </GroupBox>

        </Grid>
    </DockPanel>
</Window>