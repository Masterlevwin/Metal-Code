<Window x:Class="Metal_Code.PriceMetalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прайс-лист металла" 
        Height="600" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <!-- Левая колонка: Агрегированные средние (55%) -->
            <ColumnDefinition Width="5.5*"/>
            <ColumnDefinition Width="8"/>
            <!-- Правая колонка: Совпадающие позиции (45%) -->
            <ColumnDefinition Width="4.5*"/>
        </Grid.ColumnDefinitions>

        <!-- 🔥 ЛЕВАЯ ТАБЛИЦА: Агрегированные средние (все категории) -->
        <GroupBox Grid.Column="0" Header="📊 Все средние цены по категориям" 
                  FontWeight="Bold" Foreground="#1565C0">
            <DataGrid x:Name="AggregatedDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#E3F2FD"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="1.5*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Марка" Binding="{Binding Grade}" Width="1*" Foreground="#1565C0"/>

                    <!-- Цена с наценкой -->
                    <DataGridTextColumn Header="Цена с наценкой" 
                                        Binding="{Binding PriceWithMarkup, StringFormat=N2}" 
                                        Width="1.3*" 
                                        TextBlock.TextAlignment="Right" 
                                        Foreground="#D32F2F" 
                                        FontWeight="Bold"
                                        FontSize="12"/>

                    <DataGridTextColumn Header="Средняя цена" Binding="{Binding AveragePricePerKg, StringFormat=N2}" Width="1*" TextBlock.TextAlignment="Right" Foreground="Gray" FontSize="11"/>
                    <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" Width="Auto" TextBlock.TextAlignment="Center"/>
                    <DataGridTextColumn Header="Мин" Binding="{Binding MinPrice, StringFormat=N2}" Width="Auto" TextBlock.TextAlignment="Right" Foreground="Gray" FontSize="10"/>
                    <DataGridTextColumn Header="Макс" Binding="{Binding MaxPrice, StringFormat=N2}" Width="Auto" TextBlock.TextAlignment="Right" Foreground="Gray" FontSize="10"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Вертикальный разделитель -->
        <GridSplitter Grid.Column="1" 
                      Width="5" 
                      VerticalAlignment="Stretch" 
                      Background="#BBDEFB"
                      ShowsPreview="True"/>

        <!-- 🔥 ПРАВАЯ ТАБЛИЦА: Совпадающие с БД позиции -->
        <GroupBox Grid.Column="2" Header="✅ Найдено в базе металлов" 
                  FontWeight="Bold" Foreground="#2E7D32" Background="#E8F5E9">
            <DataGrid x:Name="MatchedDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#C8E6C9"
                      RowHeight="32"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="1.5*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Марка" Binding="{Binding Grade}" Width="1*" Foreground="#1565C0"/>

                    <!-- Цена с наценкой -->
                    <DataGridTextColumn Header="Цена с наценкой" 
                                        Binding="{Binding PriceWithMarkup, StringFormat=N2}" 
                                        Width="1.3*" 
                                        TextBlock.TextAlignment="Right" 
                                        Foreground="#D32F2F" 
                                        FontWeight="Bold"
                                        FontSize="12"/>

                    <DataGridTextColumn Header="Средняя цена" Binding="{Binding AveragePricePerKg, StringFormat=N2}" Width="1*" TextBlock.TextAlignment="Right" Foreground="Gray" FontSize="11"/>
                    <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" Width="Auto" TextBlock.TextAlignment="Center"/>
                    <DataGridTextColumn Header="Мин" Binding="{Binding MinPrice, StringFormat=N2}" Width="Auto" TextBlock.TextAlignment="Right" Foreground="Gray" FontSize="10"/>
                    <DataGridTextColumn Header="Макс" Binding="{Binding MaxPrice, StringFormat=N2}" Width="Auto" TextBlock.TextAlignment="Right" Foreground="Gray" FontSize="10"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>