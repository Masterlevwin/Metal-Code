<Window x:Class="Metal_Code.PriceMetalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Прайс-лист металла"
        WindowStartupLocation="CenterScreen" SizeToContent="Width">

    <!-- Отступы окна -->
    <Grid Margin="20">

        <!-- 🔥 TABCONTROL: Стандартный WPF для гарантированного отображения заголовков -->
        <hc:TabControl Style="{StaticResource TabControlCapsule}" 
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource RegionBrush}" HorizontalAlignment="Center">

            <!-- ВКЛАДКА 1: Итоговая таблица (Основная) -->
            <hc:TabItem Header="✅ Найдено в базе металлов" FontSize="14" FontWeight="SemiBold">
                <DataGrid x:Name="MatchedDataGrid" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" FrozenColumnCount="3"
                          EnableRowVirtualization="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Марка" Binding="{Binding Grade}" Foreground="Blue"/>
                        <DataGridTextColumn Header="Цена с наценкой" Binding="{Binding PriceWithMarkup, StringFormat=N2}" 
                                            TextBlock.TextAlignment="Right" Foreground="#D32F2F" FontWeight="Bold"/>
                        <!-- Кнопка Применить -->
                        <DataGridTemplateColumn Header="Действие" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="32" Height="32" Padding="0" Cursor="Hand"
                    Background="#4CAF50" Foreground="White"
                    ToolTip="Применить цену" ToolTipService.Placement="Left"
                    Tag="{Binding}" Click="BtnApplyPrice_Click">
                                        <Button.Content>
                                            <Path Data="M 8,16 L 3,11 L 4.4,9.6 L 8,13.2 L 19.6,1.6 L 21,3 Z" 
                          Fill="White" Stretch="Uniform" Width="14" Height="14"/>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#43A047"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#388E3C"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </hc:TabItem>

            <!-- ВКЛАДКА 2: Агрегированная таблица (Справочник) -->
            <hc:TabItem Header="📊 Все средние цены по категориям" FontSize="14" FontWeight="SemiBold">
                <DataGrid x:Name="AggregatedDataGrid"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" FrozenColumnCount="3"
                          EnableRowVirtualization="True" Style="{StaticResource DataGrid.Small}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Марка" Binding="{Binding Grade}"/>
                        <DataGridTextColumn Header="Цена с наценкой" Binding="{Binding PriceWithMarkup, StringFormat=N2}" 
                                            TextBlock.TextAlignment="Right" Foreground="#D32F2F" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Средняя цена" Binding="{Binding AveragePricePerKg, StringFormat=N2}" 
                                            TextBlock.TextAlignment="Right" Foreground="Gray"/>
                        <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" TextBlock.TextAlignment="Center"/>
                        <DataGridTextColumn Header="Мин" Binding="{Binding MinPrice, StringFormat=N2}" TextBlock.TextAlignment="Right" Foreground="Gray"/>
                        <DataGridTextColumn Header="Макс" Binding="{Binding MaxPrice, StringFormat=N2}" TextBlock.TextAlignment="Right" Foreground="Gray"/>
                    </DataGrid.Columns>
                </DataGrid>
            </hc:TabItem>

        </hc:TabControl>
    </Grid>
</Window>